---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = (() => { const b = import.meta.env.BASE_URL; return b.endsWith("/") ? b : b + "/"; })();
const cover = encodeURI(`${base}club-aerial.jpeg`);
const deadline = '31 July 2026';

// One slide per topic. Each: status (where we are) + the single next move.
const topics = [
  {
    n: '01', title: 'Account Ownership', scope: 'Who owns the digital stack',
    decision: true,
    tone: 'red', status: 'Decided', stage: 'Phase 1',
    owner: 'Maurizio Taruggi', partner: 'Laura Bonamico', date: 'Phase 1',
    macro: 'Before we switch on the new tools, one choice shapes everything that follows: who owns the digital stack — the Club, or a dedicated digital entity?',
    decided: 'After review with Laura Bonamico, Phase 1 continues under Tennis Club Ambrosiano SSD, on direzione@tcambrosiano.com. TCA Operational is currently dormant — activating it now would need deep planning and would only add cost given the tight timeline.',
    paths: [
      {
        key: 'A', title: 'Register under the Club', badge: 'Chosen · Phase 1', rec: true,
        text: 'Fastest to set up. Every future change becomes a migration and digital admin sits on the Club — accepted trade-off for Phase 1, given the timeline.',
      },
      {
        key: 'B', title: 'Dedicated digital entity', badge: 'Recommended · Phase 2', rec: false,
        text: 'Clean from day one. One home for technology, marketing and accounting — built to scale, leaving the Club free to focus on members.',
      },
    ],
    note: 'Phase 2: revisit the dedicated digital entity once TCA Operational can be properly planned and activated.',
    tools: [
      { name: 'GitHub', cat: 'now', tag: 'Code & history', cost: 'Free', desc: 'The secure vault where all the software and its full history live.' },
      { name: 'Vercel', cat: 'now', tag: 'Website hosting', cost: '€19/mo', desc: 'Where the new website actually runs and goes live to the public.' },
      { name: 'Cloudflare', cat: 'now', tag: 'Domain & security', cost: '€10/mo', desc: 'Controls the web address, plus the security and speed of the site.' },
      { name: 'Fillout', cat: 'now', tag: 'Smart forms', cost: '$40/mo', desc: 'The forms members fill in — sign-ups and bookings — replacing the old ones.' },
      { name: 'Stripe Connect', cat: 'now', tag: 'Payments', desc: 'Collects membership and service payments online.' },
      { name: 'Supabase', cat: 'future', tag: 'Data backbone', cost: '€20/mo', desc: 'One organised home for member data, so the CRM, management system and dashboards all speak the same language.' },
      { name: 'Claude Team', cat: 'future', tag: 'AI on the data', cost: '$125/mo · 5 users', desc: 'Reads the data to answer questions and produce analysis and reports automatically.' },
      { name: 'Softr', cat: 'future', tag: 'Operator interfaces', cost: '$139/mo', desc: 'No-code platform to build custom operator portals for CRM management, ERP workflows, and internal dashboards.' },
      { name: 'Meta Business Manager', cat: 'future', tag: 'Advertising', desc: 'Runs Facebook and Instagram ads, with a separate ad account per club.' },
      { name: 'Accounting system', cat: 'future', tag: 'Finance', desc: 'Bookkeeping and financial reporting — the specific tool is still to be decided.' },
    ],
    prereqs: [
      {
        title: 'Main Account Control',
        desc: 'Full control of the primary email address that owns all accounts — required to activate, manage, and recover every service independently.',
      },
      {
        title: 'Prepaid Card',
        desc: 'A dedicated prepaid card to subscribe to and pay for all digital services, without routing payments through the Club\'s accounts.',
      },
    ],
    next: 'Proceed with Phase 1 under TCA SSD; plan the dedicated entity for Phase 2.',
    nextShort: 'Proceed — Phase 1 under TCA SSD',
  },
  {
    n: '02', title: 'Perfect Gym', scope: 'Member platform',
    tone: 'green', status: 'On Track', pct: 90, stage: 'Awaiting pricing confirmation',
    owner: 'Maurizio Taruggi', partner: 'Nathan Dennis · Shiv Patel · Thomas Escher', date: 'Take-over runs to 28 Feb 2027',
    where: [
      'Pricing not yet confirmed — the contract terms on the amounts are unclear; awaiting confirmation from Nathan Dennis',
      'Shiv Patel has signed the contract',
      'Take-over into the current agreement runs through 28 Feb 2027 — no pressure to close, time to renegotiate the terms properly',
      'Direct invoicing to TCA confirmed; transfer of ownership Aspria BV → new entity underway',
    ],
    next: 'Once Nathan confirms the amounts, Thomas Escher can sign',
    nextShort: 'Awaiting confirmation from Nathan',
  },
  {
    n: '03', title: 'Website', scope: 'New site + forms',
    tone: 'amber', status: 'In Progress', pct: 80, stage: 'Refining content',
    owner: 'Maurizio Taruggi', partner: 'Laura Giardini + Alice Bartoli', date: 'TBD — DNS',
    preview: 'https://maurizio-gif.github.io/WebSite-TCA/',
    where: [
      'Site ~80% built, fully bilingual (IT / EN)',
      'Business units & events mapped through 1:1 interviews',
      'Fillout chosen to replace JotForm — faster, more scalable, easier to integrate, lower cost',
      'Standard forms now built in code & Fillout live — tour booking, call & contact underway',
      'Phase 1 (now): generic forms routed by owner — membership → Sales, courses → Reception. Phase 2: real sign-up / contract forms with Stripe payments',
      'Received feedback from Alice Bartoli on content to update',
    ],
    next: 'Transfer the domain to Cloudflare — the only blocker to go live',
    nextShort: 'Domain → Cloudflare',
  },
  {
    n: '04', title: 'Domain', scope: 'tcambrosiano.com',
    tone: 'green', status: 'Complete', pct: 100, stage: 'Done',
    owner: 'Maurizio Taruggi', partner: 'Thomas Sander', date: 'Done',
    where: [
      'Nameserver change completed — domain fully on Cloudflare, full control of all DNS records and configurations',
      'Registrar transfer completed — tcambrosiano.com fully under TCA ownership',
      'Site publishing unblocked; MX cutover for email now handled as part of the Microsoft workstream',
    ],
    next: 'Closed — MX record update for email now tracked under Microsoft',
    nextShort: 'Done',
  },
  {
    n: '05', title: 'Social & Analytics', scope: 'Social, GTM, GSC, Analytics',
    tone: 'green', status: 'Access Complete', pct: 90, stage: 'Setting up new ads account',
    owner: 'Maurizio Taruggi', partner: 'Laura Giardini · Geeta', date: 'Launch end of Aug',
    where: [
      'Full access obtained on direzione@tcambrosiano.com: Instagram TCA, Instagram Trofeo Avvenire, Facebook, Google Ads, Google Analytics, Meta Business Manager',
      'A new advertising ad account needs to be created from scratch — the old one is not transferable',
      'Geeta will help configure the new ads account ahead of the launch planned for end of August',
      'Current ad spend is disproportionate — budget will be brought down once we take over',
      'Phase 2: find a partner for the ongoing management of Google Ads and Meta Ads',
    ],
    next: 'Create the new ads account; Geeta to help configure it for the end-of-August launch',
    nextShort: 'New ads account + Geeta setup',
  },
  {
    n: '06', title: 'Microsoft', scope: 'Outlook, OneDrive, SharePoint',
    tone: 'green', status: 'On Track', pct: 90, stage: 'Ready for MX cutover',
    owner: 'Maurizio Taruggi', partner: 'Thomas Sander + Alice Bartoli', date: 'TBD',
    where: [
      'Full migration completed — email, SharePoint and OneDrive all migrated',
      'Accounts rationalised down to what\'s actually needed',
      'Google Workspace already existed and is free (non-profit status) — no added cost',
      'Ready to update the MX records and switch email delivery over to Gmail',
    ],
    next: 'Update the MX records to cut email delivery over to Gmail',
    nextShort: 'Update MX records → Gmail',
  },
  {
    n: '07', title: 'Physical Devices', scope: 'PCs & Wi-Fi',
    tone: 'green', status: 'On Track', pct: 70, stage: 'Awaiting partner offers',
    owner: 'On-site partner (TBD)', partner: 'Thomas Sander + Alice Bartoli', date: 'Jun 22–26',
    where: [
      'Call held with Thomas Sander — network architecture mapped and identified',
      'Unlike the other Aspria clubs, TCA turned out to already be fairly independent on the network side — the switch-over shouldn\'t be a difficult job',
      'Plan set: unlock, factory reset, storage to Google Drive',
      'Local on-site IT company selected by Alice; Alice has already met with the local IT partner',
    ],
    next: 'Awaiting the offer from the two possible partners',
    nextShort: 'Awaiting partner offers',
  },
  {
    n: '08', title: 'Operations Audit', scope: 'Processes, costs & strategy',
    tone: 'amber', status: 'In Progress', pct: 50, stage: 'Gathering business plan numbers',
    owner: 'Maurizio Taruggi', partner: 'Brian Morris', date: 'TBD',
    preview: 'https://maurizio-gif.github.io/TCA/operations-audit/',
    where: [
      'First analysis of key resources completed via 1:1 interviews — full findings available in the Operations Audit page',
      'Gap: in-depth process mapping for Reception and Sales still to be completed',
      'Brian\'s authorisation needed to access full cost data per business unit — required to calculate the contribution margin per BU and identify optimisation levers',
      'Resource optimisation can only begin once the cost/revenue architecture per BU is fully understood',
      'Now acquiring the business plan numbers directly',
      'Early impression: some activities carry a structural constraint in how they were embedded in the organisation — evaluation required beyond digital and operational scope, into long-term strategy',
    ],
    next: 'Acquire the business plan numbers, then analyse them',
    nextShort: 'Acquiring business plan numbers',
  },
];
---

<BaseLayout title="TCA · Carve-Out Roadmap" description="Carve-Out Roadmap — one slide per workstream: where we are and the next move.">

  <div class="slide-dots" id="dots"></div>

  <!-- ── COVER · AT A GLANCE ── -->
  <section class="cslide cslide--cover" data-header="dark">
    <div class="cc-bg" style={`background-image: linear-gradient(105deg, rgba(20,20,22,0.92) 38%, rgba(139,26,26,0.42) 100%), url('${cover}')`}></div>
    <div class="cc-watermark">TCA</div>
    <div class="cc-inner">
      <span class="eyebrow eyebrow--light">Carve-Out Roadmap</span>
      <h1 class="cc-title">Where we are.<br /><em>The next move.</em></h1>
      <span class="cc-deadline">&#9679;&nbsp; Hard deadline — {deadline}</span>

      <div class="cc-board">
        {topics.map((t) => (
          <div class={`cc-cell cc-cell--${t.tone}${t.decision ? ' cc-cell--decision' : ''}`}>
            <div class="cc-cell-head">
              <span class="cc-cell-n">{t.n}</span>
              <span class="cc-cell-title">{t.title}</span>
            </div>
            {t.decision ? (
              <span class="cc-cell-flag">&#10003; Decided · Phase 1</span>
            ) : (
              <>
                <div class="cc-bar"><span class={`cc-bar-fill bar--${t.tone}`} style={`width:${t.pct}%`}></span></div>
                <div class="cc-cell-meta"><strong>{t.pct}%</strong> · {t.status}</div>
              </>
            )}
            <div class="cc-cell-next"><em>Next</em> {t.nextShort}</div>
          </div>
        ))}
      </div>

      <span class="cc-hint">Use &uarr; &darr; / click the dots to move through the workstreams</span>
    </div>
  </section>

  <!-- ── ONE SLIDE PER TOPIC ── -->
  {topics.map((t) => (t.decision ? (

    <!-- ── DECISION SLIDE ── -->
    <section class="cslide cslide--topic cslide--decision" data-header="light">
      <span class="ct-watermark">{t.n}</span>
      <div class="ct-inner ct-inner--decision">

        <div class="ct-head">
          <span class="ct-eyebrow">Carve-Out · {t.n} / 0{topics.length} · Decided</span>
          <div class="ct-titlerow">
            <h2 class="ct-title">{t.title}</h2>
            <span class="ct-scope">{t.scope}</span>
          </div>
        </div>

        <p class="dec-macro">{t.macro}</p>

        {t.decided && (
          <div class="dec-decided">
            <span class="dec-decided-label">&#10003;&nbsp; Decision · Phase 1</span>
            <p class="dec-decided-text">{t.decided}</p>
          </div>
        )}

        <div class="dec-paths">
          {t.paths.map((p) => (
            <div class={`dec-path${p.rec ? ' dec-path--rec' : ''}`}>
              <div class="dec-path-top">
                <span class="dec-path-opt">Option {p.key}</span>
                <span class={`dec-path-badge${p.rec ? ' dec-path-badge--rec' : ''}`}>{p.badge}</span>
              </div>
              <div class="dec-path-title">{p.title}</div>
              <p class="dec-path-text">{p.text}</p>
            </div>
          ))}
        </div>

        <p class="dec-note">{t.note}</p>

        <div class="dec-tools">
          <div class="dec-tools-label">What are these tools? <span>— click any to learn more</span></div>
          <div class="dec-tools-grid">
            {t.tools.map((tool) => (
              <details class="dec-tool">
                <summary>
                  <span class="dec-tool-name">{tool.name}</span>
                  <span class={`dec-tool-cat dec-tool-cat--${tool.cat}`}>{tool.cat === 'now' ? 'Now' : 'Future'}</span>
                  <span class="dec-tool-tag">{tool.tag}</span>
                  {tool.cost && <span class={`dec-tool-cost${tool.cost === 'Free' ? ' dec-tool-cost--free' : ''}`}>{tool.cost}</span>}
                  <span class="dec-tool-plus" aria-hidden="true">+</span>
                </summary>
                <p class="dec-tool-desc">{tool.desc}</p>
              </details>
            ))}
          </div>
        </div>

        {t.prereqs && (
          <div class="dec-prereqs">
            <span class="dec-prereqs-label">&#9670;&nbsp; Operational Prerequisites</span>
            <div class="dec-prereqs-grid">
              {t.prereqs.map((p: {title: string; desc: string}) => (
                <div class="dec-prereqs-box">
                  <div class="dec-prereqs-box-title">{p.title}</div>
                  <p class="dec-prereqs-box-text">{p.desc}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="ct-foot">
          <span><em>Owner</em>{t.owner}</span>
          <span><em>With</em>{t.partner}</span>
          <span><em>Target</em>{t.date}</span>
        </div>

      </div>
    </section>

  ) : (

    <section class="cslide cslide--topic" data-header="light">
      <span class="ct-watermark">{t.n}</span>
      <div class="ct-inner">

        <div class="ct-head">
          <span class="ct-eyebrow">Carve-Out · {t.n} / 0{topics.length}</span>
          <div class="ct-titlerow">
            <h2 class="ct-title">{t.title}</h2>
            <span class="ct-scope">{t.scope}</span>
          </div>
        </div>

        <div class="ct-statusrow">
          <span class={`pill pill--${t.tone}`}>{t.status}</span>
          <div class="ct-progress">
            <div class="ct-bar"><span class={`ct-bar-fill bar--${t.tone}`} style={`width:${t.pct}%`}></span></div>
            <div class="ct-progress-meta"><strong>{t.pct}%</strong> · {t.stage}</div>
          </div>
        </div>

        <div class="ct-cols">
          <div class="ct-where">
            <div class="ct-label">Where we are</div>
            <ul>
              {t.where.map((w) => <li>{w}</li>)}
            </ul>
            {t.preview && (
              <a class="ct-preview" href={t.preview} target="_blank" rel="noopener">
                View the live preview
                <span class="ct-preview-arrow">&#8599;</span>
              </a>
            )}
          </div>
          <div class="ct-next">
            <div class="ct-next-label">Next move</div>
            <p class="ct-next-text">{t.next}</p>
          </div>
        </div>

        <div class="ct-foot">
          <span><em>Owner</em>{t.owner}</span>
          <span><em>With</em>{t.partner}</span>
          <span><em>Target</em>{t.date}</span>
        </div>

      </div>
    </section>

  )))}

</BaseLayout>

<style is:global>
  html { scroll-snap-type: y mandatory; scroll-behavior: smooth; }
  body { background: var(--text); }

  .cslide {
    position: relative;
    width: 100%;
    height: 100vh;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── DOTS ── */
  .slide-dots {
    position: fixed;
    right: clamp(12px, 1.4vw, 22px);
    top: 50%;
    transform: translateY(-50%);
    display: flex; flex-direction: column; gap: 9px; z-index: 200;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; cursor: pointer; transition: background 0.25s, transform 0.25s; background: rgba(255,255,255,0.28); }
  .dot-on-light { background: rgba(0,0,0,0.18); }
  .dot.active { background: var(--red); transform: scale(1.5); }

  /* ── shared progress bar fills ── */
  .bar--green { background: #1E6B2E; }
  .bar--amber { background: #B47800; }
  .bar--grey  { background: var(--grey-mid); }

  /* ══════════════ COVER ══════════════ */
  .cslide--cover { background: var(--text); }
  .cc-bg {
    position: absolute; inset: 0;
    background-position: center; background-size: cover; background-repeat: no-repeat;
    filter: blur(1px); transform: scale(1.05);
  }
  .cc-watermark {
    position: absolute; bottom: -4vw; right: 2vw;
    font-family: var(--fd); font-size: clamp(140px, 18vw, 280px);
    font-weight: 800; color: rgba(255,255,255,0.04);
    line-height: 1; user-select: none; pointer-events: none;
  }
  .cc-inner {
    position: relative; z-index: 2; flex: 1;
    display: flex; flex-direction: column;
    padding: calc(var(--header-h) + 4vh) clamp(24px, 5vw, 72px) 4vh;
  }
  .cc-title {
    font-family: var(--fd);
    font-size: clamp(2.6rem, 5.5vw, 5.5rem);
    font-weight: 800; text-transform: uppercase; line-height: 0.92;
    color: #fff; letter-spacing: -0.01em; margin: 0.4vh 0 1.6vh;
  }
  .cc-title em { color: #C0282A; font-style: normal; }
  .cc-deadline {
    display: inline-flex; align-items: center;
    background: var(--red); color: #fff;
    font-family: var(--fd); font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 8px 18px; border-radius: 3px; width: fit-content;
  }
  .cc-board {
    margin-top: auto;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px;
  }
  .cc-cell {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-top: 3px solid var(--grey-mid);
    padding: 16px 16px 18px;
    display: flex; flex-direction: column; gap: 9px;
  }
  .cc-cell--green { border-top-color: #2E9E45; }
  .cc-cell--amber { border-top-color: #D89000; }
  .cc-cell--grey  { border-top-color: rgba(255,255,255,0.3); }
  .cc-cell--decision {
    border-top-color: #C0282A;
    background: rgba(192,40,42,0.14);
    border-color: rgba(192,40,42,0.4);
  }
  .cc-cell-flag {
    font-family: var(--fd); font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: #fff; background: var(--red);
    padding: 4px 10px; border-radius: 3px; width: fit-content;
  }
  .cc-cell-head { display: flex; align-items: baseline; gap: 8px; }
  .cc-cell-n { font-family: var(--fd); font-size: clamp(13px, 1vw, 16px); font-weight: 800; color: rgba(255,255,255,0.35); }
  .cc-cell-title { font-family: var(--fd); font-size: clamp(13px, 1.05vw, 18px); font-weight: 700; text-transform: uppercase; color: #fff; line-height: 1.05; }
  .cc-bar { height: 6px; border-radius: 100px; background: rgba(255,255,255,0.14); overflow: hidden; }
  .cc-bar-fill { display: block; height: 100%; border-radius: 100px; }
  .cc-cell-meta { font-family: var(--fd); font-size: clamp(11px, 0.8vw, 13px); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: rgba(255,255,255,0.7); }
  .cc-cell-meta strong { color: #fff; }
  .cc-cell-next { font-size: clamp(11px, 0.82vw, 13px); font-weight: 300; color: rgba(255,255,255,0.62); line-height: 1.4; }
  .cc-cell-next em { font-family: var(--fd); font-style: normal; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #C0282A; font-size: 0.82em; margin-right: 5px; }
  .cc-hint {
    margin-top: 2.4vh;
    font-family: var(--fd); font-size: clamp(9px, 0.7vw, 11px);
    font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(255,255,255,0.3);
  }

  /* ══════════════ TOPIC SLIDE ══════════════ */
  .cslide--topic { background: #fff; }
  .ct-watermark {
    position: absolute; top: 50%; right: -2vw; transform: translateY(-50%);
    font-family: var(--fd); font-size: clamp(220px, 34vw, 540px);
    font-weight: 800; color: var(--off-white); line-height: 0.8;
    user-select: none; pointer-events: none; z-index: 0;
  }
  .ct-inner {
    position: relative; z-index: 1; flex: 1;
    display: flex; flex-direction: column; justify-content: center;
    gap: clamp(14px, 2.6vh, 30px);
    padding: calc(var(--header-h) + 3vh) clamp(24px, 5vw, 72px) 4vh;
    max-width: 1500px; margin: 0 auto; width: 100%;
  }
  .ct-eyebrow {
    font-family: var(--fd); font-size: clamp(10px, 0.8vw, 13px);
    font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--grey-mid);
  }
  .ct-titlerow { display: flex; align-items: baseline; gap: clamp(12px, 1.6vw, 24px); flex-wrap: wrap; margin-top: 0.4vh; }
  .ct-title {
    font-family: var(--fd); font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: 800; text-transform: uppercase; line-height: 0.95; color: var(--text);
  }
  .ct-scope {
    font-family: var(--fd); font-size: clamp(11px, 1vw, 15px);
    font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red);
  }

  /* status + progress */
  .ct-statusrow { display: flex; align-items: center; gap: clamp(14px, 2vw, 28px); flex-wrap: wrap; }
  .pill {
    font-family: var(--fd); font-size: clamp(11px, 0.9vw, 14px);
    font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 7px 16px; border-radius: 100px; white-space: nowrap;
  }
  .pill--green { color: #1E6B2E; background: rgba(30,107,46,0.1); border: 1px solid rgba(30,107,46,0.35); }
  .pill--amber { color: #8B6000; background: rgba(180,120,0,0.1); border: 1px solid rgba(180,120,0,0.35); }
  .pill--grey  { color: #666;    background: rgba(0,0,0,0.05);    border: 1px solid rgba(0,0,0,0.18); }
  .ct-progress { flex: 1; min-width: 220px; display: flex; flex-direction: column; gap: 7px; }
  .ct-bar { height: 10px; border-radius: 100px; background: var(--grey-light); overflow: hidden; }
  .ct-bar-fill { display: block; height: 100%; border-radius: 100px; }
  .ct-progress-meta { font-family: var(--fd); font-size: clamp(11px, 0.85vw, 14px); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--grey-mid); }
  .ct-progress-meta strong { color: var(--text); font-size: 1.15em; }

  /* two columns */
  .ct-cols { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(16px, 2.5vw, 36px); align-items: stretch; }
  .ct-label, .ct-next-label {
    font-family: var(--fd); font-size: clamp(10px, 0.78vw, 12px);
    font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 1.2vh;
  }
  .ct-label { color: var(--grey-mid); }

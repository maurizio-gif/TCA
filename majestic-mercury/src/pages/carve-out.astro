---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarveOutTable from '../components/CarveOutTable.astro';
import PhotoBand from '../components/PhotoBand.astro';
---

<BaseLayout title="TCA · Carve-Out Roadmap" initialHeaderDark={true}>

  <main class="co-page">
    <div class="co-header">
      <span class="eyebrow eyebrow--grey">Operational Plan</span>
      <h1 class="co-title">
        Carve-Out Roadmap &mdash; <em>Cut-Off July 31st</em>
      </h1>
      <span class="deadline-badge">&#9679;&nbsp; Hard Deadline: July 31, 2026</span>
    </div>

    <PhotoBand img="club-players.jpeg" eyebrow="Step by Step" blur={3} line="One workstream at a time — fully independent by July 31st." />

    <div class="preview-links" id="preview-links">
      <div class="preview-links__label">Site &amp; Forms — Preview Links</div>
      <p class="preview-links__note">Preview links will appear here as soon as they are available. You will be able to view and test the new site and forms directly from this page before the DNS cutover.</p>
      <!-- Add preview links here as they become available -->
      <!-- <a class="preview-link" href="…" target="_blank" rel="noopener">Preview: Homepage</a> -->
    </div>

    <CarveOutTable />

    <p class="co-footer">Confidential · Tennis Club Ambrosiano · 2026</p>
  </main>

</BaseLayout>

<style>
  :global(body) { background: #fff; }

  .co-page {
    padding: calc(var(--header-h) + 3.5vh) clamp(20px, 5vw, 72px) 6vh;
    max-width: 1500px;
    margin: 0 auto;
  }

  .co-header {
    display: flex;
    flex-direction: column;
    gap: 0.8vh;
    margin-bottom: 3.5vh;
  }

  .co-title {
    font-family: var(--fd);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.0;
    color: var(--text);
  }
  .co-title em {
    color: var(--red);
    font-style: italic;
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0.01em;
  }

  .deadline-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--red);
    color: #fff;
    font-family: var(--fd);
    font-size: clamp(10px, 0.75vw, 12px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 3px;
    margin-top: 0.5vh;
    width: fit-content;
  }

  .preview-links {
    margin: 3vh 0 2.5vh;
    padding: 18px 24px;
    border: 1px solid rgba(139,26,26,0.2);
    border-left: 4px solid var(--red);
    border-radius: 4px;
    background: rgba(139,26,26,0.03);
  }
  .preview-links__label {
    font-family: var(--fd);
    font-size: clamp(9px, 0.65vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 8px;
  }
  .preview-links__note {
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.7;
    margin: 0;
  }

  .co-footer {
    margin-top: 4vh;
    border-top: 1px solid var(--grey-light);
    padding-top: 2vh;
    font-size: clamp(9px, 0.65vw, 11px);
    color: var(--grey-mid);
    font-family: var(--fd);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .co-page { padding: calc(var(--header-h) + 20px) 16px 40px; }
    .co-header :global(.eyebrow) { font-size: 13px; }
    .co-title { font-size: clamp(2rem, 9vw, 2.8rem); }
    .deadline-badge { font-size: 13px; padding: 7px 14px; }
    .co-footer { font-size: 12px; }
  }
</style>

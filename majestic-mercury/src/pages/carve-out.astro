<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.cslide'));
  const dotsBox = document.getElementById('dots')!;
  const header = document.getElementById('g-header');
  const isLight = (s: HTMLElement) => s.dataset.header === 'light';

  let current = 0;

  slides.forEach((s, i) => {
    const d = document.createElement('div');
    d.className = 'dot' + (isLight(s) ? ' dot-on-light' : '') + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => s.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    dotsBox.appendChild(d);
  });

  if (slides[0]) header?.classList.toggle('g-header--dark', isLight(slides[0]));
  const dots = () => Array.from(document.querySelectorAll('.dot'));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && e.intersectionRatio >= 0.5) {
        current = slides.indexOf(e.target as HTMLElement);
        dots().forEach((d, i) => d.classList.toggle('active', i === current));
        header?.classList.toggle('g-header--dark', isLight(e.target as HTMLElement));
      }
    });
  }, { threshold: 0.5 });
  slides.forEach(s => observer.observe(s));

  function go(dir: number) {
    const next = Math.min(slides.length - 1, Math.max(0, current + dir));
    if (next !== current) slides[next].scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.addEventListener('keydown', (e) => {
    if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(1); }
    else if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); go(-1); }
    else if (e.key === 'Home') { e.preventDefault(); slides[0].scrollIntoView({ behavior: 'smooth' }); }
    else if (e.key === 'End') { e.preventDefault(); slides[slides.length - 1].scrollIntoView({ behavior: 'smooth' }); }
  });
</script>

---
// Old Italian URL kept as a redirect to the English /quote/ page.
const base = (() => { const b = import.meta.env.BASE_URL; return b.endsWith('/') ? b : b + '/'; })();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="refresh" content={`0; url=${base}quote/`} />
  <title>TCA · Carve-Out Quote</title>
</head>
<body>
  <p>Redirecting to <a href={`${base}quote/`}>the quote page</a>&hellip;</p>
</body>
</html>

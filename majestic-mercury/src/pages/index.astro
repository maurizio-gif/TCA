<script>
  const slides        = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dotsContainer = document.getElementById('dots')!;
  const header        = document.getElementById('g-header');

  const darkSlides = new Set(['s1','s3','s7']);

  // Build dots
  slides.forEach((s, i) => {
    const d = document.createElement('div');
    const onLight = !darkSlides.has(s.id);
    d.className = 'dot' + (onLight ? ' dot-on-light' : '') + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => s.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    dotsContainer.appendChild(d);
  });

  // Set initial header state
  if (darkSlides.has(slides[0]?.id ?? '')) {
    header?.classList.add('g-header--dark');
  }

  const allDots = () => Array.from(document.querySelectorAll('.dot'));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && e.intersectionRatio >= 0.5) {
        const idx = slides.indexOf(e.target as HTMLElement);
        allDots().forEach((d, i) => d.classList.toggle('active', i === idx));
        const isDark = darkSlides.has((e.target as HTMLElement).id);
        header?.classList.toggle('g-header--dark', isDark);
      }
    });
  }, { threshold: 0.5 });

  slides.forEach(s => observer.observe(s));
</script>

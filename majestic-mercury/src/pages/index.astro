---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoBand from '../components/PhotoBand.astro';

const base = (() => { const b = import.meta.env.BASE_URL; return b.endsWith("/") ? b : b + "/"; })();
const heroImg = encodeURI(`${base}orizzntale tca.avif`);

const objectives = [
  ['01','Seamless Separation','Carve out every system shared with Aspria — member platform, website, CRM, Microsoft tenant, devices — with zero downtime and zero impact on members.'],
  ['02','Independent Infrastructure','Stand up TCA’s own digital stack, built in parallel and switched on only when 100% ready: surgical, invisible, fully owned by the club.'],
  ['03','Compliance & Continuity','Fiscal, accounting, membership and data obligations covered from day one — including the migration of the accounting software by the December deadline.'],
  ['04','Full Visibility','Every workstream tracked and every decision documented on this site, so the whole team always knows where the project stands.'],
];

const team = [
  ['Brian Morris','Owner'],
  ['Thomas Escher','President'],
  ['Alice Bartoli','Manager'],
  ['Laura Bonamico','Controller · Finance'],
  ['Maurizio Taruggi','Project Lead · Digital'],
];

const method = [
  ['Always Up to Date','The progress of every workstream is tracked here as the work advances — starting with the Carve-Out Roadmap, where each scope shows its owner, status, next step and dates.'],
  ['Everything Published Here','All content — analyses, deep-dives, technical documents — is shared directly on this site and added to the menu the moment it is ready. If it matters to the project, it has a page here.'],
  ['Shared Reasoning, Not Just Conclusions','Each analysis includes the sources, the comparisons and the rationale behind the recommendation, so every decision can be reviewed and challenged at any time by anyone on the team.'],
  ['Meeting Minutes On Record','The minutes of every project meeting are archived here as well — decisions, action items and owners — so nothing depends on memory or buried email threads.'],
  ['One Single Source of Truth','One place for all the files, all the shared thinking and the full history of the project. New members of the team can get up to speed by reading this site from top to bottom.'],
];
---

<BaseLayout title="TCA · Independence Project Hub" description="Tennis Club Ambrosiano — Independence Project Hub. Purpose, objectives, team, working methodology and all shared documents in one place." initialHeaderDark={true}>

  <!-- ── HERO ── -->
  <header class="hub-hero" style={`background: linear-gradient(105deg, rgba(26,26,26,0.90) 35%, rgba(139,26,26,0.45) 100%), url('${heroImg}') center/cover no-repeat;`}>
    <div class="hub-hero__inner">
      <span class="eyebrow eyebrow--light">Tennis Club Ambrosiano · Project Hub</span>
      <h1 class="hub-hero__title">One Project.<br /><em>One Place.</em></h1>
      <p class="hub-hero__sub">
        The single shared workspace for TCA's independence project: every analysis, every decision,
        every meeting — published here, always up to date, always one click away.
      </p>
    </div>
  </header>

  <main class="hub-page">

    <!-- ── PURPOSE ── -->
    <h2 class="hub-section-title">01 · Purpose of the <em>Project</em></h2>
    <p class="hub-prose">
      Following the corporate separation from Aspria Holdings, Tennis Club Ambrosiano must become
      <strong>fully independent</strong> — in its systems, its data, its operations and its administration.
      This project manages that transition end to end: carving out every shared platform, rebuilding
      what TCA needs to own directly, and doing it <strong>silently</strong>, so that members never
      notice the change. The club's history, identity and premium positioning stay completely intact;
      the infrastructure underneath becomes its own.
    </p>

    <!-- ── OBJECTIVES ── -->
    <h2 class="hub-section-title">02 · <em>Objectives</em></h2>
    <div class="obj-grid">
      {objectives.map(([num, title, text]) => (
        <div class="obj-card">
          <div class="obj-num">{num}</div>
          <div class="obj-title">{title}</div>
          <p class="obj-text">{text}</p>
        </div>
      ))}
    </div>

    <PhotoBand img="club-aerial.jpeg" eyebrow="The Club" line="Protecting the legacy — rebuilding the engine underneath." />

    <!-- ── PEOPLE ── -->
    <h2 class="hub-section-title">03 · People Directly <em>Involved</em></h2>
    <div class="team-grid">
      {team.map(([name, role]) => (
        <div class="team-card">
          <div class="team-name">{name}</div>
          <div class="team-role">{role}</div>
        </div>
      ))}
    </div>

    <!-- ── METHODOLOGY ── -->
    <h2 class="hub-section-title">04 · How We <em>Work</em></h2>
    <p class="hub-prose">
      This site is the <strong>single home of the project</strong>: one place for all files, all shared
      reasoning and all meeting minutes. No scattered attachments, no out-of-date copies — what you see
      here is always the current state of the work.
    </p>
    <ol class="method-list">
      {method.map(([title, text]) => (
        <li>
          <div class="method-body">
            <div class="method-title">{title}</div>
            <p class="method-text">{text}</p>
          </div>
        </li>
      ))}
    </ol>

    <PhotoBand img="club-family.jpeg" eyebrow="Human Touch" blur={3} line="Members never notice the change. That's the point." />

    <!-- ── DOCUMENT INDEX ── -->
    <h2 class="hub-section-title">05 · Project <em>Contents</em></h2>
    <div class="doc-grid">
      <a href={`${base}presentation/`} class="doc-card">
        <span class="doc-tag">Presentation</span>
        <span class="doc-title">Digital Transformation Proposal</span>
        <span class="doc-text">Maurizio Taruggi's presentation: the opportunity window, the operating model and the expected outcomes for TCA.</span>
        <span class="doc-cta">Open →</span>
      </a>
      <a href={`${base}carve-out/`} class="doc-card">
        <span class="doc-tag">Operational Plan</span>
        <span class="doc-title">Carve-Out Roadmap</span>
        <span class="doc-text">The live status of every carve-out scope — Perfect Gym, website, HubSpot, Microsoft, devices — with owners, next steps and dates.</span>
        <span class="doc-cta">Open →</span>
      </a>
      <a href={`${base}accounting-analysis/`} class="doc-card">
        <span class="doc-tag">Analysis</span>
        <span class="doc-title">Cloud Accounting Software</span>
        <span class="doc-text">Comparative API analysis of cloud accounting platforms for Italy, with finalists and recommendation for the December migration.</span>
        <span class="doc-cta">Open →</span>
      </a>
      <div class="doc-card doc-card--soon">
        <span class="doc-tag">Minutes</span>
        <span class="doc-title">Meeting Minutes</span>
        <span class="doc-text">The minutes of all project meetings will be published in this section as the meetings take place.</span>
        <span class="doc-cta">Coming soon</span>
      </div>
    </div>

    <p class="hub-footer">Confidential · Tennis Club Ambrosiano · Independence Project</p>

  </main>

</BaseLayout>

<style>
  :global(body) { background: #fff; }

  /* ── HERO ── */
  .hub-hero {
    padding: calc(var(--header-h) + 8vh) clamp(20px, 5vw, 72px) 8vh;
  }
  .hub-hero__inner { max-width: 1500px; margin: 0 auto; }
  .hub-hero__title {
    font-family: var(--fd);
    font-size: clamp(2.8rem, 6.5vw, 7rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: 2vh;
  }
  .hub-hero__title em { color: #C0282A; font-style: normal; }
  .hub-hero__sub {
    font-size: clamp(14px, 1.2vw, 19px);
    font-weight: 300;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    max-width: 65ch;
  }

  /* ── MAIN ── */
  .hub-page {
    padding: 5vh clamp(20px, 5vw, 72px) 6vh;
    max-width: 1500px;
    margin: 0 auto;
  }

  .hub-section-title {
    font-family: var(--fd);
    font-size: clamp(1.5rem, 2.4vw, 2.6rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 5vh 0 1.5vh;
    color: var(--text);
  }
  .hub-section-title:first-of-type { margin-top: 0; }
  .hub-section-title em { color: var(--red); font-style: normal; }

  .hub-prose {
    font-size: clamp(14px, 1.02vw, 17px);
    font-weight: 300;
    color: #444;
    line-height: 1.7;
    max-width: 85ch;
    margin-bottom: 2vh;
  }
  .hub-prose strong { font-weight: 600; color: var(--text); }

  /* ── OBJECTIVE CARDS ── */
  .obj-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--grey-light);
    border: 1px solid var(--grey-light);
    margin: 2vh 0;
  }
  .obj-card {
    background: #fff;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background 0.2s;
  }
  .obj-card:hover { background: var(--off-white); }
  .obj-num {
    font-family: var(--fd);
    font-size: clamp(2rem, 3vw, 3.2rem);
    font-weight: 800;
    color: var(--red);
    line-height: 1;
  }
  .obj-title {
    font-family: var(--fd);
    font-size: clamp(1rem, 1.4vw, 1.4rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.2;
  }
  .obj-text {
    font-size: clamp(13px, 0.95vw, 16px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.65;
  }

  /* ── TEAM ── */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin: 2vh 0;
  }
  .team-card {
    border: 1px solid var(--grey-light);
    border-top: 3px solid var(--red);
    background: #fff;
    padding: 20px 18px;
  }
  .team-name {
    font-family: var(--fd);
    font-size: clamp(1.05rem, 1.5vw, 1.5rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .team-role {
    font-family: var(--fd);
    font-size: clamp(10px, 0.78vw, 13px);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }

  /* ── METHODOLOGY ── */
  .method-list {
    counter-reset: m;
    list-style: none;
    display: flex;
    flex-direction: column;
    margin: 2vh 0;
    border: 1px solid var(--grey-light);
  }
  .method-list li {
    counter-increment: m;
    display: flex;
    gap: 22px;
    align-items: baseline;
    padding: 20px 24px;
    border-bottom: 1px solid var(--grey-light);
    transition: background 0.15s;
  }
  .method-list li:last-child { border-bottom: none; }
  .method-list li:hover { background: var(--off-white); }
  .method-list li::before {
    content: counter(m, decimal-leading-zero);
    font-family: var(--fd);
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-weight: 800;
    color: var(--red);
    min-width: 2.2ch;
    line-height: 1;
  }
  .method-body { display: flex; flex-direction: column; gap: 4px; }
  .method-title {
    font-family: var(--fd);
    font-size: clamp(1rem, 1.35vw, 1.35rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .method-text {
    font-size: clamp(13px, 0.98vw, 16px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.65;
    max-width: 95ch;
  }

  /* ── DOCUMENT INDEX ── */
  .doc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 2vh 0;
  }
  .doc-card {
    border: 1px solid var(--grey-light);
    background: #fff;
    padding: 22px 22px;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color 0.2s, background 0.2s;
  }
  .doc-card:hover { border-color: var(--red); background: var(--off-white); }
  .doc-tag {
    font-family: var(--fd);
    font-size: clamp(10px, 0.75vw, 13px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
  }
  .doc-title {
    font-family: var(--fd);
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .doc-text {
    font-size: clamp(13px, 0.92vw, 15px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
  }
  .doc-cta {
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--fd);
    font-size: clamp(11px, 0.8vw, 14px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red);
  }
  .doc-card--soon { opacity: 0.65; }
  .doc-card--soon:hover { border-color: var(--grey-light); background: #fff; }
  .doc-card--soon .doc-cta { color: var(--grey-mid); }

  /* ── FOOTER ── */
  .hub-footer {
    margin-top: 5vh;
    border-top: 1px solid var(--grey-light);
    padding-top: 2vh;
    font-size: clamp(10px, 0.75vw, 13px);
    color: var(--grey-mid);
    font-family: var(--fd);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .hub-hero { padding: calc(var(--header-h) + 36px) 20px 44px; }
    .hub-page { padding: 28px 16px 48px; }
    .obj-grid { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: 1fr 1fr; }
    .doc-grid { grid-template-columns: 1fr; }
    .method-list li { padding: 16px 16px; gap: 14px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoBand from '../components/PhotoBand.astro';

const rows = [
  {
    finalist: true,
    sw: 'TeamSystem Contabilità in Cloud',
    swNote: 'ex Reviso',
    gl: 'Yes',
    api: 'Yes — documented REST API',
    post: 'Yes — vouchers/invoices onto a real chart of accounts',
    get: 'Yes — accounts.balance, entries by period',
    it: 'Yes',
    verdict: 'Finalist #1', vClass: 'ok', vNote: 'Confirm product roadmap with TeamSystem',
  },
  {
    finalist: true,
    sw: 'Odoo',
    swNote: 'Enterprise + l10n_it',
    gl: 'Yes',
    api: 'Yes — XML-RPC/JSON-RPC, full ORM',
    post: 'Yes — account.move journal entries, payments per journal',
    get: 'Yes — trial balance & P&L via read_group',
    it: 'Yes — native SDI proxy, withholding, Ri.Ba.',
    verdict: 'Finalist #2', vClass: 'ok', vNote: 'Custom plan required for API; partner-led implementation',
  },
  {
    sw: 'TeamSystem Enterprise',
    swNote: 'TSE in Cloud',
    gl: 'Yes',
    api: 'Yes — developer portal incl. accounting',
    post: 'Likely ("accounting movements" services)',
    get: 'To be verified',
    it: 'Yes',
    verdict: 'Fallback', vClass: 'warn', vNote: 'Over-sized mid-market ERP for a club',
  },
  {
    sw: 'Passepartout',
    swNote: 'Passcom / Mexal',
    gl: 'Yes',
    api: 'Partial — WebAPI documented, standard resources document-oriented',
    post: 'Via partner-built PassBuilder/Sprix customization',
    get: 'Via the same customization',
    it: 'Yes',
    verdict: 'Fallback', vClass: 'warn', vNote: 'Partner-dependent custom development',
  },
  {
    sw: 'Fatture in Cloud',
    swNote: 'TeamSystem',
    gl: 'No — invoicing/receipts/cash only',
    api: 'Yes — excellent (OpenAPI, SDKs, webhooks)',
    post: 'Yes, but onto categories/revenue centers, not GL accounts',
    get: 'No — lists only, no balances',
    it: 'Yes — SDI via API',
    verdict: 'Not accounting', vClass: 'no', vNote: 'Complementary invoicing layer at most',
  },
  {
    sw: 'Zucchetti',
    swNote: 'Digital Hub · Tieni il Conto',
    gl: 'Partial',
    api: 'No — docs only via sales/partner channel',
    post: 'Not publicly documented',
    get: 'No',
    it: 'Yes (DH = SDI only)',
    verdict: 'Excluded', vClass: 'no', vNote: 'API opacity',
  },
  {
    sw: 'Aruba Electronic Invoicing',
    gl: 'No — SDI channel only',
    api: 'Yes — public apidoc',
    post: 'No — XML upload to SDI only',
    get: 'No — invoice/notification search only',
    it: 'Yes (SDI only)',
    verdict: 'Excluded', vClass: 'no',
  },
  {
    sw: 'WK Genya · Dylog · Datev Koinos · B.Point',
    gl: 'Yes',
    api: 'No public API (file imports / e-invoicing only)',
    post: 'No',
    get: 'No',
    it: 'Yes',
    verdict: 'Excluded', vClass: 'no', vNote: 'Koinos/B.Point are accountant-side tools',
  },
  {
    sw: 'Sibill · Tot · Qonto · Agicap',
    gl: 'No — fintech / treasury',
    api: 'Partial (Qonto, Agicap well documented)',
    post: 'No',
    get: 'No',
    it: 'Partial',
    verdict: 'Wrong category', vClass: 'no',
  },
  {
    sw: 'Xero',
    gl: 'Yes',
    api: 'Yes — excellent Reports API (TrialBalance, P&L)',
    post: 'Yes',
    get: 'Yes',
    it: 'No SDI / Italy support',
    verdict: 'Excluded', vClass: 'no',
  },
  {
    sw: 'QuickBooks Online',
    gl: 'Yes',
    api: 'Yes — excellent Reports API',
    post: 'Yes',
    get: 'Yes',
    it: 'Only via third-party add-on (FOR S.r.l.)',
    verdict: 'Not recommended', vClass: 'no', vNote: 'Double-vendor risk; Intuit withdrew from France in 2023',
  },
  {
    sw: 'Holded',
    gl: 'Yes (Spain)',
    api: 'Partial — API key, no consolidated report endpoints',
    post: 'Partial',
    get: 'No',
    it: 'No — Spain only (Veri*factu/AEAT)',
    verdict: 'Excluded', vClass: 'no',
  },
];
---

<BaseLayout title="TCA · Cloud Accounting Software Analysis" description="Comparative analysis of cloud accounting software with public APIs for the TCA carve-out migration." initialHeaderDark={true}>

  <main class="aa-page">

    <div class="aa-header">
      <span class="eyebrow eyebrow--grey">Carve-Out · Finance Workstream</span>
      <h1 class="aa-title">
        Cloud Accounting Software &mdash; <em>API Analysis</em>
      </h1>
      <p class="aa-intro">
        The carve-out requires migrating TCA's accounting software by December. This analysis compares
        cloud accounting platforms for Italy on their <strong>public API catalogs</strong>, against two
        requirements &mdash; scoped to <strong>true general-ledger accounting</strong> (chart of accounts,
        double-entry, balances). Invoicing-only tools such as Fatture in Cloud do not qualify as the
        accounting backend.
      </p>
      <span class="deadline-badge">&#9679;&nbsp; Hard Deadline: December 2026</span>

      <div class="req-grid">
        <div class="req-card">
          <div class="req-label">Requirement 01 · Import (POST)</div>
          <p class="req-text">Push revenue data from the club's management system into the ledger, broken down by <strong>GL account</strong> and <strong>payment type/method</strong> (ideally also by revenue center).</p>
        </div>
        <div class="req-card">
          <div class="req-label">Requirement 02 · Extract (GET)</div>
          <p class="req-text">Pull consolidated data (account balances, trial balance, aggregated income/expenses) to feed <strong>dynamic external dashboards</strong>.</p>
        </div>
      </div>
    </div>

    <PhotoBand img="club-aerial.jpeg" eyebrow="One Ledger" line="Every euro — courts, bar, school — flowing into one ledger." />

    <!-- ── COMPARISON TABLE ── -->
    <h2 class="aa-section-title">01 · Comparison <em>Table</em></h2>
    <div class="table-wrap">
      <table class="aa-table">
        <thead>
          <tr>
            <th>Software</th>
            <th>True GL Accounting</th>
            <th>Public API</th>
            <th>POST Revenue<br />(account + payment)</th>
            <th>GET Balances /<br />Trial Balance</th>
            <th>Italian Compliance</th>
            <th>Verdict</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class={r.finalist ? 'row-finalist' : ''}>
              <td>{r.sw}{r.swNote && <div class="aa-note">{r.swNote}</div>}</td>
              <td>{r.gl}</td>
              <td>{r.api}</td>
              <td>{r.post}</td>
              <td>{r.get}</td>
              <td>{r.it}</td>
              <td>
                <span class={`aa-badge aa-badge--${r.vClass}`}>{r.verdict}</span>
                {r.vNote && <div class="aa-note">{r.vNote}</div>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- ── CiC vs ODOO ── -->
    <h2 class="aa-section-title">02 · CiC vs Odoo — <em>Direct Comparison</em></h2>
    <p class="comp-intro">Both finalists satisfy Requirement 01 (POST into a real GL by account and payment type) and Requirement 02 (GET balances and trial balance via API for external dashboards). The table below compares them across three dimensions: costs, technical capabilities, and implementation effort.</p>
    <p class="pricing-note">Prices indicative (June 2026) — verify exact EUR with each vendor before signing.</p>
    <div class="table-wrap">
      <table class="aa-table" style="min-width:700px">
        <thead>
          <tr>
            <th style="width:26%">Dimension</th>
            <th>TeamSystem Contabilità in Cloud</th>
            <th>Odoo Enterprise — Custom SaaS</th>
          </tr>
        </thead>
        <tbody>

          <tr class="section-row"><td colspan="3">Costs</td></tr>
          <tr>
            <td>Pricing model</td>
            <td>Per transaction volume — users unlimited at no extra cost</td>
            <td>Per user / month — all modules included</td>
          </tr>
          <tr>
            <td>Entry cost</td>
            <td>~€25–29/mese (piano base, ~6,000 entries/year)</td>
            <td>~€34–42/utente/mese (Custom plan, annual billing)</td>
          </tr>
          <tr>
            <td>Typical TCA<div class="aa-note">5 users, medium volume</div></td>
            <td class="price-good">~€45–59/mese → <strong>~€540–700/anno</strong></td>
            <td>~€190/mese → <strong>~€2,300/anno</strong> (licenze sole)</td>
          </tr>
          <tr>
            <td>Implementation (one-time)</td>
            <td class="price-good">€0–2,000 — self-setup, no partner required</td>
            <td class="price-high">€10,000–25,000 — Italian partner required</td>
          </tr>
          <tr>
            <td>Year 1 total</td>
            <td class="price-good"><strong>~€540–2,700</strong></td>
            <td class="price-high"><strong>~€12,300–27,500</strong></td>
          </tr>
          <tr>
            <td>Year 2+ annual</td>
            <td>~€540–700</td>
            <td>~€2,300 (5 users)</td>
          </tr>

          <tr class="section-row"><td colspan="3">Technical Features</td></tr>
          <tr>
            <td>True GL / double-entry</td>
            <td>Yes</td>
            <td>Yes</td>
          </tr>
          <tr>
            <td>POST by GL account + payment type<div class="aa-note">Requirement 01</div></td>
            <td>Yes — vouchers onto customizable COA; counterpart journal = payment method (cash, bank)</td>
            <td>Yes — <code>account.move</code> per GL line; <code>account.payment</code> with journal</td>
          </tr>
          <tr>
            <td>GET balances / trial balance<div class="aa-note">Requirement 02</div></td>
            <td>Yes — <code>accounts.balance</code> per account + period; REST endpoint ready for Power BI / Looker Studio</td>
            <td>Yes — <code>read_group</code> on <code>account.move.line</code>; full trial balance + P&amp;L per period</td>
          </tr>
          <tr>
            <td>API type</td>
            <td>REST — publicly documented at api-docs.reviso.com</td>
            <td>XML-RPC / JSON-RPC — full ORM access; most powerful option on the market</td>
          </tr>
          <tr>
            <td>API included in plan</td>
            <td>Yes — all plans, no extra cost</td>
            <td>Custom plan only — Standard plan (~€22–28/utente/mese) excludes API</td>
          </tr>
          <tr>
            <td>SDI / FatturaPA</td>
            <td>Yes — via TeamSystem ecosystem</td>
            <td>Yes — native <code>l10n_it_edi</code>, SDI proxy K95IV18</td>
          </tr>
          <tr>
            <td>Withholding taxes / Ri.Ba. / DDT</td>
            <td>Yes</td>
            <td>Yes</td>
          </tr>
          <tr>
            <td>Multi-company</td>
            <td>No</td>
            <td>Yes — Custom plan</td>
          </tr>
          <tr>
            <td>Multi-country</td>
            <td>No — Italy only</td>
            <td>Yes — 100+ official localizations</td>
          </tr>
          <tr>
            <td>ERP expansion<div class="aa-note">hypothetical — outside current scope</div></td>
            <td>Not possible — accounting ceiling</td>
            <td>Full suite available (HR, CRM, Inventory…) without platform change</td>
          </tr>

          <tr class="section-row"><td colspan="3">Implementation &amp; Ease of Use</td></tr>
          <tr>
            <td>Setup complexity</td>
            <td>Low — Italian product, guided onboarding</td>
            <td>Medium-High — Italian partner required for localization and configuration</td>
          </tr>
          <tr>
            <td>Time to go live</td>
            <td>Days to a few weeks</td>
            <td>Weeks to months (partner project)</td>
          </tr>
          <tr>
            <td>Learning curve</td>
            <td>Low — intuitive Italian UI, purpose-built for Italian accountants</td>
            <td>Medium — broad interface; training and a dedicated Odoo admin required</td>
          </tr>
          <tr>
            <td>Ongoing maintenance</td>
            <td>Low — fully managed SaaS, automatic updates</td>
            <td>Medium — Odoo admin role, module compatibility checks on major upgrades</td>
          </tr>
          <tr>
            <td>Free trial</td>
            <td>14 giorni</td>
            <td>Yes — odoo.com trial</td>
          </tr>
          <tr>
            <td>Support</td>
            <td>TeamSystem (Italian) — chat + email on Base; phone on Advanced plans</td>
            <td>Italian partner + Odoo community; no direct Odoo support line for hosted SaaS</td>
          </tr>

        </tbody>
      </table>
    </div>
    <div class="pricing-caveat">
      <strong>When Odoo's higher Year 1 cost makes sense:</strong> if TCA plans to manage additional entities on the same platform, expand beyond accounting, or integrate a parent group operating in multiple countries — Odoo avoids a future system migration and Year 2+ licence cost (~€2,300/anno for 5 users) is competitive once implementation is amortized. If TCA remains a single accounting entity, TeamSystem CiC is decisively more cost-effective at ~€540–700/anno with no partner dependency.
    </div>

    <!-- ── NEXT STEPS ── -->
    <h2 class="aa-section-title">03 · Next <em>Steps</em></h2>
    <ol class="steps-list">
      <li><span><strong>Open test accounts in parallel:</strong> TeamSystem CiC 14-day free trial + Odoo trial at odoo.com with Italian localization.</span></li>
      <li><span><strong>Two-week proof of concept on both:</strong> POST one real day of TCA revenue (courts, bar, membership fees) with GL accounts and payment methods; GET balances into a prototype Power BI / Looker Studio dashboard. Run on both systems simultaneously to compare API ergonomics directly.</span></li>
      <li><span><strong>Evaluate API depth on CiC:</strong> confirm the REST trial balance endpoint and period-level queries are sufficient for dashboard requirements — if they are, CiC wins on cost and simplicity. If not, Odoo's ORM-level access is the tiebreaker.</span></li>
      <li><span><strong>Obtain TeamSystem's roadmap commitment</strong> for Contabilità in Cloud (rebranded Reviso) before the December deadline.</span></li>
      <li><span><strong>If choosing Odoo:</strong> identify and engage an Italian Odoo partner immediately — December is tight for a partner-led implementation.</span></li>
    </ol>

    <!-- ── SOURCES ── -->
    <h2 class="aa-section-title">04 · Main <em>Sources</em></h2>
    <p class="sources">
      <strong>Contabilità in Cloud / Reviso:</strong>
      <a href="https://api-docs.reviso.com/" target="_blank" rel="noopener">API docs</a> ·
      <a href="https://www.reviso.com/it/assistenza/articoli/rest-api/" target="_blank" rel="noopener">REST API (IT)</a> ·
      <a href="https://www.reviso.com/it/assistenza/articoli/restful-api-esempio-crea-fattura-manuale/" target="_blank" rel="noopener">invoice creation example</a> ·
      <a href="https://www.teamsystem.com/store/contabilita-in-cloud/funzionalita/registrazioni-contabili/" target="_blank" rel="noopener">TeamSystem Store</a> ·
      <a href="https://www.teamsystem.com/store/fatturazione-e-contabilita/contabilita-in-cloud/prezzi/" target="_blank" rel="noopener">pricing</a><br />
      <strong>Odoo:</strong>
      <a href="https://www.odoo.com/documentation/18.0/applications/finance/fiscal_localizations/italy.html" target="_blank" rel="noopener">Italian localization</a> ·
      <a href="https://www.odoo.com/documentation/18.0/developer/reference/external_api.html" target="_blank" rel="noopener">External API</a> ·
      <a href="https://www.odoo.com/pricing-configurator" target="_blank" rel="noopener">pricing configurator</a> ·
      <a href="https://github.com/OCA/l10n-italy" target="_blank" rel="noopener">OCA l10n-italy</a><br />
      <strong>TeamSystem Enterprise:</strong>
      <a href="https://tse.docs.teamsystem.cloud/" target="_blank" rel="noopener">TSE developer portal</a>
      &nbsp;·&nbsp; <strong>Fatture in Cloud:</strong>
      <a href="https://developers.fattureincloud.it/" target="_blank" rel="noopener">developer portal</a> ·
      <a href="https://github.com/fattureincloud/openapi-fattureincloud" target="_blank" rel="noopener">OpenAPI spec</a><br />
      <strong>Passepartout:</strong>
      <a href="https://www.edupass.it/manuali/manualistica-passcom/manuale-prodotto?a=manuale-passweb-ecommerce%2Fconfigurazione%2Fpasscom--configurazione-gestionale%2Fweb-api-passcom" target="_blank" rel="noopener">Passcom WebAPI (EduPass)</a>
      &nbsp;·&nbsp; <strong>Zucchetti:</strong>
      <a href="https://help.zucchetti.it/cms/kb/soluzioni/fatturazione-elettronica/digital-hub/scopri-e-informati/faq/integrazioni/non-ho-gestionale-zucchetti-come-posso-integrarmi-con-digital-hub.html" target="_blank" rel="noopener">Digital Hub integration</a>
      &nbsp;·&nbsp; <strong>Aruba:</strong>
      <a href="https://fatturazioneelettronica.aruba.it/apidoc/docs.html" target="_blank" rel="noopener">apidoc</a><br />
      <strong>Xero:</strong>
      <a href="https://developer.xero.com/documentation/api/accounting/reports" target="_blank" rel="noopener">Reports API</a> ·
      <a href="https://community.xero.com/business/discussion/115295423" target="_blank" rel="noopener">no Italy support</a>
      &nbsp;·&nbsp; <strong>QuickBooks:</strong>
      <a href="https://developer.intuit.com/app/developer/qbo/docs/workflows/run-reports" target="_blank" rel="noopener">Reports API</a> ·
      <a href="https://blogs.intuit.com/2023/06/12/discontinuation-of-quickbooks-in-france/" target="_blank" rel="noopener">France discontinuation</a>
      &nbsp;·&nbsp; <strong>Holded:</strong>
      <a href="https://developers.holded.com/reference" target="_blank" rel="noopener">API reference</a>
    </p>

    <p class="aa-footer">Confidential · Tennis Club Ambrosiano · Analysis date: 13 June 2026</p>

  </main>

</BaseLayout>

<style>
  :global(body) { background: #fff; }

  .aa-page {
    padding: calc(var(--header-h) + 3.5vh) clamp(20px, 5vw, 72px) 6vh;
    max-width: 1500px;
    margin: 0 auto;
  }

  .aa-header { display: flex; flex-direction: column; gap: 0.8vh; }

  .aa-title {
    font-family: var(--fd);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.0;
    color: var(--text);
  }
  .aa-title em { color: var(--red); font-style: normal; }

  .aa-intro {
    font-size: clamp(14px, 1.05vw, 18px);
    font-weight: 300;
    color: #444;
    line-height: 1.7;
    max-width: 70ch;
    margin: 0.5vh 0;
  }
  .aa-intro strong { font-weight: 600; color: var(--text); }

  .deadline-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--red);
    color: #fff;
    font-family: var(--fd);
    font-size: clamp(10px, 0.75vw, 12px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 3px;
    margin-top: 0.5vh;
    width: fit-content;
  }

  .aa-section-title {
    font-family: var(--fd);
    font-size: clamp(1.4rem, 2.2vw, 2.4rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 5vh 0 1.5vh;
    color: var(--text);
  }
  .aa-section-title em { color: var(--red); font-style: normal; }

  /* ── REQUIREMENTS ── */
  .req-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 2.5vh 0 1vh;
  }
  .req-card {
    background: #fff;
    border: 1px solid var(--grey-light);
    border-left: 3px solid var(--red);
    padding: 18px 20px;
  }
  .req-label {
    font-family: var(--fd);
    font-size: clamp(11px, 0.8vw, 14px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 6px;
  }
  .req-text {
    font-size: clamp(13px, 0.95vw, 16px);
    font-weight: 300;
    color: #444;
    line-height: 1.65;
  }
  .req-text strong { font-weight: 600; color: var(--text); }

  /* ── TABLE ── */
  .table-wrap { overflow-x: auto; margin: 2vh 0; }

  .aa-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 880px;
  }
  .aa-table thead tr { background: var(--red); }
  .aa-table th {
    font-family: var(--fd);
    font-size: clamp(11px, 0.82vw, 15px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #fff;
    padding: 13px 16px;
    text-align: left;
  }
  .aa-table tbody tr {
    border-bottom: 1px solid var(--grey-light);
    transition: background 0.15s;
  }
  .aa-table tbody tr:hover { background: #f7f7f7; }
  .aa-table tbody tr.row-finalist { background: rgba(30,107,46,0.05); }
  .aa-table tbody tr.row-finalist:hover { background: rgba(30,107,46,0.09); }
  .aa-table td {
    font-size: clamp(12px, 0.92vw, 15px);
    font-weight: 300;
    color: #444;
    padding: 14px 16px;
    vertical-align: top;
    line-height: 1.5;
  }
  .aa-table td:first-child {
    font-family: var(--fd);
    font-size: clamp(13px, 1.05vw, 17px);
    font-weight: 700;
    color: var(--text);
  }

  .aa-badge {
    display: inline-block;
    font-size: clamp(10px, 0.75vw, 13px);
    font-weight: 600;
    font-family: var(--fd);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .aa-badge--ok   { background: rgba(30,107,46,0.08);  color: #1E6B2E; border: 1px solid rgba(30,107,46,0.3); }
  .aa-badge--no   { background: rgba(139,26,26,0.08);  color: var(--red); border: 1px solid rgba(139,26,26,0.25); }
  .aa-badge--warn { background: rgba(180,120,0,0.08);  color: #8B6000; border: 1px solid rgba(180,120,0,0.25); }

  .aa-note {
    font-size: clamp(11px, 0.8vw, 13px);
    color: var(--grey-mid);
    margin-top: 5px;
    font-style: italic;
    line-height: 1.55;
    font-weight: 300;
    white-space: normal;
  }

  /* ── COMPARISON TABLE (section 02) ── */
  .comp-intro {
    font-size: clamp(13px, 0.98vw, 17px);
    font-weight: 300;
    color: #444;
    line-height: 1.7;
    max-width: 85ch;
    margin-bottom: 0.5vh;
  }
  .section-row td {
    background: var(--text) !important;
    color: #fff !important;
    font-family: var(--fd) !important;
    font-size: clamp(10px, 0.78vw, 13px) !important;
    font-weight: 700 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    padding: 9px 16px !important;
  }
  .section-row:hover td { background: var(--text) !important; }

  /* ── PRICING ── */
  .pricing-note {
    font-size: clamp(11px, 0.82vw, 14px);
    font-weight: 400;
    color: #777;
    font-style: italic;
    margin-bottom: 1.5vh;
    max-width: 80ch;

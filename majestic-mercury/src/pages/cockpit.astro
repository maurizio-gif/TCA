<BaseLayout title="TCA · Performance Cockpit" description="Performance Cockpit — Tennis Club Ambrosiano." noindex={true} initialHeaderDark={false}>

  <div class="cp-root">

    <!-- POC NOTICE -->
    <div class="cp-poc-bar">
      Proof of Concept · Sample Data · Not for Operational Use
    </div>

    <!-- PAGE HEADER -->
    <div class="cp-page-header">
      <span class="cp-eyebrow">Performance Cockpit</span>
      <h1 class="cp-title">Operational <em>Overview</em></h1>
      <p class="cp-subtitle">MTD — June 2026 &nbsp;·&nbsp; YTD Jul 2025 – Jun 2026</p>
    </div>

    <!-- BU FILTER -->
    <div class="cp-bu-bar">
      <span class="cp-bu-label">Filter by BU</span>
      <div class="cp-chips" id="bu-chips">
        <button class="cp-chip is-active" data-bu="all">All</button>
        <button class="cp-chip" data-bu="memberships">Memberships</button>
        <button class="cp-chip" data-bu="tennis">Tennis</button>
        <button class="cp-chip" data-bu="padel">Padel</button>
        <button class="cp-chip" data-bu="summer_camps">Summer Camps</button>
        <button class="cp-chip" data-bu="merchandising">Merchandising</button>
      </div>
    </div>

    <!-- ── FINANCIAL ROW ── -->
    <div class="cp-section">
      <div class="cp-fin-row">

        <!-- Revenue -->
        <div class="cp-kpi-card cp-kpi-card--lg">
          <div class="cp-kpi-eyebrow">Total Revenue</div>
          <div class="cp-kpi-value" data-m="rev_mtd">€{D.revenue.mtd.toLocaleString('en')}</div>
          <div class="cp-kpi-subrow">
            <div class="cp-stat">
              <span class="cp-stat-k">YTD</span>
              <span class="cp-stat-v" data-m="rev_ytd">€{D.revenue.ytd.toLocaleString('en')}</span>
            </div>
            <div class="cp-stat">
              <span class="cp-stat-k">Prior Mo.</span>
              <span class="cp-stat-v" data-m="rev_prior">€{D.revenue.prior.toLocaleString('en')}</span>
            </div>
            <div class="cp-trend trend-good" data-m="rev_trend">
              +{(((D.revenue.mtd - D.revenue.prior) / D.revenue.prior) * 100).toFixed(1)}% MoM
            </div>
          </div>
        </div>

        <!-- Op. Costs -->
        <div class="cp-kpi-card">
          <div class="cp-kpi-eyebrow">Total Op. Costs</div>
          <div class="cp-kpi-value" data-m="opcost_mtd">€{D.opcost.mtd.toLocaleString('en')}</div>
          <div class="cp-kpi-subrow">
            <div class="cp-stat">
              <span class="cp-stat-k">YTD</span>
              <span class="cp-stat-v" data-m="opcost_ytd">€{D.opcost.ytd.toLocaleString('en')}</span>
            </div>
            <div class="cp-stat">
              <span class="cp-stat-k">Prior Mo.</span>
              <span class="cp-stat-v" data-m="opcost_prior">€{D.opcost.prior.toLocaleString('en')}</span>
            </div>
            <div class="cp-trend trend-bad" data-m="opcost_trend">
              +{(((D.opcost.mtd - D.opcost.prior) / D.opcost.prior) * 100).toFixed(1)}% MoM
            </div>
          </div>
          <div class="cp-kpi-note" data-m="opcost_ratio">
            {Math.round(D.opcost.mtd / D.revenue.mtd * 100)}% of revenue · EBITDA margin {Math.round((1 - D.opcost.mtd / D.revenue.mtd) * 100)}%
          </div>
        </div>

        <!-- Staff cost -->
        <div class="cp-kpi-card">
          <div class="cp-kpi-eyebrow">Staff Cost % of Revenue</div>
          <div class="cp-kpi-value" data-m="staff_mtd">{D.staff.mtd}%</div>
          <div class="cp-kpi-subrow">
            <div class="cp-stat">
              <span class="cp-stat-k">YTD Avg</span>
              <span class="cp-stat-v" data-m="staff_ytd">{D.staff.ytd}%</span>
            </div>
            <div class="cp-stat">
              <span class="cp-stat-k">Prior Mo.</span>
              <span class="cp-stat-v" data-m="staff_prior">{D.staff.prior}%</span>
            </div>
            <div class="cp-trend trend-bad" data-m="staff_trend">
              +{((D.staff.mtd - D.staff.prior)).toFixed(1)}pp MoM
            </div>
          </div>
          <div class="cp-kpi-note">Lower is better · Target &lt;40%</div>
        </div>

      </div>

      <!-- Op. costs 12-month chart -->
      <div class="cp-opcost-chart">
        <div class="cp-chart-title">Monthly Op. Costs vs. Revenue · 12-Month Trend</div>
        <svg viewBox={`0 0 ${OW} ${OH}`} class="cp-svg" preserveAspectRatio="xMidYMid meet">
          {oBars.map((b, i) => (
            <>
              <!-- Revenue bar (lighter, behind) -->
              <rect x={b.rx} y={b.ry} width={oBarW} height={b.rh}
                fill="rgba(139,26,26,0.18)" rx="2" />
              <!-- Op. cost bar -->
              <rect x={b.ox} y={b.oy} width={oBarW} height={b.oh}
                fill={b.v > b.rv ? 'rgba(220,38,38,0.75)' : 'rgba(139,26,26,0.72)'} rx="2" />
            </>
          ))}
          {MONTHS.map((m, i) => (
            <text
              x={oPL + (i / MONTHS.length) * oInner + oInner / MONTHS.length * 0.5}
              y={OH - 8}
              text-anchor="middle"
              class="cp-svg-label"
            >{m}</text>
          ))}
          <!-- last month values -->
          <text x={oBars[11].ox + oBarW / 2} y={oBars[11].oy - 4} text-anchor="middle" class="cp-svg-val">
            €{Math.round(oBars[11].v / 1000)}k
          </text>
          <text x={oBars[11].rx + oBarW / 2} y={oBars[11].ry - 4} text-anchor="middle" class="cp-svg-val cp-svg-val--light">
            €{Math.round(oBars[11].rv / 1000)}k
          </text>
        </svg>
        <div class="cp-chart-legend">
          <span class="cp-leg cp-leg--bar">Op. Costs</span>
          <span class="cp-leg cp-leg--bar cp-leg--bar-light">Revenue</span>
        </div>
      </div>

    </div>

    <!-- ── MEMBERSHIPS ROW ── -->
    <div class="cp-section" id="memberships-section">
      <div class="cp-section-label">Memberships</div>
      <div class="cp-mem-row">

        <!-- Total new -->
        <div class="cp-kpi-card cp-kpi-card--mem">
          <div class="cp-kpi-eyebrow">New Memberships</div>
          <div class="cp-kpi-value" data-m="new_mtd">{D.total_new.mtd}</div>
          <div class="cp-kpi-subrow">
            <div class="cp-stat">
              <span class="cp-stat-k">YTD</span>
              <span class="cp-stat-v" data-m="new_ytd">{D.total_new.ytd}</span>
            </div>
            <div class="cp-stat">
              <span class="cp-stat-k">Prior Mo.</span>
              <span class="cp-stat-v" data-m="new_prior">{D.total_new.prior}</span>
            </div>
            <div class="cp-trend trend-good" data-m="new_trend">
              +{(((D.total_new.mtd - D.total_new.prior) / D.total_new.prior) * 100).toFixed(1)}% MoM
            </div>
          </div>
          <div class="cp-split-row">
            <div class="cp-split-item">
              <span class="cp-split-val" data-m="online_mtd">{D.online.mtd}</span>
              <span class="cp-split-lbl">Online</span>
            </div>
            <div class="cp-split-div"></div>
            <div class="cp-split-item">
              <span class="cp-split-val" data-m="onsite_mtd">{D.onsite.mtd}</span>
              <span class="cp-split-lbl">On-site</span>
            </div>
          </div>
          <div class="cp-split-bar-wrap">
            <div class="cp-split-bar-fill" id="split-bar-online" style={`width:${Math.round(D.online.mtd/(D.online.mtd+D.onsite.mtd)*100)}%`}></div>
          </div>
          <div class="cp-split-pct-row">
            <span data-m="online_pct">{Math.round(D.online.mtd/(D.online.mtd+D.onsite.mtd)*100)}% online</span>
            <span data-m="onsite_pct">{Math.round(D.onsite.mtd/(D.online.mtd+D.onsite.mtd)*100)}% on-site</span>
          </div>
        </div>

        <!-- YTD channel split -->
        <div class="cp-kpi-card cp-kpi-card--mem">
          <div class="cp-kpi-eyebrow">Channel Split · YTD</div>
          <div class="cp-ytd-split">
            <div class="cp-ytd-item">
              <span class="cp-ytd-val" data-m="online_ytd">{D.online.ytd}</span>
              <span class="cp-ytd-lbl">Online</span>
              <span class="cp-ytd-pct" data-m="online_ytd_pct">{Math.round(D.online.ytd/(D.online.ytd+D.onsite.ytd)*100)}%</span>
            </div>
            <div class="cp-ytd-div"></div>
            <div class="cp-ytd-item">
              <span class="cp-ytd-val" data-m="onsite_ytd">{D.onsite.ytd}</span>
              <span class="cp-ytd-lbl">On-site</span>
              <span class="cp-ytd-pct" data-m="onsite_ytd_pct">{Math.round(D.onsite.ytd/(D.online.ytd+D.onsite.ytd)*100)}%</span>
            </div>
          </div>
          <div class="cp-split-bar-wrap" style="margin-top:14px">
            <div class="cp-split-bar-fill" id="split-bar-online-ytd" style={`width:${Math.round(D.online.ytd/(D.online.ytd+D.onsite.ytd)*100)}%`}></div>
          </div>
          <div class="cp-kpi-note" style="margin-top:10px">Online trend: +{(((D.online.mtd - D.online.prior) / (D.online.prior||1)) * 100).toFixed(0)}% vs prior month</div>
        </div>

      </div>
    </div>

    <!-- ── FUNNEL SECTION ── -->
    <div class="cp-section" id="funnel-section">
      <div class="cp-section-label">Member Acquisition Funnel</div>

      <!-- STAGE 1: Inquiries -->
      <div class="cp-funnel-stage">
        <div class="cp-stage-header">
          <div class="cp-stage-num">01</div>
          <div class="cp-stage-title">Inquiries</div>
        </div>
        <div class="cp-stage-body">
          <div class="cp-stage-kpi">
            <div class="cp-kpi-eyebrow">Total MTD</div>
            <div class="cp-kpi-value cp-kpi-value--stage" data-m="inq_mtd">{D.inq.mtd}</div>

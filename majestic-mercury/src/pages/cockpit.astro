---
import BaseLayout from '../layouts/BaseLayout.astro';

// ── KPI data  (replace with Supabase fetch in production)
const KPIS = [
  { id: "online_sales",   label: "Membership Vendute Online",  unit: "",  mtd: 47,   ytd: 286,  target: 60,  prior: 33,   goodWhen: "up",   hero: true  },
  { id: "staff_cost",     label: "Costo Personale / Ricavi",   unit: "%", mtd: 41.8, ytd: 44.2, target: 40,  prior: 43.1, goodWhen: "down", hero: false },
  { id: "lead_conv",      label: "Conversione Lead → Socio",   unit: "%", mtd: 27.4, ytd: 24.1, target: 30,  prior: 24.6, goodWhen: "up",   hero: false },
  { id: "digital_signup", label: "Iscrizioni via Digitale",    unit: "%", mtd: 61.0, ytd: 48.5, target: 80,  prior: 55.2, goodWhen: "up",   hero: false },
  { id: "net_growth",     label: "Crescita Soci Netta",        unit: "",  mtd: 38,   ytd: 214,  target: 45,  prior: 29,   goodWhen: "up",   hero: false },
  { id: "rev_per_member", label: "Ricavo Medio per Socio",     unit: "€", mtd: 86,   ytd: 83,   target: 90,  prior: 84,   goodWhen: "up",   hero: false },
  { id: "renewal",        label: "Tasso di Rinnovo",           unit: "%", mtd: 89.2, ytd: 87.6, target: 90,  prior: 88.4, goodWhen: "up",   hero: false },
  { id: "contracts",      label: "Nuovi Contratti Firmati",    unit: "",  mtd: 47,   ytd: 378,  target: 50,  prior: 42,   goodWhen: "up",   hero: false },
  { id: "inq_ctr_rate",   label: "Tasso Convers. Inq → Ctr",  unit: "%", mtd: 54.0, ytd: 44.4, target: 50,  prior: 51.2, goodWhen: "up",   hero: false },
];

// ── Inquiry breakdown (this month)
const INQUIRY = {
  total: 87, prior: 82, ytd: 851, target: 80,
  types: [
    { label: "Nuovi Lead",   n: 52, pct: 60 },
    { label: "Lead Ritorno", n: 21, pct: 24 },
    { label: "Ex Soci",      n: 14, pct: 16 },
  ],
};

function fmt(v: number, unit: string): string {
  if (unit === "€") return `€${v}`;
  if (unit === "%") return `${v.toFixed(1)}%`;
  return String(v);
}

function computeKpi(k: typeof KPIS[0]) {
  const raw = k.mtd - k.prior;
  const improving = k.goodWhen === "up" ? raw > 0 : raw < 0;
  const arrow = raw === 0 ? "→" : raw > 0 ? "↑" : "↓";
  const mag = Math.abs(raw);
  const deltaTxt = k.unit === "%" ? `${mag.toFixed(1)} pt` : k.unit === "€" ? `€${mag.toFixed(0)}` : String(mag);
  const meter =
    k.goodWhen === "down"
      ? Math.max(0, Math.min(1, (k.prior - k.mtd) / (k.prior - k.target || 1)))
      : Math.max(0, Math.min(1, k.mtd / k.target));
  const onTarget = k.goodWhen === "down" ? k.mtd <= k.target : k.mtd >= k.target;
  return {
    ...k,
    improving,
    arrow,
    deltaTxt,
    meter,
    onTarget,
    meterPct: `${(meter * 100).toFixed(1)}%`,
    fmtMtd: fmt(k.mtd, k.unit),
    fmtYtd: fmt(k.ytd, k.unit),
    fmtTarget: fmt(k.target, k.unit),
  };
}

const kpis    = KPIS.map(computeKpi);
const hero    = kpis.find(k => k.hero)!;
const grid1   = kpis.filter(k => !k.hero && ['staff_cost','lead_conv'].includes(k.id));
const grid2   = kpis.filter(k => ['digital_signup','net_growth','rev_per_member','renewal'].includes(k.id));
const grid3   = kpis.filter(k => ['contracts','inq_ctr_rate'].includes(k.id));

// Inquiry delta
const inqDelta   = INQUIRY.total - INQUIRY.prior;
const inqGood    = inqDelta >= 0;
const inqArrow   = inqDelta > 0 ? "↑" : inqDelta < 0 ? "↓" : "→";
const inqMeter   = Math.min(1, INQUIRY.total / INQUIRY.target);

// ── 12-month trend data
const ONLINE_TREND = [
  { m: "Lug", online:  9, club: 28 }, { m: "Ago", online:  7, club: 19 },
  { m: "Set", online: 14, club: 31 }, { m: "Ott", online: 18, club: 26 },
  { m: "Nov", online: 21, club: 25 }, { m: "Dic", online: 16, club: 22 },
  { m: "Gen", online: 28, club: 27 }, { m: "Feb", online: 31, club: 24 },
  { m: "Mar", online: 36, club: 23 }, { m: "Apr", online: 39, club: 21 },
  { m: "Mag", online: 43, club: 19 }, { m: "Giu", online: 47, club: 18 },
];

const NET_TREND = [
  { m: "Lug", v: 12 }, { m: "Ago", v:  8 }, { m: "Set", v: 22 },
  { m: "Ott", v: 19 }, { m: "Nov", v: 25 }, { m: "Dic", v: 14 },
  { m: "Gen", v: 31 }, { m: "Feb", v: 27 }, { m: "Mar", v: 33 },
  { m: "Apr", v: 24 }, { m: "Mag", v: 29 }, { m: "Giu", v: 38 },
];

// Inquiries vs new contracts — 12 months
const INQ_CTR_TREND = [
  { m: "Lug", inq: 64, ctr: 34 }, { m: "Ago", inq: 48, ctr: 27 },
  { m: "Set", inq: 72, ctr: 41 }, { m: "Ott", inq: 68, ctr: 38 },
  { m: "Nov", inq: 75, ctr: 44 }, { m: "Dic", inq: 54, ctr: 32 },
  { m: "Gen", inq: 81, ctr: 51 }, { m: "Feb", inq: 77, ctr: 47 },
  { m: "Mar", inq: 88, ctr: 54 }, { m: "Apr", inq: 82, ctr: 50 },
  { m: "Mag", inq: 82, ctr: 42 }, { m: "Giu", inq: 87, ctr: 47 },
];

// ── Area chart SVG geometry  (viewBox 540 × 200)
const AW = 540, AH = 200, AmL = 36, AmR = 10, AmT = 10, AmB = 34;
const AdW = AW - AmL - AmR;
const AdH = AH - AmT - AmB;
const aN  = ONLINE_TREND.length;
const aMax = Math.max(...ONLINE_TREND.map(d => d.online + d.club)) * 1.18;

const ax = (i: number) => AmL + (i / (aN - 1)) * AdW;
const ay = (v: number) => AH - AmB - (v / aMax) * AdH;

const aClubPoly = [
  `${ax(0).toFixed(1)},${(AH - AmB).toFixed(1)}`,
  ...ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.club).toFixed(1)}`),
  `${ax(aN - 1).toFixed(1)},${(AH - AmB).toFixed(1)}`,
].join(" ");

const aOnlinePoly = [
  ...ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.club).toFixed(1)}`),
  ...[...ONLINE_TREND].reverse().map((d, ri) => {
    const i = aN - 1 - ri;
    return `${ax(i).toFixed(1)},${ay(d.online + d.club).toFixed(1)}`;
  }),
].join(" ");

const aClubLine  = ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.club).toFixed(1)}`).join(" ");
const aTotalLine = ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.online + d.club).toFixed(1)}`).join(" ");
const aGrid      = [0, 20, 40, 60].map(v => ({ v, y: ay(v).toFixed(1), lx: AmL - 5, ly: (ay(v) + 4).toFixed(1) }));
const aXLabels   = ONLINE_TREND.map((d, i) => ({ x: ax(i).toFixed(1), y: AH - AmB + 18, label: d.m }));

// ── Bar chart SVG geometry  (viewBox 380 × 200)
const BW = 380, BH = 200, BmL = 36, BmR = 14, BmT = 10, BmB = 34;
const BdW = BW - BmL - BmR;
const BdH = BH - BmT - BmB;
const bN  = NET_TREND.length;
const bScale = 45 * 1.28;
const bSlot  = BdW / bN;
const bBar   = bSlot * 0.54;

const bx    = (i: number) => BmL + i * bSlot + (bSlot - bBar) / 2;
const bBarH = (v: number) => (v / bScale) * BdH;
const bBarY = (v: number) => BH - BmB - bBarH(v);
const bTgtY      = BH - BmB - (45 / bScale) * BdH;
const bTgtYStr   = bTgtY.toFixed(1);
const bTgtYLabel = (bTgtY + 4).toFixed(1);

const bars = NET_TREND.map((d, i) => ({
  x:   bx(i).toFixed(1),
  y:   bBarY(d.v).toFixed(1),
  w:   bBar.toFixed(1),
  h:   bBarH(d.v).toFixed(1),
  cur: i === bN - 1,
}));
const bXLabels = NET_TREND.map((d, i) => ({ x: (bx(i) + bBar / 2).toFixed(1), y: BH - BmB + 18, label: d.m }));

// ── Correlation chart: Inquiries vs Contratti  (viewBox 820 × 200)
// Dual-line time series, single scale 0–100
const RW = 820, RH = 200, RmL = 36, RmR = 10, RmT = 16, RmB = 34;
const RdW = RW - RmL - RmR;
const RdH = RH - RmT - RmB;
const rN  = INQ_CTR_TREND.length;
const rScale = 100;

const rx = (i: number) => RmL + (i / (rN - 1)) * RdW;
const ry = (v: number) => RH - RmB - (v / rScale) * RdH;

const rInqLine  = INQ_CTR_TREND.map((d, i) => `${rx(i).toFixed(1)},${ry(d.inq).toFixed(1)}`).join(" ");
const rCtrLine  = INQ_CTR_TREND.map((d, i) => `${rx(i).toFixed(1)},${ry(d.ctr).toFixed(1)}`).join(" ");

// Shaded gap between inq line (top) and ctr line (bottom) — visualises conversion gap
const rGapPoly = [
  ...INQ_CTR_TREND.map((d, i) => `${rx(i).toFixed(1)},${ry(d.inq).toFixed(1)}`),
  ...[...INQ_CTR_TREND].reverse().map((d, ri) => {
    const i = rN - 1 - ri;
    return `${rx(i).toFixed(1)},${ry(d.ctr).toFixed(1)}`;
  }),
].join(" ");

const rGrid   = [25, 50, 75, 100].map(v => ({ v, y: ry(v).toFixed(1), lx: RmL - 5, ly: (ry(v) + 4).toFixed(1) }));
const rXLbls  = INQ_CTR_TREND.map((d, i) => ({ x: rx(i).toFixed(1), y: RH - RmB + 18, label: d.m }));

// Last-point dots
const rLastInqX = rx(rN - 1).toFixed(1);
const rLastInqY = ry(INQ_CTR_TREND[rN - 1].inq).toFixed(1);
const rLastCtrX = rx(rN - 1).toFixed(1);
const rLastCtrY = ry(INQ_CTR_TREND[rN - 1].ctr).toFixed(1);

const updated = new Date().toLocaleString("it-IT", {
  day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit",
});
---

<BaseLayout
  title="TCA · Performance Cockpit"
  description="Proof of concept — cruscotto di performance del Tennis Club Ambrosiano."
  initialHeaderDark={false}
  noindex={true}
>
  <main class="cockpit">

    <!-- ── POC NOTICE ── -->
    <div class="poc-notice">
      <span class="poc-tag">PROOF OF CONCEPT</span>
      Dati simulati a scopo dimostrativo. In produzione questo cruscotto si collega direttamente ai sistemi gestionali del club in tempo reale.
    </div>

    <div class="cockpit-wrap">

      <!-- ── PAGE HEADER ── -->
      <header class="cockpit-header">
        <span class="eyebrow eyebrow--grey">Tennis Club Ambrosiano · Cruscotto di Performance</span>
        <h1 class="cockpit-title">Il club, <em>a colpo d'occhio.</em></h1>
        <p class="cockpit-sub">
          Ogni leva che muove la performance — costi, conversioni, crescita — leggibile in cinque secondi.
          Collegato ai sistemi del club, sempre aggiornato.
        </p>
        <p class="cockpit-sync">Ultimo aggiornamento · {updated}</p>
      </header>

      <!-- ── KPI GRID — RIGHE 1 E 2 ── -->
      <section class="kpi-grid">

        <!-- Hero card -->
        <div class="kpi-hero">
          <div>
            <span class="kpi-hero__eyebrow">Il Numero Chiave</span>
            <p class="kpi-hero__label">{hero.label}</p>
          </div>
          <div class="kpi-hero__body">
            <span class="kpi-hero__value">{hero.mtd}</span>
            <div class="kpi-hero__aside">
              <span class:list={['kpi-hero__delta', { 'is-good': hero.improving, 'is-bad': !hero.improving }]}>
                {hero.arrow} {hero.deltaTxt} vs mese prec.
              </span>
              <span class="kpi-hero__meta">YTD {hero.ytd} · TARGET {hero.target}</span>
            </div>
          </div>
        </div>

        <!-- Row 1: Staff Cost + Lead Conv -->
        {grid1.map(k => (
          <div class="kpi-card">
            <p class="kpi-card__label">{k.label}</p>
            <div class="kpi-card__top">
              <span class="kpi-card__value">{k.fmtMtd}</span>
              <span class:list={['kpi-card__delta', { 'is-good': k.improving, 'is-bad': !k.improving }]}>
                {k.arrow} {k.deltaTxt}
              </span>
            </div>
            <div class="kpi-card__stats">
              {[['MTD', k.fmtMtd], ['YTD', k.fmtYtd], ['TGT', k.fmtTarget]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
            <div class="kpi-card__meter">
              <div class:list={['kpi-card__fill', { 'on-target': k.onTarget }]} style={`width:${k.meterPct}`}></div>
            </div>
            <p class:list={['kpi-card__status', { 'on-target': k.onTarget }]}>
              {k.onTarget ? '● ON TARGET' : `${Math.round(k.meter * 100)}% verso target`}
            </p>
          </div>
        ))}

        <!-- Row 2: 4 cards -->
        {grid2.map(k => (
          <div class="kpi-card">
            <p class="kpi-card__label">{k.label}</p>
            <div class="kpi-card__top">
              <span class="kpi-card__value">{k.fmtMtd}</span>
              <span class:list={['kpi-card__delta', { 'is-good': k.improving, 'is-bad': !k.improving }]}>
                {k.arrow} {k.deltaTxt}
              </span>
            </div>
            <div class="kpi-card__stats">
              {[['MTD', k.fmtMtd], ['YTD', k.fmtYtd], ['TGT', k.fmtTarget]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
            <div class="kpi-card__meter">
              <div class:list={['kpi-card__fill', { 'on-target': k.onTarget }]} style={`width:${k.meterPct}`}></div>
            </div>
            <p class:list={['kpi-card__status', { 'on-target': k.onTarget }]}>
              {k.onTarget ? '● ON TARGET' : `${Math.round(k.meter * 100)}% verso target`}
            </p>
          </div>
        ))}

      </section>

      <!-- ── KPI GRID — RIGA 3: INQUIRIES + CONTRATTI ── -->
      <section class="kpi-grid kpi-grid--row3">

        <!-- Inquiries breakdown card -->
        <div class="kpi-inq">
          <div class="kpi-inq__head">
            <div>
              <p class="kpi-card__label">Inquiries Ricevute</p>
              <div class="kpi-inq__top">
                <span class="kpi-inq__total">{INQUIRY.total}</span>
                <span class:list={['kpi-card__delta', { 'is-good': inqGood, 'is-bad': !inqGood }]}>
                  {inqArrow} {Math.abs(inqDelta)} vs mese prec.
                </span>
              </div>
            </div>
            <div class="kpi-inq__meta-col">
              {[['YTD', INQUIRY.ytd], ['TGT', `${INQUIRY.target}/mese`]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Breakdown bars -->
          <div class="inq-breakdown">
            {INQUIRY.types.map(t => (
              <div class="inq-row">
                <span class="inq-label">{t.label}</span>
                <div class="inq-bar-wrap">
                  <div class="inq-bar" style={`width:${t.pct}%`}></div>
                </div>
                <span class="inq-n">{t.n}</span>
                <span class="inq-pct">{t.pct}%</span>
              </div>
            ))}
          </div>

          <div class="kpi-card__meter" style="margin-top:6px">
            <div class:list={['kpi-card__fill', { 'on-target': inqMeter >= 1 }]} style={`width:${Math.min(100, inqMeter * 100).toFixed(0)}%`}></div>
          </div>
          <p class:list={['kpi-card__status', { 'on-target': inqMeter >= 1 }]}>
            {inqMeter >= 1 ? '● ON TARGET' : `${Math.round(inqMeter * 100)}% verso target`}
          </p>
        </div>

        <!-- New Contracts -->
        {grid3.map(k => (
          <div class="kpi-card">
            <p class="kpi-card__label">{k.label}</p>
            <div class="kpi-card__top">
              <span class="kpi-card__value">{k.fmtMtd}</span>
              <span class:list={['kpi-card__delta', { 'is-good': k.improving, 'is-bad': !k.improving }]}>
                {k.arrow} {k.deltaTxt}
              </span>
            </div>
            <div class="kpi-card__stats">
              {[['MTD', k.fmtMtd], ['YTD', k.fmtYtd], ['TGT', k.fmtTarget]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
            <div class="kpi-card__meter">
              <div class:list={['kpi-card__fill', { 'on-target': k.onTarget }]} style={`width:${k.meterPct}`}></div>
            </div>
            <p class:list={['kpi-card__status', { 'on-target': k.onTarget }]}>
              {k.onTarget ? '● ON TARGET' : `${Math.round(k.meter * 100)}% verso target`}
            </p>
          </div>
        ))}

      </section>

      <!-- ── CHARTS ROW 1 ── -->
      <section class="charts-row">

        <!-- Stacked area: online vs sede -->
        <div class="chart-card">
          <div class="chart-card__head">
            <h2 class="chart-title">Membership <em>online</em> vs sede</h2>
            <div class="chart-legend">
              <span class="leg leg-online">● Online</span>
              <span class="leg leg-club">● Sede</span>
            </div>
          </div>
          <svg viewBox={`0 0 ${AW} ${AH}`} class="chart-svg" aria-hidden="true">
            {aGrid.map(g => (
              <g>
                <line x1={AmL} y1={g.y} x2={AW - AmR} y2={g.y} stroke="#1A1A1A" stroke-opacity="0.06" stroke-width="1" />
                <text x={g.lx} y={g.ly} text-anchor="end" font-family="'Barlow Condensed', sans-serif" font-size="10" fill="#AAAAAA">{g.v}</text>
              </g>
            ))}
            <polygon points={aClubPoly}   fill="#1A1A1A" fill-opacity="0.07" />
            <polygon points={aOnlinePoly} fill="#8B1A1A" fill-opacity="0.14" />
            <polyline points={aClubLine}  fill="none" stroke="#CCCCCC" stroke-width="1.5" stroke-linejoin="round" />
            <polyline points={aTotalLine} fill="none" stroke="#8B1A1A" stroke-width="2"   stroke-linejoin="round" />
            {aXLabels.map(l => (
              <text x={l.x} y={l.y} text-anchor="middle" font-family="'Barlow Condensed', sans-serif" font-size="10" fill="#AAAAAA">{l.label}</text>
            ))}
          </svg>
        </div>

        <!-- Bar chart: net member growth -->
        <div class="chart-card">
          <div class="chart-card__head">
            <h2 class="chart-title">Crescita <em>soci netti</em></h2>
            <span class="chart-target-label">Target 45/mese</span>
          </div>
          <svg viewBox={`0 0 ${BW} ${BH}`} class="chart-svg" aria-hidden="true">
            <line x1={BmL} y1={bTgtYStr} x2={BW - BmR} y2={bTgtYStr} stroke="#8B1A1A" stroke-width="1" stroke-dasharray="5 4" />
            {bars.map(b => (
              <rect x={b.x} y={b.y} width={b.w} height={b.h} fill="#8B1A1A" fill-opacity={b.cur ? 1 : 0.28} rx="2" />
            ))}
            {bXLabels.map(l => (
              <text x={l.x} y={l.y} text-anchor="middle" font-family="'Barlow Condensed', sans-serif" font-size="9" fill="#AAAAAA">{l.label}</text>
            ))}
            <text x={BW - BmR + 2} y={bTgtYLabel} font-family="'Barlow Condensed', sans-serif" font-size="9" fill="#8B1A1A">45</text>
          </svg>
        </div>

      </section>

      <!-- ── CHART ROW 2: CORRELAZIONE INQUIRIES / CONTRATTI ── -->
      <div class="chart-card chart-card--full">
        <div class="chart-card__head">
          <div>
            <h2 class="chart-title">Correlazione <em>inquiries</em> · nuovi contratti</h2>
            <p class="chart-subtitle">Per ogni picco di inquiries, i nuovi contratti seguono con coerenza elevata.</p>
          </div>
          <div class="corr-badge">
            <span class="corr-r">r = 0.97</span>
            <span class="corr-label">correlazione elevata</span>
          </div>
        </div>
        <div class="chart-legend" style="margin-bottom:14px">
          <span class="leg leg-inq">── Inquiries ricevute</span>
          <span class="leg leg-ctr">── Nuovi contratti</span>
          <span class="leg leg-gap">▓ Gap di conversione</span>
        </div>
        <svg viewBox={`0 0 ${RW} ${RH}`} class="chart-svg" aria-hidden="true">
          {rGrid.map(g => (
            <g>
              <line x1={RmL} y1={g.y} x2={RW - RmR} y2={g.y} stroke="#1A1A1A" stroke-opacity="0.06" stroke-width="1" />
              <text x={g.lx} y={g.ly} text-anchor="end" font-family="'Barlow Condensed', sans-serif" font-size="10" fill="#AAAAAA">{g.v}</text>
            </g>
          ))}
          <!-- Gap area (inquiries − contracts) -->
          <polygon points={rGapPoly} fill="#8B1A1A" fill-opacity="0.07" />
          <!-- Inquiry line -->
          <polyline points={rInqLine} fill="none" stroke="#8B1A1A" stroke-width="2" stroke-linejoin="round" />
          <!-- Contract line -->
          <polyline points={rCtrLine} fill="none" stroke="#555555" stroke-width="2" stroke-linejoin="round" stroke-dasharray="6 3" />
          <!-- Terminal dots -->
          <circle cx={rLastInqX} cy={rLastInqY} r="4" fill="#8B1A1A" />
          <circle cx={rLastCtrX} cy={rLastCtrY} r="4" fill="#555555" />
          <!-- Labels at last points -->
          <text x={Number(rLastInqX) + 8} y={Number(rLastInqY) + 4} font-family="'Barlow Condensed', sans-serif" font-size="11" font-weight="700" fill="#8B1A1A">87</text>

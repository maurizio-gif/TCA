              <div class="cp-stat"><span class="cp-stat-k">YTD</span><span class="cp-stat-v" data-m="inq_ytd">{D.inq.ytd}</span></div>
              <div class="cp-stat"><span class="cp-stat-k">Prior</span><span class="cp-stat-v" data-m="inq_prior">{D.inq.prior}</span></div>
              <div class="cp-trend trend-good" data-m="inq_trend">
                +{(((D.inq.mtd - D.inq.prior) / D.inq.prior) * 100).toFixed(1)}% MoM
              </div>
            </div>
          </div>
          <div class="cp-stage-breakdown">
            <div class="cp-breakdown-title">Source breakdown</div>
            {[
              { label: 'New Leads',       key: 'inq_new',    n: D.inq.new_leads, pct: Math.round(D.inq.new_leads / D.inq.mtd * 100) },
              { label: 'Returning Leads', key: 'inq_ret',    n: D.inq.returning, pct: Math.round(D.inq.returning  / D.inq.mtd * 100) },
              { label: 'Former Members',  key: 'inq_former', n: D.inq.former,    pct: Math.round(D.inq.former     / D.inq.mtd * 100) },
            ].map(r => (
              <div class="cp-bk-row">
                <span class="cp-bk-lbl">{r.label}</span>
                <div class="cp-bk-bar-wrap">
                  <div class="cp-bk-bar-fill" data-bar={r.key} style={`width:${r.pct}%`}></div>
                </div>
                <span class="cp-bk-n" data-m={r.key}>{r.n}</span>
                <span class="cp-bk-pct" data-m={`${r.key}_pct`}>{r.pct}%</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- CONNECTOR 1→2 -->
      <div class="cp-connector">
        <div class="cp-connector-line"></div>
        <div class="cp-connector-pill">
          <span class="cp-connector-label">Inquiry → Membership</span>
          <span class="cp-connector-rate" data-m="conv_rate">{D.conv.mtd}%</span>
        </div>
        <div class="cp-connector-line"></div>
      </div>

      <!-- STAGE 2: New Memberships + correlation -->
      <div class="cp-funnel-stage">
        <div class="cp-stage-header">
          <div class="cp-stage-num">02</div>
          <div class="cp-stage-title">New Memberships</div>
        </div>
        <div class="cp-stage-body cp-stage-body--wide">
          <div class="cp-stage-kpi">
            <div class="cp-kpi-eyebrow">Total MTD</div>
            <div class="cp-kpi-value cp-kpi-value--stage" data-m="new2_mtd">{D.total_new.mtd}</div>
            <div class="cp-kpi-subrow">
              <div class="cp-stat"><span class="cp-stat-k">YTD</span><span class="cp-stat-v" data-m="new2_ytd">{D.total_new.ytd}</span></div>
              <div class="cp-stat"><span class="cp-stat-k">Prior</span><span class="cp-stat-v" data-m="new2_prior">{D.total_new.prior}</span></div>
              <div class="cp-trend trend-good" data-m="new2_trend">
                +{(((D.total_new.mtd - D.total_new.prior) / D.total_new.prior) * 100).toFixed(1)}% MoM
              </div>
            </div>
          </div>

          <!-- Correlation chart -->
          <div class="cp-chart-wrap cp-chart-wrap--corr">
            <div class="cp-chart-title">Inquiries vs. New Memberships · 12-Month Trend</div>
            <svg viewBox={`0 0 ${CW} ${CH}`} class="cp-svg" preserveAspectRatio="xMidYMid meet">
              <path d={gapPath} fill="rgba(139,26,26,0.07)" />
              <polyline points={inqPts} fill="none" stroke="rgba(139,26,26,0.9)" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
              <polyline points={newPts} fill="none" stroke="rgba(139,26,26,0.4)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="5,3" />
              {INQ_TREND.map((v, i) => (
                <circle cx={cx(i)} cy={cy(v)} r="3.5" fill="#8B1A1A" />
              ))}
              {NEW_TREND.map((v, i) => (
                <circle cx={cx(i)} cy={cy(v)} r="3" fill="none" stroke="#8B1A1A" stroke-width="1.8" />
              ))}
              {MONTHS.map((m, i) => (
                <text x={cx(i)} y={CH - 8} text-anchor="middle" class="cp-svg-label">{m}</text>
              ))}
              <text x={cx(11)} y={cy(INQ_TREND[11]) - 8} text-anchor="middle" class="cp-svg-val">{INQ_TREND[11]}</text>
              <text x={cx(11)} y={cy(NEW_TREND[11]) + 16} text-anchor="middle" class="cp-svg-val">{NEW_TREND[11]}</text>
            </svg>
            <div class="cp-chart-legend">
              <span class="cp-leg cp-leg--solid">Inquiries</span>
              <span class="cp-leg cp-leg--dashed">New Memberships</span>
              <span class="cp-corr-badge">r = 0.97</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CONNECTOR 2→3 -->
      <div class="cp-connector">
        <div class="cp-connector-line"></div>
        <div class="cp-connector-pill cp-connector-pill--cancel">
          <span class="cp-connector-label">Leavers MTD</span>
          <span class="cp-connector-rate" data-m="cancel_val">−{D.cancelled.mtd}</span>
        </div>
        <div class="cp-connector-line"></div>
      </div>

      <!-- STAGE 3: Leavers + Net Balance -->
      <div class="cp-funnel-stage">
        <div class="cp-stage-header">
          <div class="cp-stage-num">03</div>
          <div class="cp-stage-title">Leavers &amp; Net Balance</div>
        </div>
        <div class="cp-stage-body cp-stage-body--wide">
          <div class="cp-stage-pair">
            <div class="cp-mini-kpi">
              <div class="cp-kpi-eyebrow">Leavers MTD</div>
              <div class="cp-kpi-value cp-kpi-value--stage cp-kpi-value--bad" data-m="cancel_mtd">{D.cancelled.mtd}</div>
              <div class="cp-kpi-subrow">
                <div class="cp-stat"><span class="cp-stat-k">YTD</span><span class="cp-stat-v" data-m="cancel_ytd">{D.cancelled.ytd}</span></div>
                <div class="cp-stat"><span class="cp-stat-k">Prior</span><span class="cp-stat-v" data-m="cancel_prior">{D.cancelled.prior}</span></div>
                <div class="cp-trend trend-good" data-m="cancel_trend">
                  {(((D.cancelled.mtd - D.cancelled.prior) / D.cancelled.prior) * 100).toFixed(1)}% MoM
                </div>
              </div>
            </div>
            <div class="cp-mini-kpi">
              <div class="cp-kpi-eyebrow">Net Balance MTD</div>
              <div class="cp-kpi-value cp-kpi-value--stage" data-m="net_mtd">+{D.net.mtd}</div>
              <div class="cp-kpi-subrow">
                <div class="cp-stat"><span class="cp-stat-k">YTD</span><span class="cp-stat-v" data-m="net_ytd">+{D.net.ytd}</span></div>
                <div class="cp-stat"><span class="cp-stat-k">Prior</span><span class="cp-stat-v" data-m="net_prior">+{D.net.prior}</span></div>
                <div class="cp-trend trend-good" data-m="net_trend">
                  +{(((D.net.mtd - D.net.prior) / D.net.prior) * 100).toFixed(1)}% MoM
                </div>
              </div>
            </div>
          </div>

          <!-- Net balance bar chart -->
          <div class="cp-chart-wrap">
            <div class="cp-chart-title">Monthly Net Balance (New − Leavers)</div>
            <svg viewBox={`0 0 ${BW} ${BH}`} class="cp-svg cp-svg--bal" preserveAspectRatio="xMidYMid meet">
              <line x1={bPL} y1={bZeroY} x2={BW - bPR} y2={bZeroY} stroke="rgba(0,0,0,0.15)" stroke-width="1" stroke-dasharray="3,3" />
              {bBars.map((b) => (
                <rect x={b.x} y={b.y} width={b.w} height={b.h}
                  fill={b.pos ? 'rgba(139,26,26,0.8)' : 'rgba(180,60,60,0.35)'}
                  rx="2" />
              ))}
              {MONTHS.map((m, i) => (
                <text
                  x={bPL + (i / MONTHS.length) * bInner + bInner / MONTHS.length * 0.5}
                  y={BH - 6}
                  text-anchor="middle"
                  class="cp-svg-label"
                >{m}</text>
              ))}
              {bBars.map((b, i) => (
                <text
                  x={b.x + b.w / 2}
                  y={b.pos ? b.y - 3 : b.y + b.h + 10}
                  text-anchor="middle"
                  class="cp-svg-val"
                >{b.v > 0 ? '+' : ''}{b.v}</text>
              ))}
            </svg>
          </div>
        </div>
      </div>

      <!-- CONNECTOR 3→4 -->
      <div class="cp-connector">
        <div class="cp-connector-line"></div>
        <div class="cp-connector-pill">
          <span class="cp-connector-label">Cumulative active base</span>
        </div>
        <div class="cp-connector-line"></div>
      </div>

      <!-- STAGE 4: Active Members EoM + Churn -->
      <div class="cp-funnel-stage">
        <div class="cp-stage-header">
          <div class="cp-stage-num">04</div>
          <div class="cp-stage-title">Active Members EoM &amp; Churn</div>
        </div>
        <div class="cp-stage-body">
          <div class="cp-stage-pair">
            <div class="cp-mini-kpi">
              <div class="cp-kpi-eyebrow">Active Members EoM</div>
              <div class="cp-kpi-value cp-kpi-value--stage" data-m="active_mtd">{D.active.mtd.toLocaleString('en')}</div>
              <div class="cp-kpi-subrow">
                <div class="cp-stat"><span class="cp-stat-k">Prior EoM</span><span class="cp-stat-v" data-m="active_prior">{D.active.prior.toLocaleString('en')}</span></div>
                <div class="cp-trend trend-good" data-m="active_trend">
                  +{D.active.mtd - D.active.prior} vs prior
                </div>
              </div>
            </div>
            <div class="cp-mini-kpi">
              <div class="cp-kpi-eyebrow">Monthly Churn Rate</div>
              <div class="cp-kpi-value cp-kpi-value--stage" data-m="churn_mtd">{D.churn.mtd}%</div>
              <div class="cp-kpi-subrow">
                <div class="cp-stat"><span class="cp-stat-k">Prior Mo.</span><span class="cp-stat-v" data-m="churn_prior">{D.churn.prior}%</span></div>
                <div class="cp-trend trend-good" data-m="churn_trend">
                  {((D.churn.mtd - D.churn.prior)).toFixed(2)}pp MoM
                </div>
              </div>
              <div class="cp-kpi-note">Lower is better</div>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /funnel-section -->

    <!-- NO-FUNNEL MESSAGE -->
    <div class="cp-no-funnel" id="no-funnel-msg" style="display:none">
      <p>No membership funnel data for this Business Unit.</p>
    </div>

    <!-- ── FACILITY USAGE ── -->
    <div class="cp-section">
      <div class="cp-section-label">Facility Usage · Accesses &amp; Bookings</div>

      <!-- KPI row -->
      <div class="cp-usage-kpi-row">
        <div class="cp-kpi-card">
          <div class="cp-kpi-eyebrow">Total Interactions MTD</div>
          <div class="cp-kpi-value">{uTotalMTD.toLocaleString('en')}</div>
          <div class="cp-kpi-subrow">
            <div class="cp-stat"><span class="cp-stat-k">Daily Avg</span><span class="cp-stat-v">{Math.round(uTotalMTD / DAYS.length)}</span></div>
            <div class="cp-stat"><span class="cp-stat-k">Peak Day</span><span class="cp-stat-v">{DAYS[uPeakDay]}</span></div>
            <div class="cp-trend trend-good">+7.2% MoM</div>
          </div>
        </div>
        <div class="cp-kpi-card">
          <div class="cp-kpi-eyebrow">Busiest Day</div>
          <div class="cp-kpi-value">{DAYS[uPeakDay]}</div>
          <div class="cp-kpi-subrow">
            <div class="cp-stat"><span class="cp-stat-k">Interactions</span><span class="cp-stat-v">{DAY_TOT[uPeakDay]}</span></div>
            <div class="cp-stat"><span class="cp-stat-k">Quietest</span><span class="cp-stat-v">{DAYS[DAY_TOT.indexOf(Math.min(...DAY_TOT))]}</span></div>
          </div>
        </div>
        <div class="cp-kpi-card">
          <div class="cp-kpi-eyebrow">Peak Hour</div>
          <div class="cp-kpi-value">{HOURS[uPeakHour]}:00</div>
          <div class="cp-kpi-subrow">
            <div class="cp-stat"><span class="cp-stat-k">Interactions</span><span class="cp-stat-v">{HOUR_TOT[uPeakHour]}</span></div>
            <div class="cp-stat"><span class="cp-stat-k">Off-peak</span><span class="cp-stat-v">{HOURS[HOUR_TOT.indexOf(Math.min(...HOUR_TOT))]}:00</span></div>
          </div>
          <div class="cp-kpi-note">Source: access logs &amp; booking system</div>
        </div>
      </div>

      <!-- Weekly bar chart -->
      <div class="cp-opcost-chart" style="margin-top:16px">
        <div class="cp-chart-title">Interactions by Day of Week · Accesses + Bookings Aggregated</div>
        <svg viewBox={`0 0 ${UW} ${UH}`} class="cp-svg" preserveAspectRatio="xMidYMid meet">
          {uDayBars.map((b, i) => (
            <rect x={b.x} y={b.y} width={uBarW} height={b.h}
              fill={i === uPeakDay ? 'rgba(139,26,26,0.90)' : 'rgba(139,26,26,0.55)'} rx="2" />
          ))}
          {DAYS.map((d, i) => (
            <text
              x={uPL + (i / DAYS.length) * uInner + uInner / DAYS.length * 0.5}
              y={UH - 8}
              text-anchor="middle"
              class="cp-svg-label"
            >{d}</text>
          ))}
          <text x={uDayBars[uPeakDay].x + uBarW / 2} y={uDayBars[uPeakDay].y - 5} text-anchor="middle" class="cp-svg-val">
            {uDayBars[uPeakDay].v}
          </text>
        </svg>
      </div>

      <!-- Hourly bar chart -->
      <div class="cp-opcost-chart" style="margin-top:16px">
        <div class="cp-chart-title">Interactions by Hour · Accesses + Bookings Aggregated (Avg Day)</div>
        <svg viewBox={`0 0 ${HW} ${HH}`} class="cp-svg" preserveAspectRatio="xMidYMid meet">
          {uHourBars.map((b, i) => (
            <rect x={b.x} y={b.y} width={hBarW} height={b.h}
              fill={i === uPeakHour ? 'rgba(139,26,26,0.90)' : 'rgba(139,26,26,0.55)'} rx="2" />
          ))}
          {HOURS.map((h, i) => (
            <text
              x={hPL + (i / HOURS.length) * hInner + hInner / HOURS.length * 0.5}
              y={HH - 8}
              text-anchor="middle"
              class="cp-svg-label"
            >{h}:00</text>
          ))}
          <text x={uHourBars[uPeakHour].x + hBarW / 2} y={uHourBars[uPeakHour].y - 5} text-anchor="middle" class="cp-svg-val">
            {uHourBars[uPeakHour].v}
          </text>
        </svg>
      </div>

    </div>

  </div><!-- /cp-root -->

</BaseLayout>

<script define:vars={{ BU_DATA }}>
  const DATA = BU_DATA;
  let selected = new Set(['all']);

  function pct(a, b) {
    if (!b) return 0;
    return Math.round((a / b) * 100);
  }

  function trendPct(cur, prior) {
    if (!prior) return 0;
    return ((cur - prior) / prior * 100);
  }

  function getDisplayData() {
    const keys = [...selected];
    if (keys.includes('all') || keys.length === 0) return DATA.all;
    if (keys.length === 1) return DATA[keys[0]];

    const items = keys.map(k => DATA[k]);
    const sum = (field, sub) => items.reduce((acc, d) => acc + (sub ? d[field][sub] : d[field]), 0);
    const wavg = (field, sub, weightField, weightSub) => {
      const totalW = sum(weightField, weightSub);
      if (!totalW) return 0;
      return items.reduce((acc, d) => acc + d[field][sub] * d[weightField][weightSub], 0) / totalW;
    };

    return {
      revenue:   { mtd: sum('revenue','mtd'),   ytd: sum('revenue','ytd'),   prior: sum('revenue','prior') },
      opcost:    { mtd: sum('opcost','mtd'),     ytd: sum('opcost','ytd'),    prior: sum('opcost','prior') },
      staff:     { mtd: wavg('staff','mtd','revenue','mtd'), ytd: wavg('staff','ytd','revenue','ytd'), prior: wavg('staff','prior','revenue','prior') },
      online:    { mtd: sum('online','mtd'),     ytd: sum('online','ytd'),    prior: sum('online','prior') },
      onsite:    { mtd: sum('onsite','mtd'),     ytd: sum('onsite','ytd'),    prior: sum('onsite','prior') },
      total_new: { mtd: sum('total_new','mtd'),  ytd: sum('total_new','ytd'), prior: sum('total_new','prior') },
      inq: {
        mtd: sum('inq','mtd'), ytd: sum('inq','ytd'), prior: sum('inq','prior'),
        new_leads: items.reduce((a, d) => a + d.inq.new_leads, 0),
        returning: items.reduce((a, d) => a + d.inq.returning, 0),
        former:    items.reduce((a, d) => a + d.inq.former, 0),
      },
      cancelled: { mtd: sum('cancelled','mtd'), ytd: sum('cancelled','ytd'), prior: sum('cancelled','prior') },
      net:       { mtd: sum('net','mtd'),        ytd: sum('net','ytd'),       prior: sum('net','prior') },
      active:    { mtd: sum('active','mtd'),     prior: sum('active','prior') },
      churn:     { mtd: wavg('churn','mtd','active','prior'), prior: wavg('churn','prior','active','prior') },
      conv:      { mtd: wavg('conv','mtd','inq','mtd'), prior: wavg('conv','prior','inq','prior') },
      has_funnel: items.some(d => d.has_funnel),
    };
  }

  function set(attr, val) {
    document.querySelectorAll(`[data-m="${attr}"]`).forEach(el => { el.textContent = String(val); });
  }

  function setTrend(attr, val, goodWhen) {
    document.querySelectorAll(`[data-m="${attr}"]`).forEach(el => {
      el.textContent = String(val);
      el.className = el.className.replace(/\btrend-good\b|\btrend-bad\b/g, '').trim();
      const numVal = parseFloat(String(val));
      const isUp = numVal >= 0;
      const good = (goodWhen === 'up' && isUp) || (goodWhen === 'down' && !isUp);
      el.classList.add(good ? 'trend-good' : 'trend-bad');
    });
  }

  function setBar(attr, pctVal) {
    document.querySelectorAll(`[data-bar="${attr}"]`).forEach(el => {
      el.style.width = Math.max(0, Math.min(100, pctVal)) + '%';
    });
  }

  function render() {
    const d = getDisplayData();

    // Revenue
    set('rev_mtd',   '€' + Math.round(d.revenue.mtd).toLocaleString('en'));
    set('rev_ytd',   '€' + Math.round(d.revenue.ytd).toLocaleString('en'));
    set('rev_prior', '€' + Math.round(d.revenue.prior).toLocaleString('en'));
    const revT = trendPct(d.revenue.mtd, d.revenue.prior);
    setTrend('rev_trend', (revT >= 0 ? '+' : '') + revT.toFixed(1) + '% MoM', 'up');

    // Op. costs
    set('opcost_mtd',   '€' + Math.round(d.opcost.mtd).toLocaleString('en'));
    set('opcost_ytd',   '€' + Math.round(d.opcost.ytd).toLocaleString('en'));
    set('opcost_prior', '€' + Math.round(d.opcost.prior).toLocaleString('en'));
    const opcostT = trendPct(d.opcost.mtd, d.opcost.prior);
    setTrend('opcost_trend', (opcostT >= 0 ? '+' : '') + opcostT.toFixed(1) + '% MoM', 'down');
    const opcostRatioPct = Math.round(d.opcost.mtd / (d.revenue.mtd || 1) * 100);
    const ebitdaPct = 100 - opcostRatioPct;
    set('opcost_ratio', opcostRatioPct + '% of revenue · EBITDA margin ' + ebitdaPct + '%');

    // Staff
    set('staff_mtd',   d.staff.mtd.toFixed(1) + '%');
    set('staff_ytd',   d.staff.ytd.toFixed(1) + '%');
    set('staff_prior', d.staff.prior.toFixed(1) + '%');
    const staffT = d.staff.mtd - d.staff.prior;
    setTrend('staff_trend', (staffT >= 0 ? '+' : '') + staffT.toFixed(1) + 'pp MoM', 'down');

    // New memberships
    set('new_mtd',    d.total_new.mtd);
    set('new_ytd',    d.total_new.ytd);
    set('new_prior',  d.total_new.prior);
    set('new2_mtd',   d.total_new.mtd);
    set('new2_ytd',   d.total_new.ytd);
    set('new2_prior', d.total_new.prior);
    const newT = trendPct(d.total_new.mtd, d.total_new.prior);
    setTrend('new_trend',  (newT >= 0 ? '+' : '') + newT.toFixed(1) + '% MoM', 'up');
    setTrend('new2_trend', (newT >= 0 ? '+' : '') + newT.toFixed(1) + '% MoM', 'up');

    // Online / onsite split
    const totCh  = d.online.mtd  + d.onsite.mtd;
    const totChY = d.online.ytd  + d.onsite.ytd;
    set('online_mtd', d.online.mtd);
    set('onsite_mtd', d.onsite.mtd);
    set('online_pct', pct(d.online.mtd, totCh) + '% online');
    set('onsite_pct', pct(d.onsite.mtd, totCh) + '% on-site');
    set('online_ytd', d.online.ytd);
    set('onsite_ytd', d.onsite.ytd);
    set('online_ytd_pct', pct(d.online.ytd, totChY) + '%');
    set('onsite_ytd_pct', pct(d.onsite.ytd, totChY) + '%');
    const bo = document.getElementById('split-bar-online');
    if (bo) bo.style.width = pct(d.online.mtd, totCh) + '%';
    const by = document.getElementById('split-bar-online-ytd');
    if (by) by.style.width = pct(d.online.ytd, totChY) + '%';

    // Inquiries
    set('inq_mtd',   d.inq.mtd);
    set('inq_ytd',   d.inq.ytd);
    set('inq_prior', d.inq.prior);
    const inqT = trendPct(d.inq.mtd, d.inq.prior);
    setTrend('inq_trend', (inqT >= 0 ? '+' : '') + inqT.toFixed(1) + '% MoM', 'up');

    // Breakdown
    const inqTot = d.inq.mtd || 1;
    set('inq_new',        d.inq.new_leads);
    set('inq_ret',        d.inq.returning);
    set('inq_former',     d.inq.former);
    set('inq_new_pct',    pct(d.inq.new_leads, inqTot) + '%');
    set('inq_ret_pct',    pct(d.inq.returning,  inqTot) + '%');
    set('inq_former_pct', pct(d.inq.former,     inqTot) + '%');
    setBar('inq_new',    pct(d.inq.new_leads, inqTot));
    setBar('inq_ret',    pct(d.inq.returning,  inqTot));
    setBar('inq_former', pct(d.inq.former,     inqTot));

    // Conversion
    set('conv_rate', d.conv.mtd.toFixed(1) + '%');

    // Leavers
    set('cancel_mtd',   d.cancelled.mtd);
    set('cancel_ytd',   d.cancelled.ytd);
    set('cancel_prior', d.cancelled.prior);
    const canT = trendPct(d.cancelled.mtd, d.cancelled.prior);
    setTrend('cancel_trend', (canT >= 0 ? '+' : '') + canT.toFixed(1) + '% MoM', 'down');
    set('cancel_val', '−' + d.cancelled.mtd);

    // Net balance
    set('net_mtd',   (d.net.mtd >= 0 ? '+' : '') + d.net.mtd);
    set('net_ytd',   (d.net.ytd >= 0 ? '+' : '') + d.net.ytd);
    set('net_prior', (d.net.prior >= 0 ? '+' : '') + d.net.prior);
    const netT = trendPct(d.net.mtd, d.net.prior);
    setTrend('net_trend', (netT >= 0 ? '+' : '') + netT.toFixed(1) + '% MoM', 'up');

    // Active
    set('active_mtd',   Math.round(d.active.mtd).toLocaleString('en'));
    set('active_prior', Math.round(d.active.prior).toLocaleString('en'));
    const actD = d.active.mtd - d.active.prior;
    setTrend('active_trend', (actD >= 0 ? '+' : '') + Math.round(actD) + ' vs prior', 'up');

    // Churn
    set('churn_mtd',   d.churn.mtd.toFixed(2) + '%');
    set('churn_prior', d.churn.prior.toFixed(2) + '%');
    const churnT = d.churn.mtd - d.churn.prior;
    setTrend('churn_trend', (churnT >= 0 ? '+' : '') + churnT.toFixed(2) + 'pp MoM', 'down');

    // Funnel visibility
    const funnelEl  = document.getElementById('funnel-section');
    const noFunnel  = document.getElementById('no-funnel-msg');
    const memSec    = document.getElementById('memberships-section');
    if (d.has_funnel) {
      funnelEl.style.display  = '';
      memSec.style.display    = '';
      noFunnel.style.display  = 'none';
    } else {
      funnelEl.style.display  = 'none';
      memSec.style.display    = 'none';
      noFunnel.style.display  = '';
    }
  }

  // BU chip logic
  document.querySelectorAll('.cp-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const bu = chip.dataset.bu;
      if (bu === 'all') {
        selected = new Set(['all']);
      } else {
        selected.delete('all');
        if (selected.has(bu)) {
          selected.delete(bu);
          if (selected.size === 0) selected.add('all');
        } else {
          selected.add(bu);
        }
      }
      document.querySelectorAll('.cp-chip').forEach(c => {
        c.classList.toggle('is-active', selected.has(c.dataset.bu));
      });
      render();
    });
  });

  render();
</script>


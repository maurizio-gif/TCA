---
import BaseLayout from '../layouts/BaseLayout.astro';

// ── KPI data  (replace with Supabase fetch in production)
const KPIS = [
  { id: "online_sales",   label: "Memberships Sold Online",   unit: "",  mtd: 47,   ytd: 286,  target: 60,  prior: 33,   goodWhen: "up",   hero: true  },
  { id: "staff_cost",     label: "Staff Cost / Revenue",      unit: "%", mtd: 41.8, ytd: 44.2, target: 40,  prior: 43.1, goodWhen: "down", hero: false },
  { id: "lead_conv",      label: "Lead → Member Conversion",  unit: "%", mtd: 27.4, ytd: 24.1, target: 30,  prior: 24.6, goodWhen: "up",   hero: false },
  { id: "digital_signup", label: "Digital Sign-ups",          unit: "%", mtd: 61.0, ytd: 48.5, target: 80,  prior: 55.2, goodWhen: "up",   hero: false },
  { id: "net_growth",     label: "Net Member Growth",         unit: "",  mtd: 38,   ytd: 214,  target: 45,  prior: 29,   goodWhen: "up",   hero: false },
  { id: "rev_per_member", label: "Avg. Revenue per Member",   unit: "€", mtd: 86,   ytd: 83,   target: 90,  prior: 84,   goodWhen: "up",   hero: false },
  { id: "renewal",        label: "Renewal Rate",              unit: "%", mtd: 89.2, ytd: 87.6, target: 90,  prior: 88.4, goodWhen: "up",   hero: false },
  { id: "contracts",      label: "New Contracts Signed",      unit: "",  mtd: 47,   ytd: 378,  target: 50,  prior: 42,   goodWhen: "up",   hero: false },
  { id: "inq_ctr_rate",   label: "Inquiry → Contract Rate",   unit: "%", mtd: 54.0, ytd: 44.4, target: 50,  prior: 51.2, goodWhen: "up",   hero: false },
];

// ── Inquiry breakdown (this month)
const INQUIRY = {
  total: 87, prior: 82, ytd: 851, target: 80,
  types: [
    { label: "New Leads",      n: 52, pct: 60 },
    { label: "Returning Leads",n: 21, pct: 24 },
    { label: "Former Members", n: 14, pct: 16 },
  ],
};

// Hero: online vs onsite this month (from latest ONLINE_TREND entry)
const HERO_ONLINE = 47;
const HERO_ONSITE = 18;

function fmt(v: number, unit: string): string {
  if (unit === "€") return `€${v}`;
  if (unit === "%") return `${v.toFixed(1)}%`;
  return String(v);
}

function computeKpi(k: typeof KPIS[0]) {
  const raw = k.mtd - k.prior;
  const improving = k.goodWhen === "up" ? raw > 0 : raw < 0;
  const arrow = raw === 0 ? "→" : raw > 0 ? "↑" : "↓";
  const mag = Math.abs(raw);
  const deltaTxt = k.unit === "%" ? `${mag.toFixed(1)} pt` : k.unit === "€" ? `€${mag.toFixed(0)}` : String(mag);
  const meter =
    k.goodWhen === "down"
      ? Math.max(0, Math.min(1, (k.prior - k.mtd) / (k.prior - k.target || 1)))
      : Math.max(0, Math.min(1, k.mtd / k.target));
  const onTarget = k.goodWhen === "down" ? k.mtd <= k.target : k.mtd >= k.target;
  return {
    ...k,
    improving,
    arrow,
    deltaTxt,
    meter,
    onTarget,
    meterPct: `${(meter * 100).toFixed(1)}%`,
    fmtMtd: fmt(k.mtd, k.unit),
    fmtYtd: fmt(k.ytd, k.unit),
    fmtTarget: fmt(k.target, k.unit),
  };
}

const kpis  = KPIS.map(computeKpi);
const hero  = kpis.find(k => k.hero)!;
const grid1 = kpis.filter(k => ['staff_cost','lead_conv'].includes(k.id));
const grid2 = kpis.filter(k => ['digital_signup','net_growth','rev_per_member','renewal'].includes(k.id));
const grid3 = kpis.filter(k => ['contracts','inq_ctr_rate'].includes(k.id));

// Inquiry delta
const inqDelta = INQUIRY.total - INQUIRY.prior;
const inqGood  = inqDelta >= 0;
const inqArrow = inqDelta > 0 ? "↑" : inqDelta < 0 ? "↓" : "→";
const inqMeter = Math.min(1, INQUIRY.total / INQUIRY.target);

// ── 12-month trend data
const ONLINE_TREND = [
  { m: "Jul", online:  9, club: 28 }, { m: "Aug", online:  7, club: 19 },
  { m: "Sep", online: 14, club: 31 }, { m: "Oct", online: 18, club: 26 },
  { m: "Nov", online: 21, club: 25 }, { m: "Dec", online: 16, club: 22 },
  { m: "Jan", online: 28, club: 27 }, { m: "Feb", online: 31, club: 24 },
  { m: "Mar", online: 36, club: 23 }, { m: "Apr", online: 39, club: 21 },
  { m: "May", online: 43, club: 19 }, { m: "Jun", online: 47, club: 18 },
];

const NET_TREND = [
  { m: "Jul", v: 12 }, { m: "Aug", v:  8 }, { m: "Sep", v: 22 },
  { m: "Oct", v: 19 }, { m: "Nov", v: 25 }, { m: "Dec", v: 14 },
  { m: "Jan", v: 31 }, { m: "Feb", v: 27 }, { m: "Mar", v: 33 },
  { m: "Apr", v: 24 }, { m: "May", v: 29 }, { m: "Jun", v: 38 },
];

const INQ_CTR_TREND = [
  { m: "Jul", inq: 64, ctr: 34 }, { m: "Aug", inq: 48, ctr: 27 },
  { m: "Sep", inq: 72, ctr: 41 }, { m: "Oct", inq: 68, ctr: 38 },
  { m: "Nov", inq: 75, ctr: 44 }, { m: "Dec", inq: 54, ctr: 32 },
  { m: "Jan", inq: 81, ctr: 51 }, { m: "Feb", inq: 77, ctr: 47 },
  { m: "Mar", inq: 88, ctr: 54 }, { m: "Apr", inq: 82, ctr: 50 },
  { m: "May", inq: 82, ctr: 42 }, { m: "Jun", inq: 87, ctr: 47 },
];

// ── Area chart SVG geometry  (viewBox 540 × 220)
const AW = 540, AH = 220, AmL = 40, AmR = 12, AmT = 12, AmB = 38;
const AdW = AW - AmL - AmR;
const AdH = AH - AmT - AmB;
const aN  = ONLINE_TREND.length;
const aMax = Math.max(...ONLINE_TREND.map(d => d.online + d.club)) * 1.18;

const ax = (i: number) => AmL + (i / (aN - 1)) * AdW;
const ay = (v: number) => AH - AmB - (v / aMax) * AdH;

const aClubPoly = [
  `${ax(0).toFixed(1)},${(AH - AmB).toFixed(1)}`,
  ...ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.club).toFixed(1)}`),
  `${ax(aN - 1).toFixed(1)},${(AH - AmB).toFixed(1)}`,
].join(" ");

const aOnlinePoly = [
  ...ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.club).toFixed(1)}`),
  ...[...ONLINE_TREND].reverse().map((d, ri) => {
    const i = aN - 1 - ri;
    return `${ax(i).toFixed(1)},${ay(d.online + d.club).toFixed(1)}`;
  }),
].join(" ");

const aClubLine  = ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.club).toFixed(1)}`).join(" ");
const aTotalLine = ONLINE_TREND.map((d, i) => `${ax(i).toFixed(1)},${ay(d.online + d.club).toFixed(1)}`).join(" ");
const aGrid      = [0, 20, 40, 60].map(v => ({ v, y: ay(v).toFixed(1), lx: AmL - 6, ly: (ay(v) + 4).toFixed(1) }));
const aXLabels   = ONLINE_TREND.map((d, i) => ({ x: ax(i).toFixed(1), y: AH - AmB + 20, label: d.m }));

// ── Bar chart SVG geometry  (viewBox 380 × 220)
const BW = 380, BH = 220, BmL = 40, BmR = 18, BmT = 12, BmB = 38;
const BdW = BW - BmL - BmR;
const BdH = BH - BmT - BmB;
const bN     = NET_TREND.length;
const bScale = 45 * 1.28;
const bSlot  = BdW / bN;
const bBar   = bSlot * 0.54;

const bx    = (i: number) => BmL + i * bSlot + (bSlot - bBar) / 2;
const bBarH = (v: number) => (v / bScale) * BdH;
const bBarY = (v: number) => BH - BmB - bBarH(v);
const bTgtY      = BH - BmB - (45 / bScale) * BdH;
const bTgtYStr   = bTgtY.toFixed(1);
const bTgtYLabel = (bTgtY + 5).toFixed(1);

const bars = NET_TREND.map((d, i) => ({
  x:   bx(i).toFixed(1),
  y:   bBarY(d.v).toFixed(1),
  w:   bBar.toFixed(1),
  h:   bBarH(d.v).toFixed(1),
  cur: i === bN - 1,
}));
const bXLabels = NET_TREND.map((d, i) => ({ x: (bx(i) + bBar / 2).toFixed(1), y: BH - BmB + 20, label: d.m }));

// ── Correlation chart  (viewBox 820 × 220)
const RW = 820, RH = 220, RmL = 40, RmR = 12, RmT = 18, RmB = 38;
const RdW = RW - RmL - RmR;
const RdH = RH - RmT - RmB;
const rN     = INQ_CTR_TREND.length;
const rScale = 100;

const rx = (i: number) => RmL + (i / (rN - 1)) * RdW;
const ry = (v: number) => RH - RmB - (v / rScale) * RdH;

const rInqLine = INQ_CTR_TREND.map((d, i) => `${rx(i).toFixed(1)},${ry(d.inq).toFixed(1)}`).join(" ");
const rCtrLine = INQ_CTR_TREND.map((d, i) => `${rx(i).toFixed(1)},${ry(d.ctr).toFixed(1)}`).join(" ");

const rGapPoly = [
  ...INQ_CTR_TREND.map((d, i) => `${rx(i).toFixed(1)},${ry(d.inq).toFixed(1)}`),
  ...[...INQ_CTR_TREND].reverse().map((d, ri) => {
    const i = rN - 1 - ri;
    return `${rx(i).toFixed(1)},${ry(d.ctr).toFixed(1)}`;
  }),
].join(" ");

const rGrid  = [25, 50, 75, 100].map(v => ({ v, y: ry(v).toFixed(1), lx: RmL - 6, ly: (ry(v) + 4).toFixed(1) }));
const rXLbls = INQ_CTR_TREND.map((d, i) => ({ x: rx(i).toFixed(1), y: RH - RmB + 20, label: d.m }));

const rLastInqX  = rx(rN - 1).toFixed(1);
const rLastInqY  = ry(INQ_CTR_TREND[rN - 1].inq).toFixed(1);
const rLastCtrX  = rx(rN - 1).toFixed(1);
const rLastCtrY  = ry(INQ_CTR_TREND[rN - 1].ctr).toFixed(1);
const rLabelInqX = (Number(rLastInqX) + 10).toFixed(1);
const rLabelCtrX = (Number(rLastCtrX) + 10).toFixed(1);

const updated = new Date().toLocaleString("en-GB", {
  day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit",
});
---

<BaseLayout
  title="TCA · Performance Cockpit"
  description="Proof of concept — TCA performance dashboard."
  initialHeaderDark={false}
  noindex={true}
>
  <main class="cockpit">

    <!-- ── POC NOTICE ── -->
    <div class="poc-notice">
      <span class="poc-tag">PROOF OF CONCEPT</span>
      Simulated data for demonstration purposes. In production this dashboard connects directly to the club's management systems in real time.
    </div>

    <div class="cockpit-wrap">

      <!-- ── PAGE HEADER ── -->
      <header class="cockpit-header">
        <span class="eyebrow eyebrow--grey">Tennis Club Ambrosiano · Performance Dashboard</span>
        <h1 class="cockpit-title">The club, <em>at a glance.</em></h1>
        <p class="cockpit-sub">
          Every lever that moves performance — cost, conversion, growth — readable in five seconds.
          Connected to the club's own systems, always current.
        </p>
        <p class="cockpit-sync">Last sync · {updated}</p>
      </header>

      <!-- ── KPI GRID — ROWS 1 & 2 ── -->
      <section class="kpi-grid">

        <!-- Hero card: online vs onsite -->
        <div class="kpi-hero">
          <div>
            <span class="kpi-hero__eyebrow">The Number That Matters</span>
            <p class="kpi-hero__label">Memberships Sold This Month</p>
          </div>
          <div class="kpi-hero__split">
            <div class="kpi-hero__col">
              <span class="kpi-hero__value">{HERO_ONLINE}</span>
              <span class="kpi-hero__channel">Online</span>
            </div>
            <div class="kpi-hero__divider"></div>
            <div class="kpi-hero__col kpi-hero__col--dim">
              <span class="kpi-hero__value kpi-hero__value--dim">{HERO_ONSITE}</span>
              <span class="kpi-hero__channel kpi-hero__channel--dim">Onsite</span>
            </div>
          </div>
          <div class="kpi-hero__footer">
            <span class:list={['kpi-hero__delta', { 'is-good': hero.improving, 'is-bad': !hero.improving }]}>
              {hero.arrow} {hero.deltaTxt} online vs prior month
            </span>
            <span class="kpi-hero__meta">YTD {hero.ytd} · TARGET {hero.target}/mo</span>
          </div>
        </div>

        <!-- Row 1: Staff Cost + Lead Conv -->
        {grid1.map(k => (
          <div class="kpi-card">
            <p class="kpi-card__label">{k.label}</p>
            <div class="kpi-card__top">
              <span class="kpi-card__value">{k.fmtMtd}</span>
              <span class:list={['kpi-card__delta', { 'is-good': k.improving, 'is-bad': !k.improving }]}>
                {k.arrow} {k.deltaTxt}
              </span>
            </div>
            <div class="kpi-card__stats">
              {[['MTD', k.fmtMtd], ['YTD', k.fmtYtd], ['TGT', k.fmtTarget]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
            <div class="kpi-card__meter">
              <div class:list={['kpi-card__fill', { 'on-target': k.onTarget }]} style={`width:${k.meterPct}`}></div>
            </div>
            <p class:list={['kpi-card__status', { 'on-target': k.onTarget }]}>
              {k.onTarget ? '● ON TARGET' : `${Math.round(k.meter * 100)}% to target`}
            </p>
          </div>
        ))}

        <!-- Row 2: 4 cards -->
        {grid2.map(k => (
          <div class="kpi-card">
            <p class="kpi-card__label">{k.label}</p>
            <div class="kpi-card__top">
              <span class="kpi-card__value">{k.fmtMtd}</span>
              <span class:list={['kpi-card__delta', { 'is-good': k.improving, 'is-bad': !k.improving }]}>
                {k.arrow} {k.deltaTxt}
              </span>
            </div>
            <div class="kpi-card__stats">
              {[['MTD', k.fmtMtd], ['YTD', k.fmtYtd], ['TGT', k.fmtTarget]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
            <div class="kpi-card__meter">
              <div class:list={['kpi-card__fill', { 'on-target': k.onTarget }]} style={`width:${k.meterPct}`}></div>
            </div>
            <p class:list={['kpi-card__status', { 'on-target': k.onTarget }]}>
              {k.onTarget ? '● ON TARGET' : `${Math.round(k.meter * 100)}% to target`}
            </p>
          </div>
        ))}

      </section>

      <!-- ── KPI GRID — ROW 3: INQUIRIES + CONTRACTS ── -->
      <section class="kpi-grid kpi-grid--row3">

        <!-- Inquiries breakdown card -->
        <div class="kpi-inq">
          <div class="kpi-inq__head">
            <div>
              <p class="kpi-card__label">Inquiries Received</p>
              <div class="kpi-inq__top">
                <span class="kpi-inq__total">{INQUIRY.total}</span>
                <span class:list={['kpi-card__delta', { 'is-good': inqGood, 'is-bad': !inqGood }]}>
                  {inqArrow} {Math.abs(inqDelta)} vs prior month
                </span>
              </div>
            </div>
            <div class="kpi-inq__meta-col">
              {[['YTD', INQUIRY.ytd], ['TGT', `${INQUIRY.target}/mo`]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="inq-breakdown">
            {INQUIRY.types.map(t => (
              <div class="inq-row">
                <span class="inq-label">{t.label}</span>
                <div class="inq-bar-wrap">
                  <div class="inq-bar" style={`width:${t.pct}%`}></div>
                </div>
                <span class="inq-n">{t.n}</span>
                <span class="inq-pct">{t.pct}%</span>
              </div>
            ))}
          </div>

          <div class="kpi-card__meter" style="margin-top:6px">
            <div class:list={['kpi-card__fill', { 'on-target': inqMeter >= 1 }]} style={`width:${Math.min(100, inqMeter * 100).toFixed(0)}%`}></div>
          </div>
          <p class:list={['kpi-card__status', { 'on-target': inqMeter >= 1 }]}>
            {inqMeter >= 1 ? '● ON TARGET' : `${Math.round(inqMeter * 100)}% to target`}
          </p>
        </div>

        <!-- Contracts + Conversion Rate -->
        {grid3.map(k => (
          <div class="kpi-card">
            <p class="kpi-card__label">{k.label}</p>
            <div class="kpi-card__top">
              <span class="kpi-card__value">{k.fmtMtd}</span>
              <span class:list={['kpi-card__delta', { 'is-good': k.improving, 'is-bad': !k.improving }]}>
                {k.arrow} {k.deltaTxt}
              </span>
            </div>
            <div class="kpi-card__stats">
              {[['MTD', k.fmtMtd], ['YTD', k.fmtYtd], ['TGT', k.fmtTarget]].map(([key, val]) => (
                <div class="kpi-stat">
                  <span class="stat-k">{key}</span>
                  <span class="stat-v">{val}</span>
                </div>
              ))}
            </div>
            <div class="kpi-card__meter">
              <div class:list={['kpi-card__fill', { 'on-target': k.onTarget }]} style={`width:${k.meterPct}`}></div>
            </div>
            <p class:list={['kpi-card__status', { 'on-target': k.onTarget }]}>
              {k.onTarget ? '● ON TARGET' : `${Math.round(k.meter * 100)}% to target`}
            </p>
          </div>
        ))}

      </section>

      <!-- ── CHARTS ROW 1 ── -->
      <section class="charts-row">

        <!-- Stacked area: online vs onsite -->
        <div class="chart-card">
          <div class="chart-card__head">
            <h2 class="chart-title">Memberships sold <em>online</em> vs onsite</h2>
            <div class="chart-legend">
              <span class="leg leg-online">● Online</span>
              <span class="leg leg-club">● Onsite</span>
            </div>
          </div>
          <svg viewBox={`0 0 ${AW} ${AH}`} class="chart-svg" aria-hidden="true">
            {aGrid.map(g => (
              <g>
                <line x1={AmL} y1={g.y} x2={AW - AmR} y2={g.y} stroke="#1A1A1A" stroke-opacity="0.06" stroke-width="1" />
                <text x={g.lx} y={g.ly} text-anchor="end" font-family="'Barlow Condensed', sans-serif" font-size="12" fill="#AAAAAA">{g.v}</text>
              </g>
            ))}
            <polygon points={aClubPoly}   fill="#1A1A1A" fill-opacity="0.07" />
            <polygon points={aOnlinePoly} fill="#8B1A1A" fill-opacity="0.14" />
            <polyline points={aClubLine}  fill="none" stroke="#CCCCCC" stroke-width="2" stroke-linejoin="round" />
            <polyline points={aTotalLine} fill="none" stroke="#8B1A1A" stroke-width="2.5" stroke-linejoin="round" />
            {aXLabels.map(l => (
              <text x={l.x} y={l.y} text-anchor="middle" font-family="'Barlow Condensed', sans-serif" font-size="12" fill="#AAAAAA">{l.label}</text>
            ))}
          </svg>
        </div>

        <!-- Bar chart: net member growth -->
        <div class="chart-card">
          <div class="chart-card__head">
            <h2 class="chart-title">Net <em>member growth</em></h2>
            <span class="chart-target-label">Target 45/mo</span>
          </div>
          <svg viewBox={`0 0 ${BW} ${BH}`} class="chart-svg" aria-hidden="true">
            <line x1={BmL} y1={bTgtYStr} x2={BW - BmR} y2={bTgtYStr} stroke="#8B1A1A" stroke-width="1.5" stroke-dasharray="5 4" />
            {bars.map(b => (
              <rect x={b.x} y={b.y} width={b.w} height={b.h} fill="#8B1A1A" fill-opacity={b.cur ? 1 : 0.28} rx="2" />
            ))}
            {bXLabels.map(l => (
              <text x={l.x} y={l.y} text-anchor="middle" font-family="'Barlow Condensed', sans-serif" font-size="11" fill="#AAAAAA">{l.label}</text>
            ))}
            <text x={BW - BmR + 2} y={bTgtYLabel} font-family="'Barlow Condensed', sans-serif" font-size="11" fill="#8B1A1A">45</text>
          </svg>
        </div>

      </section>

      <!-- ── CHART ROW 2: CORRELATION INQUIRIES / CONTRACTS ── -->
      <div class="chart-card chart-card--full">
        <div class="chart-card__head">
          <div>
            <h2 class="chart-title">Correlation: <em>inquiries</em> · new contracts</h2>
            <p class="chart-subtitle">Every spike in inquiries is followed closely by new contracts — strong predictive signal.</p>
          </div>
          <div class="corr-badge">
            <span class="corr-r">r = 0.97</span>
            <span class="corr-label">strong correlation</span>
          </div>
        </div>
        <div class="chart-legend" style="margin-bottom:16px">
          <span class="leg leg-inq">── Inquiries received</span>
          <span class="leg leg-ctr">── New contracts</span>
          <span class="leg leg-gap">▓ Conversion gap</span>
        </div>
        <svg viewBox={`0 0 ${RW} ${RH}`} class="chart-svg" aria-hidden="true">
          {rGrid.map(g => (
            <g>
              <line x1={RmL} y1={g.y} x2={RW - RmR} y2={g.y} stroke="#1A1A1A" stroke-opacity="0.06" stroke-width="1" />
              <text x={g.lx} y={g.ly} text-anchor="end" font-family="'Barlow Condensed', sans-serif" font-size="12" fill="#AAAAAA">{g.v}</text>
            </g>
          ))}
          <polygon points={rGapPoly} fill="#8B1A1A" fill-opacity="0.07" />
          <polyline points={rInqLine} fill="none" stroke="#8B1A1A" stroke-width="2.5" stroke-linejoin="round" />
          <polyline points={rCtrLine} fill="none" stroke="#555555" stroke-width="2.5" stroke-linejoin="round" stroke-dasharray="7 4" />
          <circle cx={rLastInqX} cy={rLastInqY} r="5" fill="#8B1A1A" />
          <circle cx={rLastCtrX} cy={rLastCtrY} r="5" fill="#555555" />
          <text x={rLabelInqX} y={Number(rLastInqY) + 5} font-family="'Barlow Condensed', sans-serif" font-size="13" font-weight="700" fill="#8B1A1A">87</text>

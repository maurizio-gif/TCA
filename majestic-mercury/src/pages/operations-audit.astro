---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoBand from '../components/PhotoBand.astro';

// ── Raw interview transcripts (Italian), imported as text ──
import edoardo from '../data/transcripts/edoardo.txt?raw';
import matteo from '../data/transcripts/matteo.txt?raw';
import paoloAgnelli from '../data/transcripts/paolo-agnelli.txt?raw';
import francesca from '../data/transcripts/francesca.txt?raw';
import beatrice from '../data/transcripts/beatrice.txt?raw';
import rossana from '../data/transcripts/rossana.txt?raw';
import valerioCaimi from '../data/transcripts/valerio-caimi.txt?raw';

// ── Systems currently in play across the club ──
const systems = [
  'Perfect Gym', 'Playtomic', 'Stripe', 'GoCardless', 'Excel / SharePoint',
  'Google Drive', 'Outlook', 'Coda', 'Tilby', 'DKLink / Datev', 'JotForm',
  'n8n', 'WhatsApp', 'Paper notebooks',
];

// ── Interviewees ──
const people = [
  ['Edoardo', 'Sport Manager', 'Fitness, personal training, sports events, tennis operations & coach supervision'],
  ['Matteo', 'Head of Competitive Tennis', 'Agonistica: 79 athletes — acquisition, contracts, season planning and pricing'],
  ['Paolo Agnelli', 'Head of Tennis School · SAT', 'On-court organisation of 460+ children: groups, levels, tryouts and progression'],
  ['Francesca', 'Senior Sales Advisor', 'Memberships, lead handling and conversion — the club\'s historical memory since 2010'],
  ['Beatrice', 'Sales Advisor', 'Memberships and front-line lead handling — calls, walk-ins and the daily lead / event list; joined Aug 2025'],
  ['Rossana', 'Reception Supervisor', 'Front desk, customer journey, sales support, schools'],
  ['Valerio Caimi', 'Membership Administrator', 'Payments, contracts, billing, debt collection, accounting'],
];

// ── Transcripts keyed by interviewee name (click a card to open it in a modal) ──
const transcripts = {
  'Edoardo': edoardo,
  'Matteo': matteo,
  'Paolo Agnelli': paoloAgnelli,
  'Francesca': francesca,
  'Beatrice': beatrice,
  'Rossana': rossana,
  'Valerio Caimi': valerioCaimi,
};
const txSlug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// ── Team profiles & change-readiness (working-style read drawn from the interviews; ──
// ── constructive and interpretive, not a formal evaluation). readiness = 1-10. ──
const profiles = [
  {
    name: 'Edoardo', role: 'Sport Manager', tag: 'The strategic operator', readiness: 8,
    read: 'Oversees fitness, personal training, events and tennis operations, and supervises the coaches. Thinks in margins, control and process, and frames the work as a shift from top-down to bottom-up. Pragmatic and managerial — keen to fix what is measurable, wary of over-engineering low-margin activities.',
    s: ['End-to-end operational view across fitness and tennis', 'Cost / margin discipline; spots control gaps (gameable lessons)', 'Calm, structured; standardises communication'],
    w: ['Stretched across many domains — attention diluted', 'Supervises tennis rather than controlling it: little leverage there', 'Inclined to under-invest where margin looks thin'],
    o: ['Natural owner of the tennis-lessons redesign', 'Can fold coach booking + payment into one system', 'Can drive the bottom-up process across silos'],
    t: ['Reliance on external coaches he cannot fully police (cash-work blind spots)', 'Competing rebuilds (pool, fitness) crowd out execution'],
    alice: {
      costYear: 49938, netMonth: 1750, atRisk: true,
      hard: ['Course KPI analysis', 'Sports & freelance contract management', 'Activity scheduling'],
      soft: [],
    },
  },
  {
    name: 'Matteo', role: 'Head of Competitive Tennis', tag: 'The reform-minded builder', readiness: 9,
    read: 'Runs the 79-athlete competitive squad and already wants the change: a web-form-to-CRM funnel, signed digital contracts, online enrollment. Calls the no-contract gap his own "Achilles heel." Proactive, data-comfortable and strongly relationship-driven with families.',
    s: ['Clear vision of the target system; at ease with CRM and online enrollment', 'Structured season and pricing planning', 'Strong, trusted relationships with athlete families'],
    w: ['Heavy reliance on one-to-one rapport — hard to scale or hand over', 'Time-poor; external acquisition lives in his phone and head', 'No signed contracts today (his own stated weak point)'],
    o: ['Champion for the agonistica web-form + shared CRM', 'Can model installments and pre-enrollment cleanly', 'Can pull the tennis school toward the same method'],
    t: ['Key-person risk — the process lives with him', 'Reverts to manual if tooling lags', 'Over-customising for his niche'],
  },
  {
    name: 'Paolo Agnelli', role: 'Head of Tennis School (SAT)', tag: 'The hands-on traditionalist', readiness: 5,
    read: 'Runs 460+ children on a paper notebook and six A3 sheets. Deeply practical and court-first, he values the in-person tryout and the parent negotiation. Open in principle and not resistant, but anchored to the manual, relationship-led method — change has to be gradual.',
    s: ['Unmatched on-court judgement and group-building', 'Deep tacit knowledge; trusted by families', 'Honest that the current method does not scale'],
    w: ['Paper-bound, no digital trail', 'The disconnected tryout-enroll-pay chain lives in his workflow', 'Skeptical of "utopian" detailed systems; single point of failure'],
    o: ['Move level-assignment into Perfect Gym as the enrollment gate', 'Offload the repetitive relationship-admin he is saturated by', 'Publish the level ladder so families self-qualify'],
    t: ['Hardest migration on the team', 'Capacity / over-booking risk if pre-enrollment scales', 'Resistance if change feels imposed or too fast'],
  },
  {
    name: 'Francesca', role: 'Senior Sales Advisor', tag: 'The institutional memory', readiness: 7,
    read: 'At the club since 2010, transformed from reception lead into sales. Sharp, candid and deeply versed in membership and the customer journey. Advocates simplification and a real CRM, but holds strong, experience-based opinions and defends the edge cases.',
    s: ['Historical context and pattern recognition', 'Articulate diagnosis: lead routing, opaque tiers, CRM gaps', 'Strong customer-relationship and closing skill'],
    w: ['Fifteen years of habits; personal, manual follow-up', 'Defends nuance in ways that can slow standardisation', 'Tool-skeptical of Perfect Gym'],
    o: ['Shape the new CRM and the simplified price list', 'Lead the Gold / Platinum tier rationalisation', 'Turn her tacit playbook into trackable process'],
    t: ['Change fatigue; reverts to personal methods under load', 'Thin team (down to two) limits bandwidth'],
    alice: {
      costYear: 46952, netMonth: 2000, atRisk: true,
      hard: ['Closing sales', 'Lead handling & generation', 'Follow-up', 'Perfect Gym CRM', 'Playtomic'],
      soft: ['Storytelling & club history', 'Building member connection'],
    },
  },
  {
    name: 'Beatrice', role: 'Sales Advisor', tag: 'The adaptable newcomer', readiness: 8,
    read: 'Joined in August 2025. Runs an organised morning lead / event routine and is candid about manual gaps and the limits of a personal WhatsApp. An enthusiast for the pull / setting model, with little historical baggage and quick to adopt better tooling.',
    s: ['Process-minded; honest about her own misses', 'Embraces the pull / setting funnel model', 'Fast learner, low historical baggage'],
    w: ['Junior, less institutional context', 'Uses a personal consumer WhatsApp; manual status updates', 'Role partly in flux'],
    o: ['Power-user of the new CRM and trial / referral funnel', 'Owns the FAQ / fast-answers content', 'Helps measure requested - activated - converted'],
    t: ['Role ambiguity while the team is in flux', 'Without tooling she inherits the same manual load'],
    alice: {
      costYear: 30739, netMonth: 1250, atRisk: false,
      hard: ['Closing sales', 'Lead handling & generation', 'Follow-up', 'Perfect Gym CRM', 'Playtomic', 'Canva'],
      soft: ['Team work', 'Proactive member care', 'Event & clubbing promotion', 'Communication'],
    },
  },
  {
    name: 'Rossana', role: 'Reception Supervisor', tag: 'The pragmatic gatekeeper', readiness: 7,
    read: 'Rose from reception, did sales 50/50, now 99% reception supervisor. Sees the silos clearly and backs the digital-filter idea. Practical, supportive and acutely aware of the front-desk workload.',
    s: ['Front-desk reality check; cross-trained in reception and sales', 'Understands the filter-to-sales handoff', 'Backs self-serve, landing pages and a digital filter'],
    w: ['Thin reception coverage — short shifts, "not inside the club"', 'In practice passes everyone through to sales', 'Bound by manual back-office checks'],
    o: ['Run the digital "setting" filter at the desk', 'Clean lead capture via QR into the CRM', 'Cut manual reconciliation'],
    t: ['10-11 part-timers give inconsistent information', 'Manual checks pile up if tooling slips'],
    alice: {
      costYear: 38235, netMonth: 1700, atRisk: false,
      hard: ['Reception-team training & management', 'Front-desk coordination', 'Quality control & procedure definition (brand standard)', 'Feedback & complaint handling', 'Welcome-process optimisation', 'Operational event support', 'Sports software · Office · graphics'],
      soft: ['Problem solving', 'Communication', 'Team work'],
    },
  },
  {
    name: 'Valerio Caimi', role: 'Membership Administrator', tag: 'The systems-minded administrator', readiness: 9,
    read: 'Arrived at the interview with a written duties breakdown and a list of critical points. Deeply fluent in Perfect Gym, payments, dunning and contracts, and visibly solution-oriented and precise. The most automation-hungry of the team.',
    s: ['Exceptional process documentation and ownership', 'Already diagnosed every pain: Stripe, recurring %, suspensions, custom due-dates', 'Real technical depth in the tooling'],
    w: ['Time-poor: manual revenue keying (a full Spani week)', 'Carries many one-off exceptions himself', 'Risk of being the sole keeper of the logic'],
    o: ['Lead the payments / recurring overhaul and suspension rebuild', 'Revenue automation + BI dashboard; retire Coda / Spani', 'Saved methods + automated dunning'],
    t: ['Overload and key-person risk', 'Blocked by IT (refund permission stuck for months)', 'Fiscalisation risk from manual payment edits'],
    alice: {
      costYear: 36320, netMonth: 1650, atRisk: false,
      hard: ['Membership-contract management', 'Sports software · Office / Excel', 'Club rules, privacy & H&S', 'Payments & renewals', 'Commercial terms', 'Cancellation & membership-change procedures'],
      soft: ['Reception / admin support', 'Club-procedure knowledge'],
    },
  },
];
const rdBand = (n) => (n >= 8 ? 'high' : n >= 6 ? 'mid' : 'low');
// ── Money formatter for the Club Manager's cost figures (whole euros) ──
const eur0 = (n) => '€' + Math.round(n).toLocaleString('en-US');

// ── Cross-cutting themes ──
const themes = [
  ['01', 'No Single Source of Truth', 'Perfect Gym, Playtomic, dozens of Excel files on SharePoint, Outlook, Coda, Tilby and WhatsApp groups all hold a slice of the truth. Nothing reconciles across them, and "we lose pieces" was said in every interview.'],
  ['02', 'Manual by Default', 'Payments keyed in by hand, debt-collection pauses set one by one, Excel updated manually, reminders sent over WhatsApp. Slow, repetitive, and a high probability of human error.'],
  ['03', 'Nothing Is Measured', 'Trials given vs. converted, lessons sold vs. members won, requests received vs. handled: there is almost no usable data today to steer decisions.'],
  ['04', 'Staff Are the Pivot, Not the Safety Net', 'Reception and sales carry the entire journey on their shoulders. They should support a self-serve flow, not be the bottleneck the whole club depends on.'],
  ['05', 'Payments Not Anchored to Contracts', 'Only ~32% of payments recur; the rest are chased by hand. This single gap drives most of the back-office load and most of the fiscal risk.'],
  ['06', 'Built Around Habits, Not the Tool', 'Enrollment flows ignore what Perfect Gym already allows, then get patched on top. Simplify the offer first, layer technology second, and build a model that is replicable, not a bespoke suit.'],
];

// ── Findings by operational area ──
// finding = [current state, impact ('High'|'Med'|'Low'), recommended direction]
const areas = [
  {
    num: '01',
    title: 'Payments & Billing',
    owner: 'Valerio',
    lead: 'The foundation of everything else. Today the mix is wrong, failures are caught late, and there is no automatic consequence for a failed payment.',
    findings: [
      ['Stripe ("Stral") underperforms; direct debits are run once a month on the first working day, so results only land around the 10th-15th. No automatic block on a failed payment.', 'High', 'Fix Stripe now. Run debits at least daily, with staged retries that exclude known-failed cards. Block booking and turnstile access on failure.'],
      ['Only 31.9% of payments are recurring (Stripe + GoCardless). Roughly 50% of POS revenue is bank transfer; cash is small but still present.', 'High', 'Invert the mix toward recurring. Require a saved payment method on every contract, minimise bank transfers and phase out cash.'],
      ['Combined contracts (monthly membership + adult course, or child + summer camp) break the debit, which is generated as a single total.', 'Med', 'Per-contract debit logic, so each agreement is charged on its own schedule independently.'],
      ['Dunning emails often land in spam; the "save a new payment method" link does not work; the email download is insufficient.', 'Med', 'DNS / DKIM authentication (SendGrid / AWS) for deliverability. Reason-based recovery emails (insufficient funds vs. revoked mandate), in-app alerts, and an auto-generated link to save a new method.'],
      ['1-click refunds on Perfect Gym are possible but have been blocked by IT support for months; they require a saved payment method.', 'Med', 'Unblock the refund permission. Once methods are saved, refunds become a single click.'],
    ],
  },
  {
    num: '02',
    title: 'Membership Lifecycle',
    owner: 'Valerio / Francesca',
    lead: 'Flex memberships, suspensions, renewals and leavers all generate manual work because the contract structure fights the software instead of using it — and the tier ladder itself no longer holds together.',
    findings: [
      ['Flex is sold to the member as "3 + 1 + 1" but built internally as "3 + 3". The member sees a 3+3 expiry in the app and is confused; each renewal creates a new contract to track.', 'High', 'A 3-month minimum commitment, then a single non-expiring subscription the member cancels with one button. One contract sold, full stop.'],
      ['Suspensions break Perfect Gym - they add a second contract, extend the duration and double the cost; fixed by hand with free months and note-blocks.', 'High', 'Rebuild and test the suspension models per membership. Let members self-serve suspension, and consider a suspension service fee to discourage casual use.'],
      ['Annual renewal emails need manual template upkeep and date edits, and frequently land in spam.', 'Med', 'Automate via n8n, add an in-app renewal alert, and keep a clean downloadable record.'],
      ['Leavers - cancellation reasons are captured by manual sales calls. The qualitative feedback is valuable but inconsistent.', 'Med', 'Self-service cancellation in the app with a mandatory reason and note. Keep one human touchpoint for save attempts; feed structured data into strategy.'],
      ['Debt collection is the only lever to find a debtor today, precisely because payment methods are not saved. Main pains: unwanted auto-renewal, and members withholding payment over real club issues.', 'High', 'Saved methods + automated reason-based dunning + 1-click call / payment request remove most of the manual burden.'],
      ['The Gold tier barely works in winter — a 7-day booking window against Platinum\'s 10 — driving a wave of Gold→Platinum upgrades, yet Platinum is congested too. Platinum runs ~€100/mo against Gold\'s ~€55 (nearly double) but does not pay for courts, and nobody has measured whether Platinum court usage justifies it — Playtomic cannot filter bookings by tier.', 'Med', 'Rationalise the tiers (cap or retire the weakest) and simplify the list to "what do I pay / what can I do". Measure Platinum court usage first (a Playtomic export crossed with the member list), then add a court-quota model: a flat booking allowance, then pay-per-use beyond it, so the last slice of court capacity carries a rising cost.'],
      ['Upgrades are allowed anytime, downgrades only at renewal — all by hand — and even staff find the upfront single-payment maths (12 vs 13 months, the free month) unclear.', 'Low', 'Codify upgrade / downgrade and the upfront-vs-installment calculation in the system, so it is unambiguous and, where possible, self-serve.'],
    ],
  },
  {
    num: '03',
    title: 'Courses & Schools — SAT & Agonistica',
    owner: 'Matteo / Paolo Agnelli / Valerio',
    lead: 'The tennis school (464 children this year) and the competitive squad (79 athletes) are the club\'s operational heart — and they run on paper notebooks, Excel and WhatsApp. Both heads named the same root cause: tryout, enrollment and payment are three disconnected steps, so children are placed before they enrol, slots are held for families who never confirm, and reminders fire on the wrong dates.',
    findings: [
      ['The three core steps — tryout (level assignment), online enrollment and payment — are disconnected, and nothing is signed: a child is placed in a group before enrolling, no record confirms the tryout happened, payment arrives "whenever I remember", and the agreement is just a paper sheet with a day preference. The competitive head calls it his "Achilles heel"; across 460+ families it is a liability and the root of the reconciliation load.', 'High', 'One enabling chain: the tryout result unlocks a signed digital contract, the contract requires a saved payment method, and the held slot is auto-flagged "paid" — stored in the member\'s area, with the coach setting the level from his phone and neither sales nor admin re-keying anything.'],
      ['Enrollment is entirely Excel- and JotForm-driven across multiple SharePoint files; JotForm submissions are keyed into Perfect Gym by hand, then into Excel.', 'High', 'Online enrollment straight into a Perfect Gym account (no JotForm), with the contract and automation created on purchase.'],
      ['A debt-collection pause must be set by hand for each enrollee, because Perfect Gym dunning follows the contract-entry date, not the agreed due date — so wrong reminders go out and families complain. Entering 114 names took ~3 hours.', 'High', 'A custom due-date scheme in Perfect Gym (deposit now, installments later, auto-debited) removes the manual pause entirely.'],
      ['Pre-enrollment ("prescrizione", €300) gives returning families pre-emption but guarantees no real slot — and capacity is per-course and per-day, not a single cap ("we don\'t have a counter at 460"). With more site traffic next season, the club risks taking pre-enrollments it cannot honour.', 'Med', 'Define real per-slot capacity in the system; route every enrollment through tennis-ops assignment, or expose live slot availability; make the assigned level the gate.'],
      ['Levels are tracked by hand — a notebook and six A3 sheets, re-keyed nowhere. The federation ladder (red → orange → super-orange → green → super-green → yellow → agonistica) maps cleanly onto ball, court size and racket.', 'Med', 'Hold the level in Perfect Gym as the enrollment filter: a group is bookable only at its level, and the coach updates it through the season. Publish the ladder on the site so families self-qualify.'],
      ['Agonistica is a 46-week winter + 10-week summer package (€2,700 for 2× a week up to €5,200 for 5×), paid as a ~€500 deposit then two installments (October, January). The athlete must never be entered as "in debt" — it breaks turnstile access and triggers the wrong reminders.', 'Med', 'Model the installment schedule so access is granted and reminders fire on the agreed dates; offer an upfront-discount vs. installment choice at enrollment.'],
      ['Agonistica acquisition is informal: ~10 school children are promoted each year through coach-led tryouts, while externals reach the head coach via a phone number passed around — and every external must be seen on court. Nothing records who enquired versus who converted.', 'Med', 'A website form routed straight to the head coach, feeding a shared CRM that tracks enquiry → tryout → convert and routes "wrong level" cases back to the school.'],
    ],
    note: 'Summer camp is a separate, low-margin "feeder" activity — week-to-week, with numbers unknown until the Monday morning — and should be modelled apart from the nine-month seasonal courses, where the real revenue and the real complexity sit.',
  },
  {
    num: '04',
    title: 'Tennis Lessons & Courts',
    owner: 'Edoardo / Rossana',
    lead: 'The single biggest prize. ~€217k/year in tennis lessons (confirmed again in the second Sport-Manager interview) and ~70% of all enquiries, yet the whole flow runs on manual notes, a WhatsApp group and a second booking system that does not talk to Perfect Gym.',
    findings: [
      ['First 3 lessons are free for externals, tracked via manual notes in PG. Lead becomes guest, is assigned to a coach via a WhatsApp group, and the coach self-picks - many handovers fail.', 'High', 'Make the trial a purchasable product (a short membership containing one lesson, capped e.g. at 3 in 30 days) so the sales opportunity has a deadline; or issue a voucher / code.'],
      ['A shared WhatsApp group assigns lessons, with one person guessing which coach is freest.', 'Med', 'A shared interface where coaches keep their own availability and self-assign, with full traceability - replacing the WhatsApp group.'],
      ['Lesson control is manual and gameable: coaches submit an Excel of hours that is cross-checked by hand against Playtomic. A lesson can be hidden (not marked in the booking) or two coaches booked on one slot — catching cash-work would need someone physically walking the courts.', 'High', 'Let coaches book the lesson themselves in one system — a Perfect Gym backend account — so the lesson, the court and the payment become a single record: no Excel cross-check, no blind spot, and lesson payment solved at the same time.'],
      ['Court prep and lesson are booked separately, and members game the gap: book a court alone, then — two days out, with no partner — "come give me a lesson", slotting the coach in. Coach booking priority and member priority collide.', 'Med', 'Two clean lines: book a court to play, or book a coach for a lesson (the coach does the court prep contextually). One path each — no hybrid, and no lesson sold just to rescue an empty court.'],
      ['Courts live on Playtomic (3-day window for externals), lessons on the coach: two systems, two payments. Playtomic does not talk to Perfect Gym; member tiers, packages and prices are maintained by hand.', 'High', 'Evaluate consolidating courts + lessons onto Perfect Gym: book court, then book lesson; price by membership tier; packages auto-decrement at booking; "my products" shows the residual. Externals book courts via an embedded PG calendar.'],
      ['Lessons are paid at the desk before play; a member who passes the turnstile without paying is charged via cashless debit.', 'Med', 'Connect Stripe for online lesson payment, with auto-receipts and automatic payout / collection reports for coaches.'],
    ],
    note: 'Scaling is limited by court / slot availability and by the coach being central to every lesson. This redesign needs a single named owner and a cleaned-up price list before build.',
  },
  {
    num: '05',
    title: 'Fitness & Personal Training',
    owner: 'Edoardo',
    lead: 'Personal trainers are external partners who keep the weights room viable. The opportunity is visibility and a clean free-induction flow - without over-engineering an external relationship.',
    findings: [
      ['PTs are external partners (4 today, ~6 wanted). They keep their own agenda, take cash directly, and pay the club a monthly fee (€300-400) with or without free course hours.', 'Med', 'Keep PTs external and the model simple - do not over-engineer it. The bigger operational prize is tennis lessons.'],
      ['PT visibility is poor: corridor photos, the in-club TV, and a static website section with no working call-to-action.', 'Med', 'A public PT page on the website: one contact form per trainer, tracked requests, and an easy way to add a new trainer (photo + description). Sales can share the link directly.'],
      ['The free "gym induction" (45-60 min trial) is mediated: reception/sales to Edoardo to turn-based assignment to the PT. Many handovers, no feedback loop, no guarantee the free session is used only once.', 'High', 'A "Gym Induction" product in Perfect Gym with a residual-availability calendar (member books only when the PT has no PT session); first one free, capped to one via membership. Alternative: a voucher / code the PT "burns" via a simple interface, with live stats on codes generated vs. used.'],
      ['PT underpins the weights room - members cannot really train unassisted on the current equipment.', 'Low', 'Treat PT as a strategic differentiator and give it real space on the new site.'],
    ],
  },
  {
    num: '06',
    title: 'Reception, Customer Journey & Sales',
    owner: 'Rossana / Francesca / Beatrice',
    lead: 'Online sign-up barely works and the journey is fully dependent on whoever is at the desk. The fix is to digitise the filter, give sales a CRM they will actually use, and let them act fast only when it matters.',
    findings: [
      ['Online sign-up is nearly non-functional; mostly old members re-subscribe. The price brochure is the only material and is not immediately readable.', 'High', 'Clean up and redesign the offer, put the essentials on the website, and test the layout on non-experts before launch.'],
      ['Lead routing is opaque: website inquiries land in personal Perfect Gym mailboxes under cryptic labels (TCA Guest, Digital Team, Existing Contact); a contact already in the system is invisible unless it hits the right inbox; the shared "Sales Team" box goes unread. Leads arrive unqualified, so sales burns time qualifying.', 'High', 'Route by activity-of-interest from the site form, dedupe by email against Perfect Gym, and deliver a pre-qualified lead — reason, activity, call-back window — into a single aliased inbox.'],
      ['Reception (10-11 people on 4-5h shifts) is meant to filter then pass to sales, but effectively passes everyone - so sales becomes the pivot and the bottleneck.', 'High', 'Reception runs a digital "setting" (the filter); sales acts fast only when the opportunity is real; routine comms go automatic.'],
      ['Perfect Gym is rejected as a CRM ("macchinoso"): follow-up is entirely personal and untracked, the email-send module was set up years ago but never switched on, and the old "opportunities" were truncated or simply vanished.', 'High', 'A purpose-built CRM that logs every task (type, interest, reason-not-joined, outcome) and syncs actions back to Perfect Gym — opportunity-based, with a fixed evaluation window, zone-based handling so an inquiry is always answered, and the few metrics that matter (inquiries in, time-to-first-contact, conversion) pushed to a BI view.'],
      ['Sales reach leads from a personal, consumer WhatsApp number — the fastest channel (many never answer unknown calls), but untraceable, off the record and not a professional tool.', 'Med', 'A professional WhatsApp Business channel with approved templates, reserved for revenue-driving moments (lead acquisition and qualification) and logged against the lead in the CRM; email stays the official channel for formal notices.'],
      ['Trials are booked in the salesperson\'s own name (a lead cannot book) with no tracing of requested → activated → converted, so nobody knows what a trial actually produces. Referrals have no flow at all.', 'Med', 'A purchasable trial (a short membership or promo code, activate-once, with a member-identical booking experience) and a referral flow (member invites a friend; €50 credit on conversion) — both feeding a measurable funnel.'],
      ['Promo codes exist but are not visible online; sales must hand them over. A banner hooks the member, but with no code to complete the purchase the funnel breaks and creates extra work afterwards.', 'Med', 'Make promotions self-serve via a landing page with the code applied, plus trackable links sales can send.'],
      ['Work is compartmentalised (marketing / sales / operations) while the customer journey is transversal.', 'Med', 'Design around the journey: lead capture via QR into the CRM, automated follow-up, and a back-office pass that picks up non-converters.'],
    ],
  },
  {
    num: '07',
    title: 'Revenue Registration, Accounting & Reporting',
    owner: 'Valerio / Alice',
    lead: 'Revenue is re-keyed from Perfect Gym into a separate tool one movement at a time. It is the longest, most error-prone task in the back office - and a fiscal risk.',
    findings: [
      ['Revenue is registered from Perfect Gym into Coda manually, one movement at a time - very long and error-prone. Spani consumes a full week.', 'High', 'Drop Coda / Spani for this. An automated revenue feed from what is sold, plus a BI dashboard for management control.'],
      ['~50% of POS is bank transfer and payments are keyed in by hand, so reconciliation and cash-up are heavy and done after the fact.', 'Med', 'Verify the payment method at contract time (not whether the member paid). Push a daily revenue report to a cloud database connected to reporting.'],
      ['Disordered payment handling is a fiscalization risk: receipts are issued immediately, and manual add / remove / change causes problems downstream.', 'High', 'Cleaning up payments (Area 01) directly de-risks fiscalization.'],
      ['Invoicing is brand new (started 15/06/26, DKLink / Datev); volumes are low (welfare ~7-8/year, PTs monthly, some parents tax receipts already semi-automated in PG).', 'Low', 'Keep invoicing lean. The parent tax receipt is already a 1-click detail in PG.'],
    ],
  },
];

// ── App & member self-service suggestions ──
const appIdeas = [
  ['Book PT & tennis lessons', 'Let members request and book personal training and tennis lessons directly in the app.'],
  ['Training card', 'A workout plan in the app - paid here (free in models such as Club 2D).'],
  ['Self-service auto-renewal off', 'Deactivate tacit renewal in-app, with a mandatory reason and note - this alone would clear a large chunk of admin work.'],
  ['Medical certificate gate', 'Turnstile block on an expired medical certificate (now active): an add-on membership auto-populates the dates, the member sees the expiry in their area, and an email goes out before it lapses.'],
  ['FIT card gate', 'Same mechanism for the FIT federation card: auto-affiliation to the promotion body via FIT + PIN, storing the card code.'],
  ['Lesson rating', 'A 1-5 star rating on the lesson just taken - being enabled.'],
  ['Competitive-athlete document area', 'Each agonista\'s contract, technical and competitive sheets and receipts in their member area - replacing the hand-built Google Drive folders - with a visible level-progression bar that keeps parents engaged.'],
  ['Pre-enrollment with pre-emption', 'Open next season\'s courses early in-app, with returning-member pre-emption: families confirm and pay before externals, so groups are built on certainty, not guesswork.'],
  ['Self-enroll by level', 'Families self-enroll into a course filtered by the level the coach assigned - higher levels locked, lower ones visible - paying and signing in a single flow.'],
];

// ── Administration: task & tooling inventory (from Valerio's mansionario) ──
const tasks = [
  ['Run DD / CC', 'Issue direct debits via PG; from mid-month, check failures and start credit recovery.', 'PG, Excel', 'Prepaid cards fail often; results only certain by the 10th-15th; crashes on double contracts (e.g. membership + adult course, or child + summer camp).'],
  ['Renewed memberships', 'Check the month renewals and start credit recovery.', 'PG, Excel', ''],
  ['Debtors', 'Check debtors and recover credit.', 'PG, Excel', ''],
  ['Member management', 'Suspensions, interruptions, transfers and similar.', 'PG, Outlook', 'Inserting a suspension almost always errors the contract; worked around with free months + a note-block.'],
  ['Renewal emails', 'Update / prepare / check renewal emails; manage and physically deactivate in PG.', 'PG, Outlook', 'Often land in spam; an in-app alert would help; the email download is insufficient.'],
  ['Leavers', 'Manage leavers and capture the reason for disabling auto-renewal; weekly reports for management and for sales.', 'PG, Outlook, Excel', 'Self-service deactivation in the app (mandatory reason + note) would greatly cut this work.'],
  ['Bank transfers', 'Receive from Laura and register; update payer status across many Excel files (debtors, failed DD/CC, SAT, Summer Camp, Adult Course, Agonistica).', 'Excel, PG', ''],
  ['Cash register & day-book', 'Daily reception cash check; record into the day-book; manage the petty-cash safe; weekly bank deposits.', 'PG, various, Excel, Outlook', ''],
  ['Pending sales', 'Check contracts and the points needed to complete sales; weekly report to colleagues.', 'PG, Excel, Outlook', ''],
  ['Reception & sales support', 'Fix PG issues, correct contracts, cancel / correct takings, repair colleagues Excel edits, resolve cash discrepancies.', 'PG, Excel, various', ''],
  ['Courses macro-area', 'SAT, Agonistica, Summer Camp, winter and summer adult courses: create / maintain Excel, check takings, set per-enrollee debt-collection pause.', 'PG, Excel', 'Manual entry; online enrollment would be ideal (today JotForm, then manual contract + Excel); turnstile access for agonisti broken; PG sends wrong reminders because they follow the entry date.'],
  ['Refunds', 'Manage refunds, with Excel to track them.', 'PG, Excel', 'Could be handled in PG - waiting on IT support to enable it.'],
  ['Welfare', 'Requests, portal entry, invoicing.', 'PG, Excel, various', ''],
  ['Stationery purchases', 'Manage orders and entry.', 'Coda, Excel, Outlook', ''],
  ['Revenue registration', 'Register revenue from PG into Coda, one by one; soon also the Tilby fiscal cash.', 'Excel, Coda, Tilby', 'Very long and time-consuming; high probability of human error given the volume and repetition.'],
  ['Invoicing', 'Create and manage invoices (started 15/06/26).', 'DKLink, Datev, Excel, Outlook', 'Brand new, not yet running smoothly.'],
  ['Private appointments calendar', 'Manage the private appointment calendar.', 'Outlook', ''],
];

const impactClass = { High: 'high', Med: 'med', Low: 'low' };
---

<BaseLayout
  title="TCA · Operations Audit"
  description="Operations audit of Tennis Club Ambrosiano based on staff interviews: findings, friction and opportunities across payments, memberships, courses, tennis, fitness, reception and reporting."
  initialHeaderDark={true}
  noindex={true}
>

  <main class="au-page">

    <!-- ── HEADER ── -->
    <div class="au-header">
      <span class="eyebrow eyebrow--grey">Discovery · Staff Interviews</span>
      <h1 class="au-title">
        Operations Audit &mdash; <em>findings &amp; opportunities</em>
      </h1>
      <p class="au-intro">
        A first read of how the club actually runs day to day, built from recorded interviews with the
        operational team. The goal, in the owner's framing, is to surface <strong>opportunities, not problems</strong>:
        to give each friction point a dimension and pair it with a concrete direction. This is a
        <strong>living document</strong> &mdash; more interviews will be added as they happen.
      </p>
      <span class="au-status">&#9679;&nbsp; Living document &middot; updated as interviews are added</span>

      <div class="au-systems">
        <span class="au-systems__label">Systems in play today</span>
        <div class="au-chips">
          {systems.map((s) => <span class="au-chip">{s}</span>)}
        </div>
      </div>
    </div>

    <PhotoBand img="club-aerial.jpeg" eyebrow="The Real Engine Room" line="Mapping how the club really runs — before rebuilding it." />

    <!-- ── INTERVIEWS ── -->
    <h2 class="au-section-title">01 · Interviews <em>So Far</em></h2>
    <div class="people-grid">
      {people.map(([name, role, scope]) => {
        const hasTx = Boolean(transcripts[name]);
        return (
          <div
            class:list={['person-card', { 'person-card--clickable': hasTx }]}
            data-tx-target={hasTx ? txSlug(name) : undefined}
            role={hasTx ? 'button' : undefined}
            tabindex={hasTx ? '0' : undefined}
            aria-haspopup={hasTx ? 'dialog' : undefined}
          >
            <div class="person-name">{name}</div>
            <div class="person-role">{role}</div>
            <p class="person-scope">{scope}</p>
            {hasTx && <span class="person-tx-hint">Read transcript &rarr;</span>}
          </div>
        );
      })}
    </div>
    <p class="au-prose au-prose--muted">Seven interviews in: coverage now spans the tennis school, the competitive squad and sales, alongside administration and reception. Click any name to read that interview's full transcript. More statements will be folded in as they arrive.</p>

    <!-- ── TEAM PROFILES & CHANGE READINESS ── -->
    <h2 class="au-section-title">02 · Team Profiles &amp; <em>Change Readiness</em></h2>
    <p class="au-prose">
      A constructive, first-pass read of each interviewee's <strong>professional role, working style and disposition</strong>,
      with a four-quadrant <strong>SWOT</strong> and a <strong>change-readiness</strong> score from 1 to 10. The read and SWOT are
      drawn from what people said and do in the interviews; each card also folds in the <strong>Club Manager's own file</strong> —
      the annual cost to the club, monthly net pay, the hard and soft skills Alice maps to the role, and an <strong>at-risk</strong>
      flag where she raised one (shown only for the salaried staff that file covers). It is an interpretive aid for sequencing the
      change and pairing the right person with the right step, <em>not</em> a formal performance evaluation. Strictly confidential.
    </p>

    <div class="table-wrap">
      <table class="au-table prof-table">
        <thead>
          <tr>
            <th style="width:15%">Person</th>
            <th style="width:21%">Role</th>
            <th style="width:22%">Change readiness</th>
            <th style="width:21%">Greatest strength</th>
            <th style="width:21%">Key watch-out</th>
          </tr>
        </thead>
        <tbody>
          {profiles.map((p) => (
            <tr>
              <td class="cell-task">{p.name}</td>
              <td class="cell-tools">{p.role}</td>
              <td>
                <div class="rd">
                  <div class="rd-bar"><span class={`rd-fill rd-fill--${rdBand(p.readiness)}`} style={`width:${p.readiness * 10}%`}></span></div>
                  <span class="rd-num">{p.readiness}<span class="rd-den">/10</span></span>
                </div>
              </td>
              <td class="cell-solution">{p.s[0]}</td>
              <td class="cell-pain">{p.w[0]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prof-grid">
      {profiles.map((p) => (
        <div class="prof-card">
          <div class="prof-head">
            <div class="prof-id">
              <div class="prof-name">{p.name}</div>
              <div class="prof-tag">{p.tag}</div>
            </div>
            <div class={`prof-score prof-score--${rdBand(p.readiness)}`}>
              <span class="prof-score-num">{p.readiness}<span class="prof-score-den">/10</span></span>
              <span class="prof-score-lbl">readiness</span>
            </div>
          </div>
          <p class="prof-read">{p.read}</p>
          {p.alice ? (
            <div class="mgr">
              <div class="mgr-head">
                <span class="mgr-lbl">Manager's read &middot; Alice</span>
                {p.alice.atRisk && <span class="mgr-risk">At risk</span>}
              </div>
              <div class="mgr-cost">
                <div class="mgr-cost-item">
                  <span class="mgr-cost-num">{eur0(p.alice.costYear)}</span>
                  <span class="mgr-cost-lbl">Cost to club / yr</span>
                </div>
                <div class="mgr-cost-item">
                  <span class="mgr-cost-num">{eur0(p.alice.netMonth)}</span>
                  <span class="mgr-cost-lbl">Net / month</span>
                </div>
              </div>
              <div class="mgr-skills">
                <span class="mgr-skills-lbl">Hard skills</span>
                <div class="mgr-chips">{p.alice.hard.map((h) => <span class="mgr-chip mgr-chip--hard">{h}</span>)}</div>
              </div>
              {p.alice.soft.length > 0 && (
                <div class="mgr-skills">
                  <span class="mgr-skills-lbl">Soft skills</span>
                  <div class="mgr-chips">{p.alice.soft.map((s) => <span class="mgr-chip mgr-chip--soft">{s}</span>)}</div>
                </div>
              )}
            </div>
          ) : (
            <p class="mgr-na">Not included in the Club Manager's personnel &amp; cost file.</p>
          )}
          <div class="swot">
            <div class="swot-q swot-s">
              <span class="swot-lbl">Strengths</span>
              <ul>{p.s.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="swot-q swot-w">
              <span class="swot-lbl">Weaknesses</span>
              <ul>{p.w.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="swot-q swot-o">
              <span class="swot-lbl">Opportunities</span>
              <ul>{p.o.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="swot-q swot-t">
              <span class="swot-lbl">Threats</span>
              <ul>{p.t.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- ── CROSS-CUTTING THEMES ── -->
    <h2 class="au-section-title">03 · Cross-Cutting <em>Themes</em></h2>
    <p class="au-prose">
      The same patterns surfaced in every conversation, independent of role. These are the systemic
      causes behind the individual findings below &mdash; fix these, and most of the area-level pain eases on its own.
    </p>
    <div class="theme-grid">
      {themes.map(([num, title, text]) => (
        <div class="theme-card">
          <div class="theme-num">{num}</div>
          <div class="theme-title">{title}</div>
          <p class="theme-text">{text}</p>
        </div>
      ))}
    </div>

    <PhotoBand img="club-players.jpeg" blur={3} eyebrow="One Journey" line="The member's path is transversal — the systems behind it must be too." />

    <!-- ── FINDINGS BY AREA ── -->
    <h2 class="au-section-title">04 · Findings by <em>Area</em></h2>
    <p class="au-prose">
      Each area below lists the current state, an estimated <strong>impact</strong> on time, money and
      member experience, and the recommended direction. Impact is a first-pass judgement to help
      sequencing, not a precise measurement &mdash; the numbers come next.
    </p>

    {areas.map((area) => (
      <section class="area-block">
        <div class="area-head">
          <span class="area-num">{area.num}</span>
          <div>
            <h3 class="area-title">{area.title}</h3>
            <span class="area-owner">Source: {area.owner}</span>
          </div>
        </div>
        <p class="area-lead">{area.lead}</p>
        <div class="table-wrap">
          <table class="au-table">
            <thead>
              <tr>
                <th style="width:42%">Current State</th>
                <th style="width:8%">Impact</th>
                <th style="width:50%">Recommended Direction</th>
              </tr>
            </thead>
            <tbody>
              {area.findings.map(([current, impact, solution]) => (
                <tr>
                  <td class="cell-current">{current}</td>
                  <td><span class={`imp imp--${impactClass[impact]}`}>{impact}</span></td>
                  <td class="cell-solution">{solution}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {area.note && <p class="area-note"><strong>Note &mdash;</strong> {area.note}</p>}
      </section>
    ))}

    <!-- ── ADMIN TASK & TOOLING INVENTORY ── -->
    <h2 class="au-section-title">05 · Administration &mdash; <em>Task &amp; Tooling Inventory</em></h2>
    <p class="au-prose">
      The membership administrator's own breakdown of the recurring back-office workload and the tools
      each task touches. It is the clearest single picture of how much runs on Perfect Gym plus Excel,
      and where the manual effort concentrates.
    </p>
    <div class="table-wrap">
      <table class="au-table">
        <thead>
          <tr>
            <th style="width:20%">Task</th>
            <th style="width:34%">What It Involves</th>
            <th style="width:16%">Tools</th>
            <th style="width:30%">Pain Point</th>
          </tr>
        </thead>
        <tbody>
          {tasks.map(([task, what, tools, pain]) => (
            <tr>
              <td class="cell-task">{task}</td>
              <td class="cell-what">{what}</td>
              <td class="cell-tools">{tools}</td>
              <td class="cell-pain">{pain || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- ── APP & SELF-SERVICE ── -->
    <h2 class="au-section-title">06 · App &amp; Member <em>Self-Service</em></h2>
    <p class="au-prose">
      Forward-looking ideas raised for the member app. Most of these move work off the back office and
      onto a self-serve flow the member actually prefers.
    </p>
    <div class="idea-grid">
      {appIdeas.map(([title, text]) => (
        <div class="idea-card">
          <div class="idea-title">{title}</div>
          <p class="idea-text">{text}</p>
        </div>
      ))}
    </div>

    <!-- ── PRIORITIES ── -->
    <h2 class="au-section-title">07 · Priorities &amp; <em>Sequencing</em></h2>
    <div class="prio-grid">
      <div class="prio-col prio-col--now">
        <div class="prio-head">Quick Wins &middot; Now</div>
        <ul class="prio-list">
          <li>Fix Stripe; run debits daily with staged retries; block booking / access on failure.</li>
          <li>Email deliverability: DNS / DKIM authentication so dunning and renewals stop hitting spam.</li>
          <li>Unblock 1-click refunds in Perfect Gym.</li>
          <li>Enable the lesson rating in the app.</li>
          <li>Ship the PT page with a contact form per trainer on the new site.</li>
          <li>Stand up the lead-routing form (activity-of-interest &rarr; aliased inbox) on the new site.</li>
          <li>Publish the tennis-school level ladder so families self-qualify before they call.</li>
          <li>Build the site "fast answers" / FAQ section (hours, costs, how it works) from sales' own Q&amp;A, so the 15-20 min info calls shrink.</li>
        </ul>
      </div>
      <div class="prio-col prio-col--later">
        <div class="prio-head">Structural &middot; Post-September</div>
        <ul class="prio-list">
          <li>Saved payment method on every contract; redo contracts and enrollment per sector.</li>
          <li>Flex redesign: 3-month commitment, then non-expiring with a self-cancel button.</li>
          <li>Rebuild and test suspension models.</li>
          <li>Tennis-school enrollment chain: the tryout unlocks a signed contract + saved method, the slot auto-flags "paid", and the level lives in Perfect Gym as the filter.</li>
          <li>Courses off Excel: online enrollment + custom due-date schemes; define real per-slot capacity before opening pre-enrollment.</li>
          <li>Rationalise membership tiers and the price list; add a court-quota + pay-per-use model.</li>
          <li>Replace the sales CRM: opportunity-based and zone-handled, with trials, referral and conversion tracking.</li>
          <li>Tennis lessons + courts consolidated onto Perfect Gym, with coaches booking lessons directly (the €217k prize).</li>
          <li>Revenue automation + BI dashboard; retire Coda / Spani.</li>
          <li>Gym-induction product or voucher flow for personal training.</li>
        </ul>
      </div>
    </div>
    <div class="principle">
      <strong>Guiding principle &mdash;</strong> simplify the price list and processes <em>before</em> layering
      technology on top; build a scalable, replicable model rather than a bespoke suit; and assign one
      named owner to the tennis-lessons redesign, where the money and the complexity both concentrate.
    </div>

    <!-- ── NEXT STEPS ── -->
    <h2 class="au-section-title">08 · Immediate Data Requests &amp; <em>Next Steps</em></h2>
    <ol class="steps-list">
      <li><span><strong>Collect every Excel file in use</strong>, plus a legend (file name, purpose, and who has SharePoint access). Needed both for the handover - SharePoint is going away - and for the simplification work.</span></li>
      <li><span><strong>Migrate Excel into Google Sheets</strong> with a shared, agreed logic during the handover, before consolidating into the system.</span></li>
      <li><span><strong>Rationalise email</strong> into a single account with aliases, to replace the scattered Outlook / SharePoint mailboxes.</span></li>
      <li><span><strong>Capture the tennis-school &amp; agonistica records</strong> - the notebook, the six A3 sheets and the course Excels - and define real per-slot capacity, so pre-enrollment can be capped honestly and the level can move into the system.</span></li>
      <li><span><strong>Quantify the friction:</strong> pull the numbers behind each finding - failure rates, time per task, trial-to-member conversion - plus the data the heads can already provide: agonistica retention, SAT renewals (~50-60%) and sales conversion from the guest register.</span></li>
      <li><span><strong>Continue the interviews</strong> and fold new statements into this page as they arrive.</span></li>
    </ol>

    <p class="au-footer">Confidential · Tennis Club Ambrosiano · Audit dates: 22–23 June 2026 · Living document</p>

    <!-- ── INTERVIEW TRANSCRIPT MODAL ── -->
    <div id="tx-modal" class="tx-modal" hidden role="dialog" aria-modal="true" aria-labelledby="tx-modal-name">
      <div class="tx-modal__backdrop" data-tx-close></div>
      <div class="tx-modal__panel">
        <header class="tx-modal__head">
          <div class="tx-modal__heading">
            <span class="tx-modal__eyebrow">Interview transcript</span>
            <span class="tx-modal__name" id="tx-modal-name"></span>
            <span class="tx-modal__role"></span>
          </div>
          <div class="tx-modal__actions">
            <button type="button" class="tx-modal__copy" data-tx-copy>Copy</button>
            <button type="button" class="tx-modal__close" data-tx-close aria-label="Close transcript">&times;</button>
          </div>
        </header>
        <div class="tx-modal__body" tabindex="0"></div>
        <div class="tx-modal__foot">Automated interview transcription · translated to English · condensed for readability</div>
      </div>
    </div>

    <!-- hidden source store: one block per interviewee, copied into the modal on click -->
    <div class="tx-store" hidden>
      {people.filter(([name]) => transcripts[name]).map(([name, role]) => (
        <div id={`tx-src-${txSlug(name)}`} data-name={name} data-role={role}>{transcripts[name]}</div>
      ))}
    </div>

  </main>

  <script>
    (() => {
      const modal = document.getElementById('tx-modal');
      if (!modal) return;
      const nameEl = modal.querySelector('.tx-modal__name');
      const roleEl = modal.querySelector('.tx-modal__role');
      const bodyEl = modal.querySelector('.tx-modal__body');
      const closeBtn = modal.querySelector('.tx-modal__close');
      let lastFocus = null;

      const open = (id) => {
        const src = document.getElementById('tx-src-' + id);
        if (!src) return;
        nameEl.textContent = src.dataset.name || '';
        roleEl.textContent = src.dataset.role || '';
        bodyEl.textContent = src.textContent;
        bodyEl.scrollTop = 0;
        lastFocus = document.activeElement;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        closeBtn.focus();
      };
      const close = () => {
        modal.hidden = true;
        document.body.style.overflow = '';
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      };

      document.querySelectorAll('[data-tx-target]').forEach((card) => {
        card.addEventListener('click', () => open(card.getAttribute('data-tx-target')));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(card.getAttribute('data-tx-target')); }
        });
      });
      modal.querySelectorAll('[data-tx-close]').forEach((el) => el.addEventListener('click', close));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });

      const copyBtn = modal.querySelector('.tx-modal__copy');
      copyBtn.addEventListener('click', async () => {
        const text = bodyEl.textContent || '';
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch (err) {
          // Fallback: select the transcript so the user can Ctrl/Cmd+C
          const range = document.createRange();
          range.selectNodeContents(bodyEl);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          if (ok) sel.removeAllRanges();
        }
        copyBtn.textContent = ok ? 'Copied' : 'Selected — press Ctrl/Cmd+C';
        copyBtn.classList.toggle('is-copied', ok);
        setTimeout(() => { copyBtn.textContent = 'Copy'; copyBtn.classList.remove('is-copied'); }, 1800);
      });
    })();
  </script>

</BaseLayout>

<style>
  :global(body) { background: #fff; }

  .au-page {
    padding: calc(var(--header-h) + 3.5vh) clamp(20px, 5vw, 72px) 6vh;
    max-width: 1500px;
    margin: 0 auto;
  }

  .au-header { display: flex; flex-direction: column; gap: 0.8vh; }

  .au-title {
    font-family: var(--fd);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.0;
    color: var(--text);
  }
  .au-title em {
    color: var(--red);
    font-style: italic;
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0.01em;
  }

  .au-intro {
    font-size: clamp(14px, 1.05vw, 18px);
    font-weight: 300;
    color: #444;
    line-height: 1.7;
    max-width: 78ch;
    margin: 0.5vh 0;
  }
  .au-intro strong { font-weight: 600; color: var(--text); }

  .au-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--text);
    color: #fff;
    font-family: var(--fd);
    font-size: clamp(10px, 0.75vw, 12px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 3px;
    margin-top: 0.5vh;
    width: fit-content;
  }

  /* ── SYSTEMS CHIPS ── */
  .au-systems { margin-top: 2.5vh; }
  .au-systems__label {
    font-family: var(--fd);
    font-size: clamp(9px, 0.65vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey-mid);
    display: block;
    margin-bottom: 10px;
  }
  .au-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .au-chip {
    font-family: var(--fd);
    font-size: clamp(11px, 0.82vw, 14px);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--text-light);
    background: var(--off-white);
    border: 1px solid var(--grey-light);
    border-radius: 100px;
    padding: 5px 14px;
  }

  /* ── SECTION TITLES ── */
  .au-section-title {
    font-family: var(--fd);
    font-size: clamp(1.4rem, 2.2vw, 2.4rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 5.5vh 0 1.2vh;
    color: var(--text);
  }
  .au-section-title em { color: var(--red); font-style: normal; }

  .au-prose {
    font-size: clamp(13px, 0.98vw, 17px);
    font-weight: 300;
    color: #444;
    line-height: 1.7;
    max-width: 88ch;
    margin-bottom: 1.5vh;
  }
  .au-prose strong { font-weight: 600; color: var(--text); }
  .au-prose--muted { color: var(--grey-mid); font-style: italic; font-size: clamp(12px, 0.85vw, 14px); }

  /* ── PEOPLE ── */
  .people-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 1vh 0 1.5vh;
  }
  .person-card {
    border: 1px solid var(--grey-light);
    border-top: 3px solid var(--red);
    background: #fff;
    padding: 20px 18px;
  }
  .person-name {
    font-family: var(--fd);
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .person-role {
    font-family: var(--fd);
    font-size: clamp(10px, 0.78vw, 13px);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    display: block;
    margin-bottom: 10px;
  }
  .person-scope {
    font-size: clamp(12px, 0.9vw, 15px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.55;
  }

  /* ── THEME CARDS ── */
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--grey-light);
    border: 1px solid var(--grey-light);
    margin: 1.5vh 0;
  }
  .theme-card {
    background: #fff;
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.2s;
  }
  .theme-card:hover { background: var(--off-white); }
  .theme-num {
    font-family: var(--fd);
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    font-weight: 800;
    color: var(--red);
    line-height: 1;
  }
  .theme-title {
    font-family: var(--fd);
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.15;
  }
  .theme-text {
    font-size: clamp(12px, 0.9vw, 15px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
  }

  /* ── AREA BLOCKS ── */
  .area-block { margin: 2.5vh 0 1vh; }
  .area-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 0.6vh;
  }
  .area-num {
    font-family: var(--fd);
    font-size: clamp(1.4rem, 2.4vw, 2.4rem);
    font-weight: 800;
    color: var(--red);
    line-height: 1;
  }
  .area-title {
    font-family: var(--fd);
    font-size: clamp(1.2rem, 1.8vw, 1.9rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--text);
  }
  .area-owner {
    font-family: var(--fd);
    font-size: clamp(9px, 0.7vw, 12px);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }
  .area-lead {
    font-size: clamp(13px, 0.95vw, 16px);
    font-weight: 300;
    color: #444;
    line-height: 1.65;
    max-width: 95ch;
    margin: 0.4vh 0 1vh;
  }
  .area-note {
    font-size: clamp(12px, 0.88vw, 15px);
    font-weight: 300;
    color: #555;
    line-height: 1.65;
    max-width: 95ch;
    margin-top: 1vh;
    padding: 12px 16px;
    background: #f8f8f8;
    border-left: 3px solid var(--grey-light);
  }
  .area-note strong { font-weight: 600; color: var(--text); }

  /* ── TABLES ── */
  .table-wrap { overflow-x: auto; margin: 1vh 0 1vh; }
  .au-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 720px;
  }
  .au-table thead tr { background: var(--red); }
  .au-table th {
    font-family: var(--fd);
    font-size: clamp(11px, 0.82vw, 15px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #fff;
    padding: 12px 16px;
    text-align: left;
  }
  .au-table tbody tr {
    border-bottom: 1px solid var(--grey-light);
    transition: background 0.15s;
  }
  .au-table tbody tr:hover { background: #f7f7f7; }
  .au-table td {
    font-size: clamp(12px, 0.9vw, 15px);
    font-weight: 300;
    color: #444;
    padding: 13px 16px;
    vertical-align: top;
    line-height: 1.55;
  }
  .cell-current { color: var(--text); }
  .cell-solution { color: var(--text-light); }
  .cell-task {
    font-family: var(--fd) !important;
    font-size: clamp(13px, 1vw, 16px) !important;
    font-weight: 700 !important;
    color: var(--text) !important;
  }
  .cell-tools { font-size: clamp(11px, 0.82vw, 13px); color: var(--grey-mid); }
  .cell-pain { color: #555; }
  .cell-what { color: var(--text-light); }

  /* ── IMPACT BADGES ── */
  .imp {
    display: inline-block;
    font-family: var(--fd);
    font-size: clamp(10px, 0.75vw, 13px);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .imp--high { background: rgba(139,26,26,0.08); color: var(--red); border: 1px solid rgba(139,26,26,0.28); }
  .imp--med  { background: rgba(180,120,0,0.08); color: #8B6000; border: 1px solid rgba(180,120,0,0.25); }
  .imp--low  { background: rgba(30,107,46,0.08); color: #1E6B2E; border: 1px solid rgba(30,107,46,0.28); }

  /* ── APP IDEAS ── */
  .idea-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 1vh 0;
  }
  .idea-card {
    border: 1px solid var(--grey-light);
    border-left: 3px solid var(--red);
    background: #fff;
    padding: 16px 18px;
  }
  .idea-title {
    font-family: var(--fd);
    font-size: clamp(0.95rem, 1.2vw, 1.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.15;
    margin-bottom: 6px;
  }
  .idea-text {
    font-size: clamp(12px, 0.88vw, 14px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.55;
  }

  /* ── PRIORITIES ── */
  .prio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 1vh 0 1.5vh;
  }
  .prio-col {
    border: 1px solid var(--grey-light);
    background: #fff;
    padding: 0 0 14px;
    overflow: hidden;
  }
  .prio-head {
    font-family: var(--fd);
    font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    padding: 11px 18px;
    margin-bottom: 10px;
  }
  .prio-col--now .prio-head { background: var(--red); }
  .prio-col--later .prio-head { background: var(--text); }
  .prio-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 0 18px;
  }
  .prio-list li {
    position: relative;
    padding-left: 18px;
    font-size: clamp(12px, 0.92vw, 15px);
    font-weight: 300;
    color: #444;
    line-height: 1.55;
  }
  .prio-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--red);
  }
  .prio-col--later .prio-list li::before { background: var(--text); }

  .principle {
    font-size: clamp(13px, 0.95vw, 16px);
    font-weight: 300;
    color: #444;
    line-height: 1.7;
    max-width: 95ch;
    padding: 16px 20px;
    background: rgba(139,26,26,0.03);
    border: 1px solid rgba(139,26,26,0.2);
    border-left: 4px solid var(--red);
    border-radius: 4px;
  }
  .principle strong { font-weight: 600; color: var(--text); }
  .principle em { font-style: italic; color: var(--red); }

  /* ── STEPS ── */
  .steps-list {
    counter-reset: step;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 1.5vh 0;
    max-width: 92ch;
  }
  .steps-list li {
    counter-increment: step;
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-size: clamp(13px, 0.98vw, 16px);
    font-weight: 300;
    color: #444;
    line-height: 1.65;
  }
  .steps-list li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--fd);
    font-size: clamp(1.3rem, 1.9vw, 1.9rem);
    font-weight: 800;
    color: var(--red);
    min-width: 2ch;
  }
  .steps-list li strong { font-weight: 600; color: var(--text); }

  /* ── FOOTER ── */
  .au-footer {
    margin-top: 5vh;
    border-top: 1px solid var(--grey-light);
    padding-top: 2vh;
    font-size: clamp(9px, 0.65vw, 11px);
    color: var(--grey-mid);
    font-family: var(--fd);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── CLICKABLE PERSON CARDS ── */
  .person-card--clickable { cursor: pointer; transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s; }
  .person-card--clickable:hover { border-color: var(--red); box-shadow: 0 8px 24px rgba(0,0,0,0.09); transform: translateY(-2px); }
  .person-card--clickable:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .person-tx-hint {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--fd);
    font-size: clamp(10px, 0.72vw, 12px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
  }

  /* ── TRANSCRIPT MODAL ── */
  .tx-store { display: none; }
  .tx-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(12px, 4vw, 48px);
  }
  .tx-modal[hidden] { display: none; }
  .tx-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15,16,19,0.62);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .tx-modal__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(820px, 100%);
    max-height: min(86vh, 920px);
    background: #fff;
    border-top: 4px solid var(--red);
    border-radius: 6px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.4);
    overflow: hidden;
  }
  .tx-modal__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px clamp(18px, 2.5vw, 32px) 16px;
    border-bottom: 1px solid var(--grey-light);
  }
  .tx-modal__heading { display: flex; flex-direction: column; gap: 3px; }
  .tx-modal__eyebrow {
    font-family: var(--fd);
    font-size: clamp(9px, 0.65vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }
  .tx-modal__name {
    font-family: var(--fd);
    font-size: clamp(1.3rem, 2vw, 1.9rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--text);
  }
  .tx-modal__role {
    font-family: var(--fd);
    font-size: clamp(10px, 0.8vw, 13px);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red);
  }
  .tx-modal__close {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 30px;
    line-height: 1;
    color: var(--grey-mid);
    padding: 0 6px;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .tx-modal__close:hover { color: var(--text); background: rgba(0,0,0,0.05); }
  .tx-modal__body {
    flex: 1;
    overflow-y: auto;
    padding: 18px clamp(18px, 2.5vw, 32px);
    white-space: pre-wrap;
    font-size: clamp(13px, 0.95vw, 15px);
    font-weight: 300;
    line-height: 1.7;
    color: #333;
  }
  .tx-modal__foot {
    padding: 11px clamp(18px, 2.5vw, 32px);
    border-top: 1px solid var(--grey-light);
    font-family: var(--fd);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey-mid);
    background: var(--off-white);
  }
  .tx-modal__actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .tx-modal__copy {
    font-family: var(--fd);
    font-size: clamp(10px, 0.78vw, 13px);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--red);
    background: rgba(139,26,26,0.06);
    border: 1px solid rgba(139,26,26,0.28);
    border-radius: 4px;
    padding: 7px 14px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .tx-modal__copy:hover { background: var(--red); color: #fff; border-color: var(--red); }
  .tx-modal__copy.is-copied { background: #1E6B2E; color: #fff; border-color: #1E6B2E; }

  /* ── READINESS BAR (comparison table) ── */
  .prof-table .cell-tools { color: var(--text-light); font-family: var(--fb); font-size: clamp(12px, 0.9vw, 15px); }
  .rd { display: flex; align-items: center; gap: 10px; }
  .rd-bar { flex: 1; height: 7px; background: var(--grey-light); border-radius: 100px; overflow: hidden; min-width: 70px; }
  .rd-fill { display: block; height: 100%; border-radius: 100px; }
  .rd-fill--high { background: #1E6B2E; }
  .rd-fill--mid  { background: #8B6000; }
  .rd-fill--low  { background: var(--red); }
  .rd-num { font-family: var(--fd); font-weight: 800; font-size: clamp(13px, 1vw, 16px); color: var(--text); white-space: nowrap; }
  .rd-den { font-weight: 600; color: var(--grey-mid); font-size: 0.78em; }

  /* ── PROFILE CARDS ── */
  .prof-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 2vh 0 1vh;
  }
  .prof-card {
    border: 1px solid var(--grey-light);
    border-top: 3px solid var(--red);
    background: #fff;
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
  }
  .prof-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .prof-name {
    font-family: var(--fd);
    font-size: clamp(1.15rem, 1.6vw, 1.6rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .prof-tag {
    font-family: var(--fd);
    font-size: clamp(10px, 0.78vw, 13px);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
    margin-top: 3px;
  }
  .prof-score {
    flex-shrink: 0;
    text-align: center;
    border: 1px solid var(--grey-light);
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 74px;
  }
  .prof-score--high { background: rgba(30,107,46,0.08); border-color: rgba(30,107,46,0.3); }
  .prof-score--mid  { background: rgba(180,120,0,0.08); border-color: rgba(180,120,0,0.28); }
  .prof-score--low  { background: rgba(139,26,26,0.07); border-color: rgba(139,26,26,0.28); }
  .prof-score-num { display: block; font-family: var(--fd); font-weight: 800; font-size: clamp(1.5rem, 2.2vw, 2.1rem); line-height: 1; color: var(--text); }
  .prof-score--high .prof-score-num { color: #1E6B2E; }
  .prof-score--mid .prof-score-num { color: #8B6000; }
  .prof-score--low .prof-score-num { color: var(--red); }
  .prof-score-den { font-size: 0.5em; font-weight: 600; color: var(--grey-mid); }
  .prof-score-lbl { display: block; font-family: var(--fd); font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--grey-mid); margin-top: 2px; }
  .prof-read {
    font-size: clamp(12px, 0.9vw, 15px);
    font-weight: 300;
    color: #444;
    line-height: 1.6;
    margin: 12px 0 14px;
  }
  .swot { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--grey-light); border: 1px solid var(--grey-light); margin-top: auto; }
  .swot-q { background: #fff; padding: 11px 13px; }
  .swot-lbl {
    display: block;
    font-family: var(--fd);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .swot-s .swot-lbl { color: #1E6B2E; }
  .swot-w .swot-lbl { color: var(--red); }
  .swot-o .swot-lbl { color: #1F5FA8; }
  .swot-t .swot-lbl { color: #8B6000; }
  .swot-q ul { list-style: none; display: flex; flex-direction: column; gap: 5px; }
  .swot-q li {
    position: relative;
    padding-left: 12px;
    font-size: clamp(11px, 0.82vw, 13px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.45;
  }
  .swot-q li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 4px; height: 4px; border-radius: 50%; background: var(--grey-mid); }
  .swot-s li::before { background: #1E6B2E; }
  .swot-w li::before { background: var(--red); }
  .swot-o li::before { background: #1F5FA8; }
  .swot-t li::before { background: #8B6000; }

  /* ── MANAGER'S READ (Club Manager's file: cost, risk, skills) ── */
  .mgr {
    margin: 2px 0 14px;
    padding: 13px 14px;
    background: var(--off-white);
    border: 1px solid var(--grey-light);
    border-radius: 5px;
  }
  .mgr-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 11px; }
  .mgr-lbl {
    font-family: var(--fd);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }
  .mgr-risk {
    font-family: var(--fd);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--red);
    background: rgba(139,26,26,0.08);
    border: 1px solid rgba(139,26,26,0.32);
    border-radius: 100px;
    padding: 3px 11px;
    white-space: nowrap;
  }
  .mgr-cost { display: flex; gap: 10px; margin-bottom: 4px; }
  .mgr-cost-item {
    flex: 1;
    background: #fff;
    border: 1px solid var(--grey-light);
    border-radius: 5px;
    padding: 9px 11px;
    text-align: center;
  }
  .mgr-cost-num {
    display: block;
    font-family: var(--fd);
    font-weight: 800;
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    line-height: 1;
    color: var(--text);
  }
  .mgr-cost-lbl {
    display: block;
    font-family: var(--fd);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--grey-mid);
    margin-top: 5px;
  }
  .mgr-skills { margin-top: 11px; }
  .mgr-skills-lbl {
    display: block;
    font-family: var(--fd);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey-mid);
    margin-bottom: 7px;
  }
  .mgr-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .mgr-chip {
    font-family: var(--fb);
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 400;
    line-height: 1.3;
    border-radius: 100px;
    padding: 4px 11px;
  }

---
import BaseLayout from '../layouts/BaseLayout.astro';

const files = [
  {
    id: '1XXEAlyalWw1uYIAxoiJ9eeWF1p13bVBBWTHLOfiRONU',
    type: 'sheet',
    label: 'Google Sheets',
    name: 'TCA — Shared Working File',
    description: 'File condiviso di lavoro',
  },
];

const active = files[0];
const embedUrl = `https://docs.google.com/spreadsheets/d/${active.id}/edit?usp=sharing&rm=minimal&embedded=true`;
const openUrl  = `https://docs.google.com/spreadsheets/d/${active.id}/edit?usp=sharing`;
---

<BaseLayout title="TCA · Workspace" description="Shared working files — Tennis Club Ambrosiano Independence Project." noindex={true}>

  <div class="ws-root">

    <!-- ── TOOLBAR ── -->
    <div class="ws-toolbar">
      <div class="ws-toolbar-left">
        <span class="ws-eyebrow">Workspace</span>
        <div class="ws-files" id="ws-tabs">
          {files.map((f, i) => (
            <button
              class={`ws-file-tab${i === 0 ? ' is-active' : ''}`}
              data-embed={`https://docs.google.com/spreadsheets/d/${f.id}/edit?usp=sharing&rm=minimal&embedded=true`}
              data-open={`https://docs.google.com/spreadsheets/d/${f.id}/edit?usp=sharing`}
              data-name={f.name}
            >
              <svg class="ws-file-icon" viewBox="0 0 20 20" fill="none">
                <rect x="3" y="2" width="14" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
              {f.name}
            </button>
          ))}
        </div>
      </div>
      <div class="ws-toolbar-right">
        <a href={openUrl} target="_blank" rel="noopener" class="ws-open-btn" id="ws-open-link">
          <svg viewBox="0 0 16 16" fill="none" width="13" height="13">
            <path d="M6 3H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M9 2h5v5M14 2 8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Apri in Google Sheets
        </a>
      </div>
    </div>

    <!-- ── EMBED FRAME ── -->
    <div class="ws-frame-wrap">
      <iframe
        id="ws-frame"
        src={embedUrl}
        class="ws-frame"
        frameborder="0"
        allowfullscreen
        title="Shared working file"
      ></iframe>
    </div>

  </div>

</BaseLayout>

<script>
  const tabs   = document.querySelectorAll<HTMLButtonElement>('.ws-file-tab');
  const frame  = document.getElementById('ws-frame') as HTMLIFrameElement;
  const opener = document.getElementById('ws-open-link') as HTMLAnchorElement;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      frame.src  = tab.dataset.embed!;
      opener.href = tab.dataset.open!;
    });
  });
</script>

<style>
  :global(body) { overflow: hidden; }

  .ws-root {
    display: flex;
    flex-direction: column;
    height: 100vh;
    padding-top: var(--header-h);
    background: #f5f5f5;
  }

  /* ── TOOLBAR ── */
  .ws-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(16px, 2.5vw, 32px);
    height: 50px;
    background: #fff;
    border-bottom: 1px solid var(--grey-light);
    gap: 16px;
    flex-shrink: 0;
  }
  .ws-toolbar-left {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
    overflow: hidden;
  }
  .ws-toolbar-right { flex-shrink: 0; }

  .ws-eyebrow {
    font-family: var(--fd);
    font-size: clamp(9px, 0.6vw, 10px);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--grey-mid);
    white-space: nowrap;
  }

  .ws-files {
    display: flex;
    align-items: stretch;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
    height: 50px;
  }
  .ws-files::-webkit-scrollbar { display: none; }

  .ws-file-tab {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 16px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: var(--fd);
    font-size: clamp(11px, 0.85vw, 13px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--grey-mid);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .ws-file-tab:hover { color: var(--text); }
  .ws-file-tab.is-active {
    color: var(--red);
    border-bottom-color: var(--red);
  }
  .ws-file-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: currentColor;
    opacity: 0.7;
  }

  .ws-open-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--fd);
    font-size: clamp(9px, 0.72vw, 11px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    text-decoration: none;
    border: 1.5px solid var(--red);
    padding: 5px 14px;
    border-radius: 3px;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .ws-open-btn:hover { background: var(--red); color: #fff; }
  .ws-open-btn svg { flex-shrink: 0; }

  /* ── FRAME ── */
  .ws-frame-wrap {
    flex: 1;
    min-height: 0;
    position: relative;
  }
  .ws-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #fff;
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .ws-toolbar {
      height: auto;
      min-height: 50px;
      flex-direction: column;
      align-items: flex-start;
      padding: 10px 16px 0;
      gap: 0;
    }
    .ws-toolbar-left { width: 100%; }
    .ws-eyebrow { display: none; }
    .ws-toolbar-right {
      width: 100%;
      padding: 8px 0;
      border-top: 1px solid var(--grey-light);
    }
    .ws-open-btn { font-size: 10px; }
    :global(body) { overflow: auto; }
    .ws-root { height: auto; }
    .ws-frame-wrap { height: 80vh; position: relative; }
  }
</style>

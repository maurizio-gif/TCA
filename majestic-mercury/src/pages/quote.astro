---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoBand from '../components/PhotoBand.astro';

interface LineItem {
  label: string;
  note?: string;
}
interface Workstream {
  id: string;
  name: string;
  subtitle?: string;
  price: number;
  items: LineItem[];
  caveat?: string;
}

const workstreams: Workstream[] = [
  {
    id: '01',
    name: 'Perfect Gym',
    subtitle: 'Contract separation & service continuity',
    price: 1600,
    items: [
      { label: 'Coordination with Peter Croft and administrative separation of contracts from Aspria Holdings' },
      { label: 'Activation of direct invoicing to Tennis Club Ambrosiano with full service continuity' },
      { label: 'Takeover of the ordinary support previously provided by the Aspria IT department' },
      { label: 'Negotiation of the monthly fee reduction', note: 'Target −40%: from €1,500/mo to ~€900/mo' },
    ],
  },
  {
    id: '02',
    name: 'Website',
    subtitle: 'Carve-out & operational takeover',
    price: 800,
    items: [
      { label: 'Coordination with Laura Giardini and Thomas Sander' },
      { label: 'Mapping of the current Prismic setup and separation from the Aspria perimeter' },
      { label: 'Operational takeover of the existing website for the transition period' },
    ],
    caveat: 'The rebuild of the website on a new platform is not included in this total — see the dedicated add-on below.',
  },
  {
    id: '03',
    name: 'HubSpot & JotForm',
    subtitle: 'Full form rebuild & new automations',
    price: 3200,
    items: [
      { label: 'Analysis of the existing forms and automations' },
      { label: 'Complete rebuild of all forms in custom HTML/CSS with restructured logic (not a 1:1 replacement)' },
      { label: 'New automation architecture via N8N → Perfect Gym' },
      { label: 'Renewed deduplication and lead-nurturing logic, deeper user profiling' },
      { label: 'Training of the Marketing resource on newsletter management' },
    ],
    caveat: 'In this initial phase, the N8N automation layer will run on a managed instance provided by the consultant at no extra cost to TCA. The setup is fully portable: should TCA choose to host N8N independently in the future, the migration can be carried out without any disruption to the automations.',
  },
  {
    id: '04',
    name: 'Microsoft → Google Workspace',
    subtitle: 'Full migration · ~10 accounts',
    price: 3400,
    items: [
      { label: 'Initial assessment and scope definition (accounts, aliases, groups, volumes)' },
      { label: 'Setup of the new independent Google Workspace tenant (domain, security, Drive structure)' },
      { label: 'User, alias and shared-mailbox mapping; technical coordination with Aspria IT' },
      { label: 'Pilot migration, then full migration of email, calendars, contacts and OneDrive files' },
      { label: 'Delta migration, DNS/mail-routing cutover and final per-user validation' },
      { label: 'Post-migration support, device reconfiguration and Gmail/Drive onboarding' },
    ],
    caveat: 'Price based on the “fast track” path (temporary admin access granted by Aspria IT). Should the manual account-by-account path be required, the effort increases by 40–60% and will be re-quoted.',
  },
  {
    id: '05',
    name: 'Project Management',
    subtitle: 'Overall steering & cross-stream coordination',
    price: 1000,
    items: [
      { label: 'Overall steering of the carve-out phase and plan governance towards the July 31st cut-off' },
      { label: 'Coordination with Aspria Holdings and third-party vendors' },
      { label: 'Periodic progress reporting to ownership' },
    ],
  },
  {
    id: '06',
    name: 'Operational Audit',
    subtitle: 'Processes, organisation & personnel cost structure',
    price: 0,
    items: [
      { label: 'Mapping and review of current operational processes across the key club functions' },
      { label: 'Analysis of the organisational structure, reporting lines and decision-making model' },
      { label: 'Review of the personnel cost structure — headcount, contracts and cost allocation' },
      { label: 'Diagnostic output with findings, open issues and a clear recommendation for the next phase of engagement' },
    ],
    caveat: 'Included in the scope above. The audit is a prerequisite for defining and sizing the next phase of work — no separate fee applies.',
  },
];

const addon = {
  name: 'New Website',
  subtitle: 'Rebuild on a new platform',
  price: 4000,
  items: [
    { label: 'Development in custom HTML/CSS on an Astro architecture, with Decap CMS for in-house content management' },
    { label: 'SEO optimisation targeted at the activities offered by Tennis Club Ambrosiano' },
    { label: 'Events section with booking forms included', note: 'Event pages will be editable by the internal team via the CMS' },
    { label: 'Structured lead-generation architecture, natively integrated with the new forms and N8N → Perfect Gym automations' },
    { label: 'Content migration and SEO continuity from the current site' },
  ],
};

const totalPrice = workstreams.reduce((s, w) => s + w.price, 0);
const eur = (n: number) => '€' + n.toLocaleString('en-US');
const base = (() => { const b = import.meta.env.BASE_URL; return b.endsWith('/') ? b : b + '/'; })();
---

<BaseLayout title="TCA · Carve-Out Quote" initialHeaderDark={true} noindex={true}>

  <main class="qt-page">

    <div class="qt-header">
      <span class="eyebrow eyebrow--grey">Confidential · Commercial Offer</span>
      <h1 class="qt-title">Quote &mdash; <em>Carve-Out Phase</em></h1>
      <div class="qt-meta">
        <div class="qt-meta-item"><span>Client</span>Tennis Club Ambrosiano</div>
        <div class="qt-meta-item"><span>Consultant</span>Maurizio Taruggi</div>
        <div class="qt-meta-item"><span>Date</span>June 12, 2026</div>
        <div class="qt-meta-item"><span>Validity</span>30 days</div>
        <div class="qt-meta-item"><span>Reference cut-off</span>July 31st</div>
      </div>
    </div>

    <p class="qt-intro">
      This offer covers the consulting activities required to separate Tennis Club Ambrosiano’s
      digital infrastructure from the Aspria Holdings perimeter, as per the shared Carve-Out Roadmap.
      Prices are <strong>fixed per workstream</strong>, for a total of <strong>{eur(totalPrice)}</strong>
      for the carve-out phase. The rebuild of the website is offered separately by Ready 2 Digital Srl
      — see the dedicated offer at the end of this page.
    </p>

    <PhotoBand img="club-family.jpeg" eyebrow="Investment" blur={3} line="One partner. Every capability TCA needs right now." />

    <!-- ── WORKSTREAMS ── -->
    <div class="qt-streams">
      {workstreams.map(w => (
        <section class="qt-stream">
          <header class="qt-stream-head">
            <div class="qt-stream-name">
              <em>{w.id}</em>
              <div>
                <h2>{w.name}</h2>
                {w.subtitle && <span class="qt-stream-sub">{w.subtitle}</span>}
              </div>
            </div>
            <div class="qt-stream-price">
              <span class="qt-price">{w.price === 0 ? 'Included' : eur(w.price)}</span>
            </div>
          </header>
          <ul class="qt-items">
            {w.items.map(it => (
              <li>
                {it.label}
                {it.note && <span class="qt-note">{it.note}</span>}
              </li>
            ))}
          </ul>
          {w.caveat && <p class="qt-caveat">{w.caveat}</p>}
        </section>
      ))}
    </div>

    <!-- ── TOTAL ── -->
    <div class="qt-total">
      <div class="qt-total-label">
        Carve-out phase total
        <span>Fixed price per workstream · website rebuild excluded</span>
      </div>
      <div class="qt-total-price">{eur(totalPrice)}</div>
    </div>

    <!-- ── EXCLUSIONS & TERMS ── -->
    <div class="qt-terms">
      <div class="qt-terms-block">
        <h3>Exclusions</h3>
        <ul>
          <li>Physical devices (PCs &amp; Wi-Fi): assigned to an external on-site IT partner, out of scope</li>
          <li>Website rebuild: offered separately by Ready 2 Digital Srl — see the dedicated offer below</li>
          <li>Third-party licenses and fees (Google Workspace, migration tools, Perfect Gym, etc.)</li>
          <li>Activities beyond the described scope: assessed and quoted separately</li>
        </ul>
      </div>
      <div class="qt-terms-block">
        <h3>Terms</h3>
        <ul>
          <li>Proposed invoicing: 40% at kick-off · 40% at progress milestone · 20% at closure</li>
          <li>All amounts are exempt from VAT, with a 4% INPS social-security contribution (rivalsa INPS)</li>
          <li>Offer validity: 30 days from the issue date</li>
        </ul>
      </div>
    </div>

    <!-- ── ACCEPTANCE ── -->
    <section class="qt-accept">
      <h3>How to accept this offer</h3>
      <ol class="qt-accept-steps">
        <li>Print the contract using the button below (or save it as a PDF)</li>
        <li>Fill in your details in the Client section (registered office, VAT no., signatory name and role)</li>
        <li>Sign it — both the main signature and the express-approval signature</li>
        <li>Send the signed copy to <strong>maurizio@ready2digital.it</strong></li>
      </ol>
      <a class="qt-contract-btn" href={`${base}contract/?print=1`}>Print contract (PDF)</a>
    </section>

    <!-- ── DIVIDER ── -->
    <hr class="qt-divider" />

    <!-- ── NEW WEBSITE — SEPARATE OFFER ── -->
    <div class="qt-header">
      <span class="eyebrow eyebrow--grey">Separate Offer · Ready 2 Digital Srl</span>
      <h2 class="qt-title">Quote &mdash; <em>New Website</em></h2>
      <div class="qt-meta">
        <div class="qt-meta-item"><span>Client</span>Tennis Club Ambrosiano</div>
        <div class="qt-meta-item"><span>Supplier</span>Ready 2 Digital Srl</div>
        <div class="qt-meta-item"><span>VAT no.</span>16573891005</div>
        <div class="qt-meta-item"><span>Registered office</span>Via Ugo Ojetti 134, Roma</div>
        <div class="qt-meta-item"><span>Website</span>www.ready2digital.it</div>
      </div>
    </div>

    <p class="qt-intro">
      Following feedback from Laura Giardini, Serena Caputo and Alice Bartoli, the current platform (Prismic) is not suited to
      day-to-day operational management and does not produce structured leads. The new website is
      therefore offered as a separate engagement, developed and invoiced by
      <strong>Ready 2 Digital Srl</strong>, and is not included in the carve-out total above.
    </p>

    <div class="qt-streams">
      <section class="qt-stream">
        <header class="qt-stream-head">
          <div class="qt-stream-name">
            <em>01</em>
            <div>
              <h2>{addon.name}</h2>
              <span class="qt-stream-sub">{addon.subtitle}</span>
            </div>
          </div>
          <div class="qt-stream-price">
            <span class="qt-price">{eur(addon.price)}</span>
            <span class="qt-vat">+ 22% VAT</span>
          </div>
        </header>
        <ul class="qt-items">
          {addon.items.map(it => (
            <li>
              {it.label}
              {it.note && <span class="qt-note">{it.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="qt-total">
      <div class="qt-total-label">
        New website total
        <span>Fixed price · developed and invoiced by Ready 2 Digital Srl</span>
      </div>
      <div class="qt-total-price">{eur(addon.price)} <span class="qt-total-vat">+ 22% VAT</span></div>
    </div>

    <div class="qt-terms">
      <div class="qt-terms-block">
        <h3>Exclusions</h3>
        <ul>
          <li>Third-party licenses and fees (hosting, domain, external services)</li>
          <li>Activities beyond the described scope: assessed and quoted separately</li>
        </ul>
      </div>
      <div class="qt-terms-block">
        <h3>Terms</h3>
        <ul>
          <li>Proposed invoicing: 50% at signature · 50% at go-live</li>
          <li>The fee is subject to VAT at the statutory rate of 22%</li>
          <li>Offer validity: 30 days from the issue date</li>
        </ul>
      </div>
    </div>

    <section class="qt-accept">
      <h3>How to accept this offer</h3>
      <ol class="qt-accept-steps">
        <li>Print the website contract using the button below (or save it as a PDF)</li>
        <li>Fill in your details in the Client section (registered office, VAT no., signatory name and role)</li>
        <li>Sign it — both the main signature and the express-approval signature</li>
        <li>Send the signed copy to <strong>maurizio@ready2digital.it</strong></li>
      </ol>
      <a class="qt-contract-btn" href={`${base}contract-website/?print=1`}>Print website contract (PDF)</a>
    </section>

    <p class="qt-footer">Confidential · Tennis Club Ambrosiano · 2026</p>

  </main>

</BaseLayout>

<style>
  :global(body) { background: #fff; }

  /* ── PAGE ── */
  .qt-page {
    padding: calc(var(--header-h) + 3.5vh) clamp(20px, 5vw, 72px) 6vh;
    max-width: 1100px;
    margin: 0 auto;
  }

  .qt-header { margin-bottom: 3vh; }
  .qt-title {
    font-family: var(--fd);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.0;
    color: var(--text);
    margin-bottom: 2vh;
  }
  .qt-title em { color: var(--red); font-style: normal; }

  .qt-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    border-top: 1px solid var(--grey-light);
    border-bottom: 1px solid var(--grey-light);
    padding: 14px 0;
  }
  .qt-meta-item {
    font-size: clamp(13px, 0.95vw, 15px);
    font-weight: 500;
    color: var(--text);
  }
  .qt-meta-item span {
    display: block;
    font-family: var(--fd);
    font-size: clamp(9px, 0.65vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey-mid);
    margin-bottom: 2px;
  }

  .qt-intro {
    font-size: clamp(13px, 0.95vw, 15px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.7;
    max-width: 70ch;
    margin-bottom: 4vh;
  }

  /* ── STREAMS ── */
  .qt-streams { display: flex; flex-direction: column; gap: 18px; }

  .qt-stream {
    border: 1px solid var(--grey-light);
    border-radius: 6px;
    overflow: hidden;
  }
  .qt-stream-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 22px;
    background: #faf9f7;
    border-bottom: 1px solid var(--grey-light);
  }
  .qt-stream-name {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .qt-stream-name em {
    font-family: var(--fd);
    font-style: normal;
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--red);
  }
  .qt-stream-name h2 {
    font-family: var(--fd);
    font-size: clamp(17px, 1.4vw, 21px);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1.1;
  }
  .qt-stream-sub {
    display: block;
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 300;
    font-style: italic;
    color: var(--grey-mid);
    margin-top: 2px;
  }
  .qt-stream-price { text-align: right; flex-shrink: 0; }
  .qt-price {
    font-family: var(--fd);
    font-size: clamp(17px, 1.4vw, 21px);
    font-weight: 800;
    color: var(--red);
    white-space: nowrap;
  }

  .qt-items {
    list-style: none;
    padding: 16px 22px 6px;
    margin: 0;
  }
  .qt-items li {
    font-size: clamp(13px, 0.9vw, 14px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
    padding: 0 0 10px 18px;
    position: relative;
  }
  .qt-items li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--red);
    font-weight: 700;
  }
  .qt-note {
    display: block;
    font-size: clamp(11px, 0.78vw, 12px);
    font-style: italic;
    color: var(--grey-mid);
  }
  .qt-caveat {
    margin: 0 22px 16px;
    padding: 10px 14px;
    background: rgba(139,26,26,0.05);
    border-left: 3px solid var(--red);
    border-radius: 0 4px 4px 0;
    font-size: clamp(12px, 0.82vw, 13px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
  }

  /* ── TOTAL ── */
  .qt-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
    padding: 20px 24px;
    background: var(--red);
    border-radius: 6px;
    color: #fff;
  }
  .qt-total-label {
    font-family: var(--fd);
    font-size: clamp(15px, 1.2vw, 19px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .qt-total-label span {
    display: block;
    font-family: var(--fb);
    font-size: clamp(11px, 0.78vw, 12px);
    font-weight: 300;
    text-transform: none;
    letter-spacing: 0;
    color: rgba(255,255,255,0.7);
    margin-top: 3px;
  }
  .qt-total-price {
    font-family: var(--fd);
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 800;
    white-space: nowrap;
  }

  .qt-total-vat {
    font-size: 0.55em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.75);
  }

  .qt-vat {
    display: block;
    font-family: var(--fd);
    font-size: clamp(10px, 0.7vw, 12px);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey-mid);
    text-align: right;
  }

  /* ── DIVIDER ── */
  .qt-divider {
    margin: 7vh 0 5vh;
    border: none;
    border-top: 3px solid var(--red);
    opacity: 0.85;
  }

  /* ── TERMS ── */
  .qt-terms {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 4vh;
  }
  .qt-terms-block h3 {
    font-family: var(--fd);
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 10px;
  }
  .qt-terms-block ul { list-style: none; margin: 0; padding: 0; }
  .qt-terms-block li {
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
    padding: 0 0 8px 16px;
    position: relative;
  }
  .qt-terms-block li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--red);
    font-weight: 700;
  }

  /* ── ACCEPTANCE ── */
  .qt-accept {
    margin-top: 4vh;
    padding: 22px 24px;
    background: #faf9f7;
    border: 1px solid var(--grey-light);
    border-left: 3px solid var(--red);
    border-radius: 6px;
  }
  .qt-accept h3 {
    font-family: var(--fd);
    font-size: clamp(13px, 1vw, 16px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 12px;
  }
  .qt-accept-steps {
    margin: 0 0 18px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .qt-accept-steps li {
    font-size: clamp(13px, 0.92vw, 14px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
  }
  .qt-accept-steps li::marker {
    font-family: var(--fd);
    font-weight: 700;
    color: var(--red);
  }
  .qt-contract-btn {
    display: inline-block;
    font-family: var(--fd);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--red);
    border-radius: 4px;
    padding: 11px 24px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .qt-contract-btn:hover { background: var(--red-dark); }

  .qt-footer {
    margin-top: 5vh;
    border-top: 1px solid var(--grey-light);
    padding-top: 2vh;
    font-size: clamp(9px, 0.65vw, 11px);
    color: var(--grey-mid);
    font-family: var(--fd);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .qt-page { padding: calc(var(--header-h) + 20px) 16px 40px; }
    .qt-title { font-size: clamp(1.9rem, 8.5vw, 2.6rem); }
    .qt-meta { gap: 10px 24px; }
    .qt-meta-item { font-size: 14px; }
    .qt-meta-item span { font-size: 10px; }
    .qt-intro { font-size: 15px; }
    .qt-stream-head { flex-direction: column; align-items: flex-start; gap: 8px; padding: 14px 16px; }
    .qt-stream-price { text-align: left; }
    .qt-stream-name h2 { font-size: 19px; }
    .qt-stream-sub { font-size: 13px; }
    .qt-price { font-size: 20px; }
    .qt-items { padding: 14px 16px 4px; }
    .qt-items li { font-size: 15px; }
    .qt-note { font-size: 13px; }
    .qt-caveat { margin: 0 16px 14px; font-size: 13px; }
    .qt-total { flex-direction: column; align-items: flex-start; gap: 6px; }
    .qt-total-price { font-size: 26px; }
    .qt-accept { padding: 18px 16px; }
    .qt-accept h3 { font-size: 15px; }
    .qt-accept-steps li { font-size: 15px; }
    .qt-terms { grid-template-columns: 1fr; gap: 22px; }
    .qt-terms-block li { font-size: 14px; }
    .qt-footer { font-size: 12px; }
  }
</style>


---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = (() => { const b = import.meta.env.BASE_URL; return b.endsWith("/") ? b : b + "/"; })();

// Lean deck: one idea per slide, big titles, keywords only.
// The spoken story lives in the meeting notes, not here.

// S3–S4 · staff cost ratio, 2025 business plan and financial statements.
// Same 2025 revenue (~€3.0M) before and after, so only the costs that leave move.
const bars = [
  ['2025 · inherited', [['vav', 20.8], ['staff', 22.0], ['fee', 6.0]], '48.8%'],
  ['After the exits',  [['vav', 20.8], ['staff', 11.6]], '32.4%'],
  ['Athlon · all staff', [['athlon', 25.0]], '25%'],
];
const SCALE = 50;

const staff = [
  ['Tennis coaching · Vavassori Team', '629.2', '20.8%', '629.2', '20.8%'],
  ['Administration & management', '151.4', '5.0%', '151.4', '5.0%'],
  ['Maintenance', '78.0', '2.6%', '35.0', '1.2%'],
  ['Front desk & reception', '56.5', '1.9%', '56.5', '1.9%'],
  ['Admin support', '5.2', '0.2%', '5.2', '0.2%'],
  ['Instructors · fitness, PT, tennis', '101.5', '3.4%', '101.5', '3.4%'],
  ['Sales & sports manager', '128.1', '4.2%', '', ''],
  ['Aspria functions, recharged', '145.0', '4.8%', '', ''],
];

const leaving = ['Nobody calls back', 'Renewals left to memory', 'Know-how walks out'];

const procedure = [
  ['01', 'Online', 'The customer does everything'],
  ['02', 'At the club', 'Same procedure, assisted'],
  ['03', 'The team', 'Trained as expert customers'],
  ['04', 'Control', 'Reporting runs itself'],
];

const kiosk = ['Show the club', 'Virtual tour', 'Capture the lead', 'Enrol', 'Personal area', 'Teach digital'];

const failures = [
  ['Depends on people', 'One exit, sales stop', 'The process sells'],
  ['Compliance chased', 'Checked by hand', 'Compliance by design'],
  ['Data chased', 'Numbers rebuilt', 'Numbers close themselves'],
  ['Reactive club', 'The customer leads', 'The system anticipates'],
];

const chain = [
  ['Information', 'Real data, public prices', 'Salespeople, by voice', 'As Athlon, plus courts & coaching'],
  ['Product', 'Few standard plans', 'A grown catalogue', 'Membership · coaching · court-hours'],
  ['Enrolment', 'One path, online & on site', 'Paperwork at the desk', 'One path, online & kiosk'],
  ['Compliance', 'Tracked by the system', 'By hand', 'As Athlon, plus FIT card'],
  ['Booking', 'In the system', 'Playtomic, outside', 'One system: the court-hour'],
  ['Delivery', 'Class register', 'Handed to the partner', 'Register for coaching too'],
  ['Renewal', 'System-driven', 'Found at expiry', 'As Athlon'],
  ['Control', 'Automatic', 'Rebuilt by hand', 'As Athlon'],
  ['People', 'Relationship · 25% staff cost', 'Hub of the process', 'Relationship'],
];

const choices = ['The court is the inventory', 'The member is a family', 'People are the lubricant'];

const measures = [
  'Sales closed on their own',
  'Stops at the desk',
  'Time to enrol',
  'Response time',
  'Members in, members out',
  'Staff cost · Athlon 25%',
  'Days to close the month',
];

const phase0 = [
  ['01', 'Rebuild', 'Products · data · one procedure'],
  ['02', 'Assist', 'Desk & kiosk on the same path'],
  ['03', 'Open', 'Online, one product at a time'],
  ['04', 'Measure', 'Numbers back on their own'],
];
---

<BaseLayout
  title="TCA · The Operating Model"
  description="A lean, digital operating model for Tennis Club Ambrosiano, designed to be repeated at the next sites."
  noindex={true}
>

<div class="slide-dots" id="dots"></div>

<!-- COVER -->
<section class="slide om-cover" id="s1" data-header="dark">
  <div class="om-cover__bg" style={`background-image: linear-gradient(105deg, rgba(20,20,22,.9) 40%, rgba(139,26,26,.35) 100%), url('${base}club-aerial.jpeg')`}></div>
  <div class="om-cover__watermark">TCA</div>
  <div class="om-cover__content">
    <span class="eyebrow eyebrow--light">Tennis Club Ambrosiano · October 2026</span>
    <h1 class="om-cover__title">A club that<br />runs on a<br /><em>model.</em></h1>
    <p class="om-cover__sub">Smart. Lean. Repeatable.</p>
  </div>
  <div class="om-cover__meta">Maurizio Taruggi</div>
</section>

<!-- WHERE TCA STARTS · THE ORGANISATION -->
<section class="slide om-light" id="s2" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">01 · Where TCA starts</span>
    <h2 class="om-h">TCA inherits<br /><em>an Aspria organisation.</em></h2>
    <div class="om-row om-row--3 om-path">
      <div class="om-word om-word--light">
        <span class="om-word__tag">The model</span>
        Built on Aspria
      </div>
      <div class="om-word om-word--light">
        <span class="om-word__tag">The ambition</span>
        Towards Aspresso: lean &amp; digital
      </div>
      <div class="om-word om-word--ink">
        <span class="om-word__tag">The organisation</span>
        Still legacy
      </div>
    </div>
  </div>
</section>

<!-- WHERE TCA STARTS · STAFF COST RATIO -->
<section class="slide om-dark" id="s3" data-header="dark">
  <div class="om-wrap">
    <span class="eyebrow eyebrow--light">01 · Where TCA starts · The numbers we inherit</span>
    <h2 class="om-h om-h--light">Staff cost:<br /><em>42.8% of revenue.</em></h2>
    <div class="om-bars">
      {bars.map(([label, segs, total]) => (
        <div class="om-bar">
          <span class="om-bar__label">{label}</span>
          <div class="om-bar__track">
            {(segs as [string, number][]).map(([kind, v]) => (
              <span class={`om-bar__seg om-bar__seg--${kind}`} style={`width:${(v / SCALE) * 100}%`}>{v.toFixed(1)}</span>
            ))}
            <span class="om-bar__total">{total}</span>
          </div>
        </div>
      ))}
    </div>
    <ul class="om-legend">
      <li><i class="om-bar__seg--vav"></i>Vavassori</li>
      <li><i class="om-bar__seg--staff"></i>Other staff</li>
      <li><i class="om-bar__seg--fee"></i>Aspria fee</li>
    </ul>
    <p class="om-punch om-punch--light">Vavassori alone: 20.8 points. Two thirds of what stays.</p>
  </div>
</section>

<!-- WHERE TCA STARTS · LINE BY LINE -->
<section class="slide om-light" id="s4" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">01 · Where TCA starts · Line by line</span>
    <h2 class="om-h om-h--md">What leaves.<br /><em>What stays.</em></h2>
    <table class="om-table om-table--nums">
      <thead>
        <tr><th>Staff cost, 2025</th><th>€ k</th><th>% revenue</th><th>After · € k</th><th>% revenue</th></tr>
      </thead>
      <tbody>
        {staff.map(([line, before, pb, after, pa]) => (
          <tr class={after ? '' : 'om-table__gone'}>
            <td class="om-table__name">{line}</td>
            <td data-label="2025 · € k">{before}</td>
            <td data-label="% revenue">{pb}</td>
            <td data-label="After · € k">{after || '—'}</td>
            <td data-label="After · % revenue" class="om-table__answer">{pa || '—'}</td>
          </tr>
        ))}
        <tr class="om-table__total">
          <td class="om-table__name">Total staff</td>
          <td data-label="2025 · € k">1,295.0</td>
          <td data-label="% revenue">42.8%</td>
          <td data-label="After · € k">978.9</td>
          <td data-label="After · % revenue" class="om-table__answer">32.4%</td>
        </tr>
        <tr class="om-table__gone om-table__fee">
          <td class="om-table__name">Aspria Holdings fee</td>
          <td data-label="2025 · € k">182.1</td>
          <td data-label="% revenue">6.0%</td>
          <td data-label="After · € k">—</td>
          <td data-label="After · % revenue" class="om-table__answer">—</td>
        </tr>
      </tbody>
    </table>
    <p class="om-note">Same 2025 revenue (about €3.0M) before and after. “After” removes the costs that leave; replacements for the Aspria functions are not included.</p>
  </div>
</section>

<!-- NOVEMBER -->
<section class="slide om-dark" id="s5" data-header="dark">
  <div class="om-wrap">
    <span class="eyebrow eyebrow--light">02 · What I see</span>
    <h2 class="om-h om-h--light">November:<br /><em>two people leave.</em></h2>
    <div class="om-row om-row--3 om-row--dark">
      {leaving.map((t) => <div class="om-word om-word--dark">{t}</div>)}
    </div>
    <p class="om-punch om-punch--light">Replace them, or move to the model?</p>
  </div>
</section>

<!-- THE DATA: LEADS -->
<section class="slide om-light" id="s6" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">02 · What I see · The data</span>
    <h2 class="om-h">Leads ×3.<br /><em>The flow is stuck.</em></h2>
    <div class="om-flow" aria-label="From lead to enrolment, with two choke points">
      <div class="om-flow__step om-flow__step--strong"><span class="om-flow__big">×3</span><span>Leads</span></div>
      <div class="om-flow__arrow">→</div>
      <div class="om-flow__step"><span>Adult tennis demand</span><span class="om-flow__sub">Courses &amp; memberships</span></div>
      <div class="om-flow__arrow">→</div>
      <div class="om-flow__step om-flow__step--choke"><span class="om-flow__mark">1</span><span>Coaching by Vavassori</span><span class="om-flow__sub">Slow to reply</span></div>
      <div class="om-flow__arrow">→</div>
      <div class="om-flow__step om-flow__step--choke"><span class="om-flow__mark">2</span><span>The product</span><span class="om-flow__sub">Doesn’t scale</span></div>
      <div class="om-flow__arrow">→</div>
      <div class="om-flow__step om-flow__step--blocked"><span>Enrolment</span><span class="om-flow__sub">Stuck</span></div>
    </div>
    <div class="om-row om-row--3 om-stats">
      <div class="om-stat"><span class="om-stat__big">8 in 10</span><span class="om-stat__label">new adults ask for tennis</span></div>
      <div class="om-stat"><span class="om-stat__big">1 in 12</span><span class="om-stat__label">of them joins</span></div>
      <div class="om-stat om-stat--key"><span class="om-stat__big">45% → 22%</span><span class="om-stat__label">Join rate: membership alone → with tennis</span></div>
    </div>
    <p class="om-punch">Tennis demand gets stuck in the course, and takes the membership with it.</p>
  </div>
</section>

<!-- TENNIS IS THE CORE -->
<section class="slide om-dark" id="s7" data-header="dark">
  <div class="om-wrap">
    <span class="eyebrow eyebrow--light">02 · What I see · Tennis</span>
    <h2 class="om-h om-h--light">Tennis is our core.<br /><em>Its front door is outside.</em></h2>
    <div class="om-row om-row--3 om-row--dark">
      <div class="om-word om-word--dark">
        <span class="om-word__tag">The flow</span>
        One door: Vavassori Team. Slow to reply.
      </div>
      <div class="om-word om-word--dark">
        <span class="om-word__tag">The margin</span>
        <span class="om-big">50–55%</span>
        to the partner
      </div>
      <div class="om-word om-word--red">
        <span class="om-word__tag">The direction</span>
        A scalable tennis product. We own the process end to end.
      </div>
    </div>
  </div>
</section>

<!-- BRIDGE · THE STRUCTURE IS SET, NOW THE ENGINE -->
<section class="slide om-red" id="s8" data-header="dark">
  <div class="om-wrap">
    <span class="eyebrow eyebrow--light">03 · The model</span>
    <h2 class="om-h om-h--light">The structure is set.<br /><em>Now the engine.</em></h2>
    <div class="om-row om-row--2">
      <div class="om-word om-word--dark">
        <span class="om-word__tag">The structure · designed</span>
        <ul class="om-list">
          <li>Clear roles</li>
          <li>SOPs &amp; checklists</li>
          <li>Outsourced services</li>
          <li>Staff on duty</li>
        </ul>
      </div>
      <div class="om-word om-word--white">
        <span class="om-word__tag">The engine · digital</span>
        <ul class="om-list">
          <li>Selling online</li>
          <li>Control that runs itself</li>
          <li>The tennis course flow</li>
          <li>Ready for new sites</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ONLINE IS NOT A THIRD SALESPERSON -->
<section class="slide om-light" id="s9" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">03 · The model</span>
    <h2 class="om-h">Online is not<br /><em>a third salesperson.</em></h2>
    <div class="om-invert">
      <div class="om-invert__panel">
        <span class="om-invert__tag">The usual picture</span>
        <div class="om-invert__row">
          <div class="om-box">Sales</div>
          <div class="om-box">Sales</div>
          <div class="om-box om-box--ghost">Online</div>
        </div>
      </div>
      <div class="om-invert__panel om-invert__panel--model">
        <span class="om-invert__tag">The model · bottom-up</span>
        <div class="om-stack">
          <div class="om-stack__layer om-stack__layer--people">People</div>
          <div class="om-stack__layer om-stack__layer--data">Data &amp; control</div>
          <div class="om-stack__layer om-stack__layer--base">One procedure</div>
        </div>
      </div>
    </div>
    <p class="om-punch">Process first. People make it smooth.</p>
  </div>
</section>

<!-- ONE PROCEDURE -->
<section class="slide om-dark" id="s10" data-header="dark">
  <div class="om-wrap">
    <span class="eyebrow eyebrow--light">03 · The model · The procedure</span>
    <h2 class="om-h om-h--light">One procedure.<br /><em>Three ways. One control.</em></h2>
    <div class="om-row om-row--dark">
      {procedure.map(([num, label, head]) => (
        <div class={`om-word ${num === '04' ? 'om-word--red' : 'om-word--dark'}`}>
          <span class="om-word__num">{num}</span>
          <span class="om-word__tag">{label}</span>
          {head}
        </div>
      ))}
    </div>
    <p class="om-punch om-punch--light">A new site inherits the procedure, not the people.</p>
  </div>
</section>

<!-- FRONT AND BACK -->
<section class="slide om-light" id="s11" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">03 · The model · The team</span>
    <h2 class="om-h">Front and back.<br /><em>Two simple jobs.</em></h2>
    <div class="om-row om-row--2">
      <div class="om-word om-word--light">
        <span class="om-word__tag">Front · Ambassadors</span>
        <span class="om-word__xl">An expert customer</span>
      </div>
      <div class="om-word om-word--ink">
        <span class="om-word__tag">Back · Senior supervisors</span>
        <span class="om-word__xl">Closing online</span>
      </div>
    </div>
    <p class="om-punch">Every sale closed online is one less in the queue.</p>
  </div>
</section>

<!-- THE KIOSK -->
<section class="slide om-dark" id="s12" data-header="dark">
  <div class="om-wrap om-kiosk">
    <div class="om-kiosk__text">
      <span class="eyebrow eyebrow--light">03 · The model · The front desk</span>
      <h2 class="om-h om-h--light">A kiosk<br /><em>that teaches.</em></h2>
      <ul class="om-chips om-chips--dark">
        {kiosk.map((k) => <li>{k}</li>)}
      </ul>
      <p class="om-punch om-punch--light">Education, not operations.</p>
    </div>
    <figure class="om-kiosk__photo">
      <img src={`${base}athlon-reception.webp`} alt="Athlon Roma reception: one desk and two kiosks" loading="lazy" />
      <figcaption>Athlon Roma · one desk, two kiosks</figcaption>
    </figure>
  </div>
</section>

<!-- LEAN WITH PEOPLE OR WITH PROCESS -->
<section class="slide om-light" id="s13" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">03 · The model · Why lean fails</span>
    <h2 class="om-h">Lean with people,<br /><em>or with process?</em></h2>
    <table class="om-table om-table--big">
      <thead>
        <tr><th>Failure</th><th>How it shows</th><th>The model</th></tr>
      </thead>
      <tbody>
        {failures.map(([name, shows, answer]) => (
          <tr>
            <td class="om-table__name">{name}</td>
            <td data-label="How it shows" class="om-table__today">{shows}</td>
            <td data-label="The model" class="om-table__answer">{answer}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<!-- FROM ATHLON TO TCA -->
<section class="slide om-light om-off" id="s14" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">03 · The model · From Athlon to TCA</span>
    <h2 class="om-h om-h--md">Not a copy of Athlon.<br /><em>A new model, together.</em></h2>
    <table class="om-table om-table--chain">
      <thead>
        <tr><th>Link</th><th>Tested at Athlon</th><th>TCA today</th><th>TCA in the model</th></tr>
      </thead>
      <tbody>
        {chain.map(([link, athlon, today, model]) => (
          <tr>
            <td class="om-table__name">{link}</td>
            <td data-label="Tested at Athlon">{athlon}</td>
            <td data-label="TCA today" class="om-table__today">{today}</td>
            <td data-label="TCA in the model" class="om-table__answer">{model}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <ul class="om-chips om-chips--red">
      {choices.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<!-- OWN THE CUSTOMER JOURNEY -->
<section class="slide om-dark" id="s15" data-header="dark">
  <div class="om-wrap">
    <span class="eyebrow eyebrow--light">03 · The model · The customer journey</span>
    <h2 class="om-h om-h--light">We own<br /><em>the customer journey.</em></h2>
    <div class="om-layers">
      <div class="om-layer om-layer--ours">
        <span class="om-layer__tag">The journey · ours</span>
        <div class="om-layer__items"><span>Website</span><span>Enrolment</span><span>Kiosk</span><span>Personal area</span><span>Bookings</span><span>Renewals</span></div>
      </div>
      <div class="om-layer om-layer--control">
        <span class="om-layer__tag">Control · ours</span>
        <div class="om-layer__items"><span>Live dashboards</span><span>Alerts</span><span>Monthly close</span></div>
      </div>
      <div class="om-layer om-layer--engine">
        <span class="om-layer__tag">Engine · PerfectGym</span>
        <div class="om-layer__items"><span>Contracts</span><span>Payments</span><span>Access</span></div>
      </div>
    </div>
    <div class="om-actions">
      <a href="https://crm.tcambrosiano.com/dashboard/perfectgym" target="_blank" rel="noopener" class="btn btn-red">Live · the TCA dashboard ↗</a>
    </div>
  </div>
</section>

<!-- WHAT WE'LL MEASURE -->
<section class="slide om-light" id="s16" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">04 · Why it holds</span>
    <h2 class="om-h">The model<br /><em>measures itself.</em></h2>
    <div class="om-grid om-grid--4">
      {measures.map((m, i) => (
        <div class="om-measure">
          <span class="om-measure__num">{String(i + 1).padStart(2, '0')}</span>
          <p>{m}</p>
        </div>
      ))}
      <div class="om-measure om-measure--key">
        <span class="om-measure__num">08</span>
        <p>Time &amp; cost of a new site</p>
      </div>
    </div>
  </div>
</section>

<!-- NOVEMBER IS PHASE 0 -->
<section class="slide om-dark" id="s17" data-header="dark">
  <div class="om-wrap">
    <span class="eyebrow eyebrow--light">04 · November</span>
    <h2 class="om-h om-h--light">November is<br /><em>phase 0.</em></h2>
    <div class="om-row om-row--dark">
      {phase0.map(([num, label, text], i) => (
        <div class={`om-word ${i === 0 ? 'om-word--red' : 'om-word--dark'}`}>
          <span class="om-word__num">{num}</span>
          <span class="om-word__xl">{label}</span>
          <span class="om-word__small">{text}</span>
        </div>
      ))}
    </div>
    <p class="om-punch om-punch--light">A rebuild, not a switch-on.</p>
  </div>
</section>

<!-- OVER TO YOU · TCA IN THREE YEARS -->
<section class="slide om-light om-off" id="s18" data-header="light">
  <div class="om-wrap">
    <span class="eyebrow">Over to you</span>
    <h2 class="om-h om-h--xl">TCA<br /><em>in three years?</em></h2>
    <div class="om-row om-row--3 om-path">
      <div class="om-word om-word--light">
        <span class="om-word__tag">Today</span>
        On hold. Ready to evolve.
      </div>
      <div class="om-word om-word--light">
        <span class="om-word__tag">TCA</span>
        How far do we push it?
      </div>
      <div class="om-word om-word--ink">
        <span class="om-word__tag">Then</span>
        Do we open more?
      </div>
    </div>
  </div>
</section>

<!-- THE QUESTION -->
<section class="slide om-close" id="s19" data-header="dark">
  <div class="om-close__bg" style={`background: linear-gradient(170deg, rgba(10,14,20,.88) 0%, rgba(26,26,26,.8) 50%, rgba(100,18,18,.62) 100%), url('${base}verticale tca.avif') 35% center/cover no-repeat`}></div>
  <div class="om-close__corner om-close__corner--tl"></div>
  <div class="om-close__corner om-close__corner--br"></div>
  <div class="om-close__content">
    <span class="eyebrow eyebrow--light">The question</span>
    <h2 class="om-close__title">A model,<br /><em>or tools?</em></h2>
    <p class="om-close__quote">Tools solve November. A model solves every site you open.</p>
    <p class="om-close__meta">Maurizio Taruggi · maurizio@ready2digital.it</p>
  </div>
</section>

</BaseLayout>

<style is:global>
  html { scroll-behavior: smooth; }
  body { background: var(--text); }

  .slide {
    width: 100%;
    min-height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .om-dark  { background: var(--text); }
  .om-light { background: #fff; }
  .om-off   { background: var(--off-white); }

  .om-wrap {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: calc(var(--header-h) + 4vh) clamp(24px,5vw,72px) 5vh;
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 3.4vh, 40px);
    flex: 1;
    justify-content: center;
  }

  /* ── big titles: the slide is the title ── */
  .om-h {
    font-family: var(--fd);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -.01em;
    line-height: .9;
    color: var(--text);
    font-size: clamp(2.8rem, 6.6vw, 7rem);
  }
  .om-h em, .om-cover__title em, .om-close__title em { color: #C0282A; font-style: normal; }
  .om-h--light { color: #fff; }
  .om-h--xl { font-size: clamp(3.2rem, 9vw, 9.5rem); }
  .om-h--md { font-size: clamp(2.4rem, 4.8vw, 5rem); }

  .om-punch {
    font-family: var(--fd);
    font-size: clamp(1.4rem, 2.6vw, 2.6rem);
    font-weight: 700;
    text-transform: uppercase;

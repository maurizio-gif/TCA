  .om-box--ghost { border-style: dashed; color: var(--grey-mid); background: transparent; }
  .om-stack { display: flex; flex-direction: column; gap: 6px; flex: 1; justify-content: flex-end; }
  .om-stack__layer {
    font-family: var(--fd); font-size: clamp(16px, 1.7vw, 26px); font-weight: 800;
    letter-spacing: .04em; text-transform: uppercase; text-align: center;
    padding: clamp(10px, 1.8vh, 18px) 16px; color: #fff;
  }
  .om-stack__layer--people { background: rgba(255,255,255,.1); margin: 0 22%; }
  .om-stack__layer--data   { background: rgba(255,255,255,.18); margin: 0 10%; }
  .om-stack__layer--base   { background: var(--red); padding-top: clamp(18px, 3.4vh, 34px); padding-bottom: clamp(18px, 3.4vh, 34px); }

  /* ── S9 kiosk ── */
  .om-kiosk { display: grid; grid-template-columns: 1fr 1.05fr; align-items: center; gap: clamp(24px, 3.4vw, 64px); }
  .om-kiosk__text { display: flex; flex-direction: column; gap: clamp(18px, 3.4vh, 36px); }
  .om-kiosk__photo { margin: 0; }
  .om-kiosk__photo img { width: 100%; height: auto; display: block; border-top: 5px solid var(--red); }
  .om-kiosk__photo figcaption {
    font-family: var(--fd); font-size: clamp(12px, 1vw, 15px);
    font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
    color: rgba(255,255,255,.45); margin-top: 10px;
  }

  /* ── tables ── */
  .om-table { width: 100%; border-collapse: collapse; background: #fff; }
  .om-table th {
    font-family: var(--fd); font-size: clamp(12px, 1vw, 15px);
    font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    text-align: left; color: #fff; background: var(--text);
    padding: clamp(10px, 1.4vh, 14px) clamp(12px, 1.2vw, 20px);
  }
  .om-table th:last-child { background: var(--red); }
  .om-table td {
    font-family: var(--fd); font-size: clamp(14px, 1.25vw, 19px); font-weight: 600;
    letter-spacing: .02em; text-transform: uppercase; line-height: 1.15; color: var(--text-light);
    padding: clamp(8px, 1.2vh, 13px) clamp(12px, 1.2vw, 20px);
    border-bottom: 1px solid var(--grey-light);
    vertical-align: middle;
  }
  .om-table__name { font-weight: 800 !important; color: var(--text) !important; white-space: nowrap; }
  .om-table__answer { color: var(--red) !important; font-weight: 800 !important; background: rgba(139,26,26,.04); }
  .om-table__today { color: var(--grey-mid) !important; }
  .om-table--big td { font-size: clamp(1.1rem, 2vw, 2rem); padding: clamp(14px, 2.6vh, 28px) clamp(14px, 1.4vw, 24px); }

  /* ── S12 layers ── */
  .om-layers { display: flex; flex-direction: column; gap: 6px; }
  .om-layer {
    display: grid; grid-template-columns: minmax(180px, 17em) 1fr; align-items: center; gap: 16px;
    padding: clamp(14px, 2.4vh, 26px) clamp(16px, 1.8vw, 28px);
  }
  .om-layer--ours    { background: var(--red); }
  .om-layer--control { background: rgba(255,255,255,.14); }
  .om-layer--engine  { background: rgba(255,255,255,.04); border: 1px dashed rgba(255,255,255,.25); }
  .om-layer__tag {
    font-family: var(--fd); font-size: clamp(15px, 1.5vw, 22px);
    font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #fff;
  }
  .om-layer--engine .om-layer__tag { color: rgba(255,255,255,.55); }
  .om-layer__items { display: flex; flex-wrap: wrap; gap: 8px; }
  .om-layer__items span {
    font-family: var(--fd); font-size: clamp(14px, 1.3vw, 19px);
    font-weight: 600; letter-spacing: .05em; text-transform: uppercase;
    color: #fff; border: 1px solid rgba(255,255,255,.35); padding: 6px 14px;
  }
  .om-layer--engine .om-layer__items span { color: rgba(255,255,255,.55); border-color: rgba(255,255,255,.18); }
  .om-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── S13 measures ── */
  .om-grid { display: grid; gap: 1px; background: var(--grey-light); }
  .om-grid--4 { grid-template-columns: repeat(4, 1fr); }
  .om-measure {
    background: #fff;
    padding: clamp(18px, 3vh, 34px) clamp(16px, 1.6vw, 26px);
    display: flex; flex-direction: column; gap: 12px;
  }
  .om-measure p {
    font-family: var(--fd); font-size: clamp(1.15rem, 1.8vw, 1.8rem);
    font-weight: 700; text-transform: uppercase; line-height: 1.02; color: var(--text);
  }
  .om-measure__num { font-family: var(--fd); font-size: clamp(24px, 2.6vw, 40px); font-weight: 800; line-height: 1; color: var(--grey-light); }
  .om-measure--key { background: var(--red); }
  .om-measure--key p { color: #fff; }
  .om-measure--key .om-measure__num { color: rgba(255,255,255,.35); }

  /* ── S15 close ── */
  .om-close { background: var(--text); overflow: hidden; }
  .om-close__bg { position: absolute; inset: 0; }
  .om-close__corner { position: absolute; z-index: 1; width: clamp(40px,6vw,96px); height: clamp(40px,6vw,96px); }
  .om-close__corner--tl { top: 0; left: 0; border-top: 3px solid var(--red); border-left: 3px solid var(--red); }
  .om-close__corner--br { bottom: 0; right: 0; border-bottom: 3px solid var(--red); border-right: 3px solid var(--red); }
  .om-close__content {
    position: relative; z-index: 2;
    padding: calc(var(--header-h) + 7vh) clamp(24px,7vw,100px) 7vh;
    display: flex; flex-direction: column; justify-content: center; gap: 4vh; flex: 1;
  }
  .om-close__title {
    font-family: var(--fd); font-size: clamp(3.6rem, 11vw, 11rem);
    font-weight: 800; text-transform: uppercase; line-height: .84; color: #fff;
  }
  .om-close__quote {
    font-size: clamp(1.2rem, 2.2vw, 2.1rem); font-weight: 300; font-style: italic;
    line-height: 1.4; color: rgba(255,255,255,.82); max-width: 900px;
  }
  .om-close__meta {
    font-family: var(--fd); font-size: clamp(12px, 1vw, 14px);
    font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.32);
  }

  /* ══════════ MOBILE ══════════ */
  @media (max-width: 900px) {
    .slide { min-height: auto; }
    .om-cover, .om-close { min-height: 100svh; }
    .om-wrap { padding: calc(var(--header-h) + 24px) 16px 44px; gap: 18px; justify-content: flex-start; }
    .om-h { font-size: clamp(2.4rem, 11vw, 3.6rem); }
    .om-h--xl { font-size: clamp(2.8rem, 14vw, 4.4rem); }
    .om-row, .om-row--3, .om-row--2, .om-invert, .om-kiosk, .om-grid--4 { grid-template-columns: 1fr; }
    .om-flow { flex-direction: column; }
    .om-flow__arrow { justify-content: center; transform: rotate(90deg); }
    .om-cover__content { padding: calc(var(--header-h) + 32px) 22px 48px; }
    .om-cover__meta { position: static; padding: 0 22px 28px; }
    .om-layer { grid-template-columns: 1fr; gap: 10px; }
    .om-bar { grid-template-columns: 1fr; gap: 6px; }
    .om-table--nums td:not(:first-child) { text-align: left; }
    .om-close__content { padding: calc(var(--header-h) + 36px) 22px 48px; }

    /* tables become stacked cards */
    .om-table thead { display: none; }
    .om-table, .om-table tbody, .om-table tr, .om-table td { display: block; width: 100%; }
    .om-table tr { border-top: 3px solid var(--red); margin-bottom: 12px; background: #fff; }
    .om-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 11px; font-weight: 700;
      letter-spacing: .14em; color: var(--grey-mid);
      margin-bottom: 2px;

    color: var(--red);
    border-left: 5px solid var(--red);
    padding-left: clamp(14px, 1.4vw, 22px);
  }
  .om-punch--light { color: #fff; }

  /* ── slide number ── */
  .om-num {
    position: absolute; left: clamp(24px, 5vw, 72px); bottom: clamp(14px, 2.6vh, 28px); z-index: 3;
    font-family: var(--fd); font-size: clamp(12px, 1vw, 15px); font-weight: 700;
    letter-spacing: .14em; color: rgba(255,255,255,.45);
  }
  .om-num--light { color: var(--grey-mid); }

  /* ── dots ── */
  .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
    background: rgba(255,255,255,0.25);
  }
  .dot-on-light { background: rgba(0,0,0,0.2); }
  .dot.active { background: var(--red); transform: scale(1.5); }

  /* ── keyword rows ── */
  .om-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--grey-light); }
  .om-row--dark { background: rgba(255,255,255,.08); }
  .om-row--3 { grid-template-columns: repeat(3, 1fr); }
  .om-row--2 { grid-template-columns: repeat(2, 1fr); background: transparent; gap: clamp(12px, 1.4vw, 24px); }

  .om-word {
    padding: clamp(20px, 3.6vh, 44px) clamp(18px, 1.8vw, 30px);
    display: flex; flex-direction: column; justify-content: flex-end; gap: 10px;
    font-family: var(--fd);
    font-size: clamp(1.25rem, 2vw, 2rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.02;
  }
  .om-word--dark  { background: #1E2530; color: #fff; }
  .om-word--red   { background: var(--red); color: #fff; }
  .om-row--2 .om-word { min-height: clamp(160px, 26vh, 280px); }
  .om-path { background: transparent; gap: clamp(10px, 1.2vw, 20px); }
  .om-word--light { background: var(--off-white); color: var(--text); border-top: 5px solid var(--red); }
  .om-off .om-word--light { background: #fff; }
  .om-word--ink   { background: var(--text); color: #fff; border-top: 5px solid #C0282A; }
  .om-word__tag {
    font-size: clamp(11px, .95vw, 14px);
    font-weight: 700; letter-spacing: .18em;
    color: #C0282A;
  }
  .om-word--red .om-word__tag { color: rgba(255,255,255,.7); }
  .om-word__num { font-size: clamp(2rem, 3.6vw, 3.6rem); font-weight: 800; line-height: 1; color: rgba(255,255,255,.14); }
  .om-word__xl { font-size: clamp(2rem, 4vw, 4.2rem); font-weight: 800; line-height: .92; }
  .om-word__small { font-size: clamp(.95rem, 1.3vw, 1.3rem); font-weight: 600; color: rgba(255,255,255,.7); letter-spacing: .02em; }
  .om-big { display: block; font-size: clamp(3.2rem, 6.4vw, 6.4rem); font-weight: 800; line-height: .9; color: #fff; }

  /* ── chips ── */
  .om-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 12px; }
  .om-chips li {
    font-family: var(--fd); font-size: clamp(15px, 1.6vw, 24px);
    font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--text); border: 2px solid var(--grey-light); padding: 10px 18px;
  }
  .om-chips--dark li { color: #fff; border-color: rgba(255,255,255,.22); }
  .om-chips--red li { color: #fff; background: var(--red); border-color: var(--red); font-size: clamp(14px, 1.3vw, 20px); }

  /* ── S1 cover ── */
  .om-cover { background: var(--text); overflow: hidden; }
  .om-cover__bg {
    position: absolute; inset: 0;
    background-position: center; background-size: cover; background-repeat: no-repeat;
    filter: blur(2px); transform: scale(1.06);
  }
  .om-cover__content {
    position: relative; z-index: 2;
    padding: calc(var(--header-h) + 8vh) clamp(24px,6vw,80px) 8vh;
    display: flex; flex-direction: column; justify-content: center; gap: 3vh; flex: 1;
  }
  .om-cover__title {
    font-family: var(--fd);
    font-size: clamp(3.6rem, 10vw, 10rem);
    font-weight: 800; text-transform: uppercase; line-height: .86; letter-spacing: -.015em; color: #fff;
  }
  .om-cover__sub {
    font-family: var(--fd);
    font-size: clamp(1.3rem, 2.4vw, 2.4rem); font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: rgba(255,255,255,.72);
  }
  .om-cover__meta {
    position: absolute; bottom: 3.5vh; right: clamp(24px,4vw,60px); z-index: 2;
    font-family: var(--fd); font-size: clamp(12px, 1vw, 15px);
    font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.4);
  }
  .om-cover__watermark {
    position: absolute; bottom: -4vw; right: 2vw;
    font-family: var(--fd); font-size: clamp(140px, 18vw, 280px);
    font-weight: 800; color: rgba(255,255,255,.03); line-height: 1;
    user-select: none; pointer-events: none;
  }

  /* ── pivot slide on red ── */
  .om-red { background: var(--red); }
  .om-red .om-h em { color: var(--text); }
  .om-word--white { background: #fff; color: var(--text); }
  .om-list { list-style: none; display: flex; flex-direction: column; gap: clamp(6px, 1.2vh, 12px); font-size: clamp(1.3rem, 2.3vw, 2.4rem); font-weight: 800; line-height: 1; }
  .om-list li::before { content: '— '; color: #C0282A; }
  .om-row--2 .om-word:has(.om-list) { justify-content: flex-start; gap: clamp(14px, 2.4vh, 24px); }

  /* ── staff cost bars ── */
  .om-bars { display: flex; flex-direction: column; gap: clamp(12px, 2.2vh, 22px); }
  .om-bar { display: grid; grid-template-columns: minmax(150px, 15em) 1fr; align-items: center; gap: clamp(12px, 1.4vw, 24px); }
  .om-bar__label {
    font-family: var(--fd); font-size: clamp(14px, 1.4vw, 21px);
    font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.75);
  }
  /* segments are % of the track; the track leaves room on the right for the total */
  .om-bar__track { display: flex; align-items: stretch; height: clamp(40px, 7vh, 72px); width: calc(100% - 6.5rem); }
  .om-bar__seg {
    flex: none;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--fd); font-size: clamp(13px, 1.2vw, 18px); font-weight: 700; color: #fff;
    overflow: hidden; white-space: nowrap;
  }
  .om-bar__seg--vav    { background: #C0282A; }
  .om-bar__seg--staff  { background: #3A4352; }
  .om-bar__seg--fee    { background: repeating-linear-gradient(135deg, #5a6272 0 6px, #2b313c 6px 12px); }
  .om-bar__seg--athlon { background: #fff; color: var(--text); }
  .om-bar__total {
    flex: none;
    display: flex; align-items: center; padding-left: clamp(10px, 1vw, 18px);
    font-family: var(--fd); font-size: clamp(1.6rem, 3vw, 3rem); font-weight: 800; color: #fff; line-height: 1;
  }
  .om-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .om-legend li {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--fd); font-size: clamp(12px, 1vw, 15px); font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55);
  }
  .om-legend i { display: inline-block; width: 18px; height: 12px; }

  /* ── staff cost table ── */
  .om-table--nums th:not(:first-child), .om-table--nums td:not(:first-child) { text-align: right; white-space: nowrap; }
  .om-table--nums td { padding-top: clamp(6px, 1vh, 11px); padding-bottom: clamp(6px, 1vh, 11px); }
  .om-table__gone td { color: var(--grey-mid) !important; }
  .om-table__gone .om-table__name { text-decoration: line-through; text-decoration-color: var(--red); text-decoration-thickness: 2px; }
  .om-table__total td { background: var(--text) !important; color: #fff !important; font-weight: 800 !important; }
  .om-table__total .om-table__answer { background: var(--red) !important; }
  .om-note { font-size: clamp(12px, .95vw, 14px); font-weight: 300; font-style: italic; color: var(--grey-mid); }

  /* ── S4 flow ── */
  .om-flow { display: flex; align-items: stretch; gap: clamp(6px, .8vw, 12px); }
  .om-flow__step {
    flex: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
    text-align: center;
    background: var(--off-white);
    padding: clamp(18px, 3.6vh, 40px) 10px;
    font-family: var(--fd); font-size: clamp(15px, 1.6vw, 24px);
    font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--text); line-height: 1.05;
  }
  .om-flow__step--strong { background: var(--text); color: #fff; }
  .om-flow__big { font-size: clamp(2.6rem, 4.6vw, 4.6rem); font-weight: 800; line-height: 1; color: #C0282A; }
  .om-flow__step--choke { background: #fff; border: 3px solid var(--red); color: var(--red); }
  .om-stats { background: transparent; gap: clamp(10px, 1.2vw, 20px); }
  .om-stat { display: flex; flex-direction: column; gap: 6px; padding: clamp(12px, 2vh, 22px) clamp(14px, 1.4vw, 22px); border-top: 4px solid var(--text); background: var(--off-white); }
  .om-stat--key { border-top-color: var(--red); }
  .om-stat__big { font-family: var(--fd); font-size: clamp(2.2rem, 4.2vw, 4.4rem); font-weight: 800; line-height: .95; color: var(--text); white-space: nowrap; }
  .om-stat--key .om-stat__big { color: var(--red); }
  .om-stat__label { font-family: var(--fd); font-size: clamp(13px, 1.25vw, 19px); font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-light); }
  #s6 .om-flow__step { padding-top: clamp(12px, 2.4vh, 28px); padding-bottom: clamp(12px, 2.4vh, 28px); }
  #s6 .om-wrap { gap: clamp(14px, 2.6vh, 30px); }
  .om-flow__step--blocked { background: transparent; border: 2px dashed var(--grey-mid); color: var(--grey-mid); }
  .om-flow__sub { font-size: .72em; font-weight: 600; letter-spacing: .06em; opacity: .85; }
  .om-flow__arrow { display: flex; align-items: center; font-family: var(--fd); font-size: clamp(20px, 2vw, 30px); color: var(--grey-mid); }
  .om-flow__mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.7em; height: 1.7em; border-radius: 50%;
    background: var(--red); color: #fff;
    font-size: 15px; font-weight: 800;
  }

  /* ── S6 inversion ── */
  .om-invert { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 32px); }
  .om-invert__panel {
    background: var(--off-white);
    padding: clamp(18px, 3vh, 36px) clamp(18px, 2vw, 32px);
    display: flex; flex-direction: column; gap: clamp(14px, 2.4vh, 26px);
  }
  .om-invert__panel--model { background: var(--text); }
  .om-invert__tag {
    font-family: var(--fd); font-size: clamp(12px, 1vw, 15px);
    font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--grey-mid);
  }
  .om-invert__panel--model .om-invert__tag { color: #C0282A; }
  .om-invert__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; flex: 1; align-items: end; }
  .om-box {
    background: #fff; border: 2px solid var(--grey-mid);
    font-family: var(--fd); font-size: clamp(16px, 1.7vw, 26px); font-weight: 800;

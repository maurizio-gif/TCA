  /* ══════════ PRINT (one slide per page) ══════════ */
  @media print {
    @page { size: A4 landscape; margin: 0; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .g-header, .g-menu, .slide-dots, .om-actions { display: none !important; }
    .slide { min-height: 100vh; break-after: page; }
    .om-wrap { padding-top: 5vh; }
  }
</style>

<script>
  const slides        = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dotsContainer = document.getElementById('dots')!;
  const header        = document.getElementById('g-header');

  // dark section → light header, light section → dark header (contrast)
  const sectionIsLight = (s: HTMLElement) => s.dataset.header === 'light';

  // Slide number, bottom left: "06 / 19".
  const pad = (n: number) => String(n).padStart(2, '0');
  slides.forEach((s, i) => {
    const n = document.createElement('span');
    n.className = 'om-num' + (sectionIsLight(s) ? ' om-num--light' : '');
    n.textContent = `${pad(i + 1)} / ${pad(slides.length)}`;
    s.appendChild(n);
  });

  slides.forEach((s, i) => {
    const d = document.createElement('div');
    d.className = 'dot' + (sectionIsLight(s) ? ' dot-on-light' : '') + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => s.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    dotsContainer.appendChild(d);
  });

  if (slides[0]) header?.classList.toggle('g-header--dark', sectionIsLight(slides[0]));

  let current = 0;
  const allDots = () => Array.from(document.querySelectorAll('.dot'));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && e.intersectionRatio >= 0.5) {
        current = slides.indexOf(e.target as HTMLElement);
        allDots().forEach((d, i) => d.classList.toggle('active', i === current));
        header?.classList.toggle('g-header--dark', sectionIsLight(e.target as HTMLElement));
      }
    });
  }, { threshold: 0.5 });
  slides.forEach(s => observer.observe(s));

  // Presenting from a laptop: arrows, page keys and space move one slide.
  document.addEventListener('keydown', e => {
    if (document.body.classList.contains('menu-open')) return;
    const next = ['ArrowDown', 'ArrowRight', 'PageDown', ' '].includes(e.key);
    const prev = ['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key);
    if (!next && !prev) return;
    e.preventDefault();
    const target = Math.min(slides.length - 1, Math.max(0, current + (next ? 1 : -1)));
    slides[target].scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

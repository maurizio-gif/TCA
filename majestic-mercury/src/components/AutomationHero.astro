---
interface Props {
  videoSrc?: string;
  heading?: string;
  subtext?: string;
}

const {
  videoSrc = 'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260514_135830_bb6491d1-9b66-4aec-9722-13b4dfe3fb46.mp4',
  heading = 'WE BUILD END-TO-END AI AUTOMATION SYSTEMS.',
  subtext = 'We provide all-in-one AI automation services in one place.',
} = Astro.props;

const words = heading.split(' ');
const wordDelay = (i: number) => (0.15 + i * 0.08).toFixed(2);
const subtextDelay = 0.9;
---

<video class="ai-hero__video" src={videoSrc} autoplay muted loop playsinline></video>

<section class="ai-hero">
  <div class="ai-hero__content">
    <h2 class="ai-hero__heading">
      {words.map((word, i) => (
        <span class="ai-hero__word" style={`transition-delay: ${wordDelay(i)}s`}>{word}</span>
      ))}
    </h2>
    <p class="ai-hero__subtext" style={`transition-delay: ${subtextDelay}s`}>{subtext}</p>
  </div>
</section>

<style>
  @import url('https://db.onlinewebfonts.com/c/e66905e07608167a84e6ad52f638c3c6?family=Helvetica+Now+Var');

  .ai-hero,
  .ai-hero * {
    font-family: 'Helvetica Now Var', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .ai-hero__video {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    object-fit: cover;
    z-index: 0;
  }

  .ai-hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100vh;
    padding: 70px 32px 32px 32px;
  }

  .ai-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 720px;
  }

  .ai-hero__heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em;
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    margin: 0;
  }

  .ai-hero__word {
    display: inline-block;
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ai-hero__content.is-in-view .ai-hero__word {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-hero__subtext {
    margin-top: 24px;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    max-width: 260px;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ai-hero__content.is-in-view .ai-hero__subtext {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .ai-hero {
      padding: 90px 18px 32px 18px;
    }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in-view');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll('.ai-hero__content').forEach((el) => io.observe(el));
</script>

---
interface Option  { label: string; text: string; }
interface Block   {
  heading?: string;
  text?:    string;
  bullets?: string[];
  options?: Option[];
  highlight?: { from: string; to: string };
}
interface Row {
  scope:       string;
  scopeNote?:  string;
  owner:       string;
  ownerNote?:  string;
  people:      string;
  peopleNote?: string;
  status:      'todo' | 'wip' | 'prep';
  statusLabel: string;
  nextStep:    string;
  date:        string;
  detail:      Block[];
}

const rows: Row[] = [
  {
    scope:       'Perfect Gym',
    owner:       'Maurizio Taruggi',
    people:      'Peter Croft',
    status:      'todo',
    statusLabel: 'To call',
    nextStep:    'Call Peter Croft',
    date:        'Jun 15–19',
    detail: [
      {
        heading: 'Urgency',
        text: 'Administrative separation of contracts from Aspria Holdings. Goal: direct invoicing to Tennis Club Ambrosiano with full service continuity guaranteed throughout the transition.',
      },
      {
        heading: 'Support & Continuity',
        text: 'Beyond the administrative and contractual side, functional continuity must be guaranteed: ongoing support and continuous implementation. The ordinary support activity previously provided by the Aspria Holdings IT department can be absorbed by Maurizio Taruggi and Ready2 Digital.',
      },
      {
        heading: 'Next Phase',
        text: 'A re-engineering of Perfect Gym processes will be evaluated in the following phase. In the current phase, the priority is securing ordinary day-to-day support.',
      },
      {
        heading: 'Cost Optimisation',
        text: 'The current contract includes features that are not being used. Target: 40% reduction of the monthly fee.',
        highlight: { from: '€1,500/mo', to: '~€900/mo' },
      },
    ],
  },
  {
    scope:       'Website',
    owner:       'Maurizio Taruggi',
    people:      'Laura Giardini & Thomas Sander',
    status:      'todo',
    statusLabel: 'To call',
    nextStep:    'Call Laura Giardini',
    date:        'Jun 15–19',
    detail: [
      {
        heading: 'Current State',
        text: 'The site runs on Prismic (CMS + marketing). Feedback from Laura Giardini and Alice on the platform has been negative. If the goal is to internalise digital functions, rebuilding the site from scratch should be seriously considered.',
      },
      {
        heading: 'Open Strategic Decision',
        options: [
          { label: 'Option A', text: 'Keep Prismic, replace forms only' },
          { label: 'Option B', text: 'Rebuild the entire site on a new platform' },
        ],
      },
    ],
  },
  {
    scope:       'HubSpot & JotForm',
    owner:       'Maurizio Taruggi',
    people:      '—',
    peopleNote:  'No external contact required',
    status:      'prep',
    statusLabel: 'Independent',
    nextStep:    'Analyze forms & automations',
    date:        'Jun 22–26',
    detail: [
      {
        heading: 'Approach',
        text: 'All existing forms will be fully replaced with custom HTML/CSS forms connected via N8N to Perfect Gym. This is not a 1:1 replacement — it is a complete rebuild with a restructured form logic.',
      },
      {
        heading: 'Strategic Improvements',
        bullets: [
          'Deeper user profiling compared to current setup',
          'Renewed deduplication and lead-nurturing logic',
          'New automation architecture via N8N → Perfect Gym',
        ],
      },
      {
        heading: 'Scope',
        text: 'Static site lead generation (SEO / acquisition) + event registration forms.',
      },
    ],
  },
  {
    scope:       'Microsoft',
    scopeNote:   'Outlook & OneDrive',
    owner:       'Maurizio Taruggi',
    people:      'Emanuele (Partner) & Thomas Sander',
    status:      'wip',
    statusLabel: 'In preparation',
    nextStep:    'Call Thomas Sander',
    date:        'Jun 22–26',
    detail: [
      {
        heading: 'Two Objectives',
        bullets: [
          'Email migration (Outlook)',
          'File migration (OneDrive → new drive)',
        ],
      },
      {
        heading: 'Alternative Migration Paths',
        options: [
          { label: 'Fast track', text: 'Thomas shares admin credentials → centralised migration, reduced time and cost' },
          { label: 'Manual track', text: 'Account-by-account access, local save of emails and files, then upload to the new drive — longer and more costly' },
        ],
      },
      {
        text: 'Final timeline and costs depend on Thomas Sander\'s response regarding admin access.',
      },
      {
        heading: 'Migration Roadmap — Microsoft 365 (Aspria) → Google Workspace',
        text: 'Migration of approximately 10 user accounts from the Microsoft 365 tenant managed by Aspria Holdings to a new, fully independent Google Workspace environment. Scope: email, calendars, contacts, OneDrive files, aliases and shared mailboxes/groups where applicable. The consultant is not an administrator of the source tenant, so the plan is structured to keep Aspria IT involvement to an absolute minimum.',
      },
      {
        heading: 'Phase 1 · Initial Assessment & Scope Definition',
        options: [
          { label: 'Objective',    text: 'Freeze the exact migration perimeter: accounts, data types and volumes.' },
          { label: 'Activities',   text: 'Inventory of the ~10 mailboxes, aliases, shared mailboxes/groups and OneDrive volumes; identify the domain(s) in use; define success criteria and target timeline.' },
          { label: 'Aspria input', text: 'Written confirmation of the user list, aliases, groups and domain ownership — no call required.' },
          { label: 'Output',       text: 'Signed-off scope document and user/data inventory matrix.' },
          { label: 'Risks',        text: 'Hidden aliases or shared mailboxes discovered late in the project; incomplete volume estimates.' },
        ],
      },
      {
        heading: 'Phase 2 · Google Workspace Setup',
        options: [
          { label: 'Objective',    text: 'Stand up the new independent tenant, production-ready before any data moves.' },
          { label: 'Activities',   text: 'Create the Google Workspace tenant, select edition and licensing, verify the domain, configure the security baseline (2FA, admin roles) and prepare the shared Drive structure.' },
          { label: 'Aspria input', text: 'None — fully independent. At most one DNS TXT record for domain verification if Aspria controls the DNS zone.' },
          { label: 'Output',       text: 'Verified, configured Google Workspace tenant ready to receive data.' },
          { label: 'Risks',        text: 'Control of the DNS zone must be clarified early — it determines who executes verification and the final cutover.' },
        ],
      },
      {
        heading: 'Phase 3 · User, Alias & Group Mapping',
        options: [
          { label: 'Objective',    text: 'Map every source object to its Google Workspace counterpart.' },
          { label: 'Activities',   text: 'Build the M365 → Workspace mapping table; convert aliases; map shared mailboxes to Google Groups (collaborative inbox) or delegated accounts; define onboarding credentials.' },
          { label: 'Aspria input', text: 'Asynchronous validation of the mapping table (email approval is sufficient).' },
          { label: 'Output',       text: 'Final mapping table that drives all migration tooling.' },
          { label: 'Risks',        text: 'A missed alias means misrouted or bounced mail after cutover — the mapping is the single source of truth.' },
        ],
      },
      {
        heading: 'Phase 4 · Technical Coordination with Aspria IT',
        options: [
          { label: 'Objective',    text: 'Secure minimal, time-boxed migration access to the source tenant.' },
          { label: 'Activities',   text: 'One short technical call with Aspria IT (Thomas Sander) to request temporary, scoped admin or app-level (OAuth) access for the migration tool, and to agree the cutover window; validate access with a connectivity test.' },
          { label: 'Aspria input', text: 'Temporary scoped credentials or app consent on the source tenant; agreement on the cutover date.' },
          { label: 'Output',       text: 'Working, tested migration access to the M365 tenant.' },
          { label: 'Risks',        text: 'This is the critical dependency of the whole project: if access is refused, the fallback is the per-account manual track, with higher time and cost.' },
        ],
      },
      {
        heading: 'Phase 5 · Migration Pilot',
        options: [
          { label: 'Objective',    text: 'Validate the end-to-end process on 1–2 accounts before committing the full batch.' },
          { label: 'Activities',   text: 'Migrate pilot mailboxes (mail, calendar, contacts) and OneDrive content; verify data integrity, folder structure and permissions; measure real per-account throughput; collect pilot-user feedback.' },
          { label: 'Aspria input', text: 'None — uses the access already granted in Phase 4.' },
          { label: 'Output',       text: 'Validated migration runbook with realistic per-account timings.' },
          { label: 'Risks',        text: 'Source-tenant throttling or item-type incompatibilities (recurring events, mail rules) surfacing only at scale.' },
        ],
      },
      {
        heading: 'Phase 6 · Full Migration',
        options: [
          { label: 'Objective',    text: 'Migrate all remaining accounts’ historical data with zero user disruption.' },
          { label: 'Activities',   text: 'Batch migration of all mailboxes, calendars, contacts and OneDrive files while mail continues to flow to Microsoft 365; monitor logs and re-run failed items.' },
          { label: 'Aspria input', text: 'None — runs entirely in the background.' },
          { label: 'Output',       text: 'The vast majority of historical data already in Workspace ahead of cutover.' },
          { label: 'Risks',        text: 'Large mailboxes or OneDrive archives extending the migration window; API throttling on the source side.' },
        ],
      },
      {
        heading: 'Phase 7 · Delta Migration & DNS Cutover',
        options: [
          { label: 'Objective',    text: 'Switch mail flow to Google Workspace and close the residual data gap.' },
          { label: 'Activities',   text: 'Update MX, SPF, DKIM and DMARC records; run the final delta pass for items received during the migration; activate aliases and groups; verify inbound and outbound mail flow.' },
          { label: 'Aspria input', text: 'Execute or approve the DNS / mail-routing changes if the zone is under Aspria’s control.' },
          { label: 'Output',       text: 'All mail delivered to Google Workspace; data gap reduced to zero.' },
          { label: 'Risks',        text: 'DNS propagation delays — cutover is scheduled in a low-traffic window (evening or weekend).' },
        ],
      },
      {
        heading: 'Phase 8 · Post-Migration Support & Final Validation',
        options: [
          { label: 'Objective',    text: 'Confirm completeness and hand over a stable, independent environment.' },
          { label: 'Activities',   text: 'Per-user validation checklist (mail, calendar, contacts, files); reconfigure mobile and desktop devices; short Gmail/Drive onboarding; revoke temporary access; agree the M365 decommission date with Aspria; final closure report.' },
          { label: 'Aspria input', text: 'Confirm revocation of temporary access and decommission the M365 licenses.' },
          { label: 'Output',       text: 'Signed-off migration closure report and a fully independent Google Workspace environment.' },
          { label: 'Risks',        text: 'Late discovery of missing items — source data should stay readable for an agreed retention window before decommission.' },
        ],
      },
      {
        heading: 'Minimising Aspria IT Involvement',
        text: 'The plan deliberately concentrates everything that can be done independently — tenant setup, mapping, tooling, pilot, migration runs, validation and user support — on the consultant’s side. Aspria IT is limited to four touchpoints:',
        bullets: [
          'Confirming the list of users and data to migrate (written, asynchronous)',
          'Providing or approving temporary, scoped and revocable migration access',
          'Participating in one short technical call (~30 minutes) to agree access and the cutover window',
          'Supporting the final DNS / mail-routing cutover, only if the DNS zone is under their control',
        ],
      },
    ],
  },
  {
    scope:       'Physical Devices',
    scopeNote:   'PCs & Wi-Fi',
    owner:       'TBD',
    ownerNote:   'External on-site partner',
    people:      'Thomas Sander',
    status:      'todo',
    statusLabel: 'To call',
    nextStep:    'Call Thomas Sander',
    date:        'Jun 22–26',
    detail: [
      {
        heading: 'Blocking Prerequisite',
        text: 'Devices must be unlocked by removing the central admin role held by Aspria Holdings. This can only be done after the call with Thomas Sander, who will provide the procedure.',
      },
      {
        heading: 'Operational Plan',
        bullets: [
          'Full factory reset of all devices (consecutive to the Microsoft migration)',
          'Storage target: migration to Google Drive',
          'Identify a local on-site IT manager for physical operations',
        ],
      },
      {
        heading: 'Out of Scope',
        text: 'Internal data management must be assigned to an external IT partner — not included in the current project perimeter.',
      },
    ],
  },
];
---

<div class="table-wrap">
  <table class="sco-table">
    <thead>
      <tr>
        <th>Scope</th>
        <th>Owner</th>
        <th>Other People Involved</th>
        <th>Status</th>
        <th>Next Step</th>
        <th>Date</th>
        <th class="th-expand"></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row, i) => (
        <>
          <tr class="row-main" data-idx={String(i)} aria-expanded="false" tabindex="0" role="button">
            <td data-label="Scope">
              <strong>{row.scope}</strong>
              {row.scopeNote && <span class="note">{row.scopeNote}</span>}
            </td>
            <td data-label="Owner">
              {row.owner}
              {row.ownerNote && <span class="note">{row.ownerNote}</span>}
            </td>
            <td data-label="Other People">
              {row.peopleNote
                ? <span class="note">{row.peopleNote}</span>
                : row.people}
            </td>
            <td data-label="Status">
              <span class={`badge badge--${row.status}`}>{row.statusLabel}</span>
            </td>
            <td data-label="Next Step">{row.nextStep}</td>
            <td data-label="Date">{row.date}</td>
            <td class="td-expand" data-label="">
              <span class="expand-cta" aria-hidden="true"></span>
              <span class="expand-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path class="arm-h" d="M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path class="arm-v" d="M6 2v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
            </td>
          </tr>

          <tr class="row-detail" id={`detail-${i}`} hidden>
            <td colspan="7">
              <div class="detail-panel">
                {row.detail.map((block) => (
                  <div class="detail-block">
                    {block.heading && <div class="detail-heading">{block.heading}</div>}
                    {block.text    && <p class="detail-text">{block.text}</p>}
                    {block.highlight && (
                      <div class="detail-highlight">
                        <span class="hl-from">{block.highlight.from}</span>
                        <span class="hl-arrow">→</span>
                        <span class="hl-to">{block.highlight.to}</span>
                      </div>
                    )}
                    {block.bullets && (
                      <ul class="detail-bullets">
                        {block.bullets.map(b => <li>{b}</li>)}
                      </ul>
                    )}
                    {block.options && (
                      <div class="detail-options">
                        {block.options.map(o => (
                          <div class="detail-option">
                            <span class="option-label">{o.label}</span>
                            <span class="option-text">{o.text}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </td>
          </tr>
        </>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap { overflow-x: auto; }

  .sco-table {
    width: 100%;
    border-collapse: collapse;
  }
  .sco-table thead tr { background: var(--red); }
  .sco-table th {
    font-family: var(--fd);
    font-size: clamp(10px, 0.75vw, 12px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #fff;
    padding: 14px 20px;
    text-align: left;
    white-space: nowrap;
  }
  .th-expand { width: 96px; padding: 0; }

  /* ── main rows ── */
  .row-main {
    border-bottom: 1px solid var(--grey-light);
    cursor: pointer;
    transition: background 0.15s;
  }
  .row-main:hover { background: #f7f7f7; }
  .row-main[aria-expanded="true"] { background: #f3f0ec; }
  .row-main:focus-visible { outline: 2px solid var(--red); outline-offset: -2px; }

  .sco-table td {
    font-size: clamp(12px, 0.9vw, 14px);
    font-weight: 300;
    color: #444;
    padding: 16px 20px;
    vertical-align: middle;
    line-height: 1.55;
  }
  .sco-table td:first-child strong {
    font-family: var(--fd);
    font-size: clamp(13px, 1vw, 15px);
    font-weight: 700;
    color: var(--text);
    display: block;
  }
  .td-expand {
    padding: 0 16px 0 0;
    width: 96px;
    text-align: right;
    white-space: nowrap;
    color: var(--grey-mid);
    transition: color 0.15s;
    vertical-align: middle;
  }
  .row-main:hover .td-expand { color: var(--red); }

  .expand-cta {
    font-family: var(--fd);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: middle;
    margin-right: 7px;
  }
  .expand-cta::after { content: 'Expand'; }
  .row-main[aria-expanded="true"] .expand-cta::after { content: 'Close'; }

  .expand-icon { display: inline-flex; vertical-align: middle; }
  .expand-icon svg { display: block; transition: transform 0.25s ease; }
  .row-main[aria-expanded="true"] .arm-v {
    transform: scaleY(0);
    transform-origin: center;
  }
  .arm-v { transition: transform 0.22s ease; }

  .note {
    display: block;
    font-size: clamp(10px, 0.75vw, 12px);
    color: var(--grey-mid);
    margin-top: 3px;
    font-style: italic;
    line-height: 1.5;
    font-weight: 300;
  }

  .badge {
    display: inline-block;
    font-size: clamp(9px, 0.65vw, 11px);
    font-weight: 600;
    font-family: var(--fd);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .badge--todo { background: rgba(139,26,26,0.08); color: var(--red);  border: 1px solid rgba(139,26,26,0.25); }
  .badge--wip  { background: rgba(180,120,0,0.08); color: #8B6000;     border: 1px solid rgba(180,120,0,0.25); }
  .badge--prep { background: rgba(0,80,180,0.07);  color: #004FAF;     border: 1px solid rgba(0,80,180,0.2); }

  /* ── detail rows ── */
  .row-detail td {
    padding: 0;
    border-bottom: 1px solid var(--grey-light);
    background: #faf9f7;
  }
  .detail-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    padding: 24px 28px 28px;
    border-left: 3px solid var(--red);
  }
  .detail-block {
    flex: 1 1 260px;
    padding: 0 24px 16px 0;
    min-width: 220px;
  }
  .detail-heading {
    font-family: var(--fd);
    font-size: clamp(9px, 0.7vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 8px;
  }
  .detail-text {
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.7;
    margin: 0;
  }
  .detail-highlight {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    padding: 8px 14px;
    background: rgba(139,26,26,0.06);
    border-radius: 4px;
  }
  .hl-from { font-size: 13px; font-weight: 400; color: var(--text-light); text-decoration: line-through; }
  .hl-arrow { color: var(--red); font-weight: 700; }
  .hl-to { font-family: var(--fd); font-size: 15px; font-weight: 700; color: var(--red); }

  .detail-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .detail-bullets li {
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
    padding-left: 16px;
    position: relative;
  }
  .detail-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--red);
    font-weight: 700;
  }

  .detail-options { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .detail-option {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .option-label {
    font-family: var(--fd);
    font-size: clamp(9px, 0.65vw, 10px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    background: var(--text);
    padding: 2px 7px;
    border-radius: 2px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .option-text {
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 300;
    color: var(--text-light);
    line-height: 1.6;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .table-wrap { overflow: visible; }
    .sco-table thead { display: none; }
    .sco-table,
    .sco-table tbody { display: block; }
    .sco-table tr.row-main,
    .sco-table tr.row-detail { display: block; }
    .sco-table tr.row-detail[hidden] { display: none; }

    .row-main {
      border: 1px solid var(--grey-light);
      border-radius: 6px 6px 0 0;
      margin-top: 16px;
      overflow: hidden;
    }
    .row-main[aria-expanded="false"] { border-radius: 6px; }

    .sco-table td { display: block; width: 100%; padding: 12px 14px; font-size: 16px; border-bottom: 1px solid var(--grey-light); }
    .sco-table td:last-child { border-bottom: none; }

    .sco-table td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--fd);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--grey-mid);
      margin-bottom: 3px;
    }
    .sco-table .td-expand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 12px 14px;
      color: var(--red);
    }
    .td-expand::before { display: none; }
    .expand-cta { font-size: 12px; margin-right: 0; }

    .row-main td:first-child {
      background: var(--red);
      color: #fff;
      padding: 12px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .row-main td:first-child::before { display: none; }
    .row-main td:first-child strong { color: #fff; font-size: 19px; }
    .row-main td:first-child :global(.note) { color: rgba(255,255,255,0.65); font-size: 13px; }

    .row-detail td { display: block; padding: 0; }
    .row-detail td::before { display: none; }
    .detail-panel {
      flex-direction: column;
      padding: 18px 16px 20px;
      border-left-width: 3px;
    }
    .detail-block { flex: none; padding: 0 0 16px; }
    .detail-heading { font-size: 13px; }
    .detail-text, .detail-bullets li, .option-text { font-size: 15px; }
    .option-label { font-size: 11px; }

    .badge { font-size: 13px; }
    .note  { font-size: 14px; }

    .row-main[aria-expanded="true"] {
      border-radius: 6px 6px 0 0;
      border-bottom: none;
    }
    .row-detail { border: 1px solid var(--grey-light); border-top: none; border-radius: 0 0 6px 6px; margin-bottom: 0; overflow: hidden; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.row-main').forEach(row => {
    const toggle = () => {
      const idx    = row.dataset.idx!;
      const detail = document.getElementById(`detail-${idx}`) as HTMLTableRowElement;
      const open   = row.getAttribute('aria-expanded') === 'true';
      row.setAttribute('aria-expanded', open ? 'false' : 'true');
      detail.hidden = open;
    };
    row.addEventListener('click', toggle);
    row.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
  });
</script>
